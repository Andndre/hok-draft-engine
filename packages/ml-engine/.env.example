# Cloudflare R2 Object Storage Credentials
# S3-Compatible API endpoint for your Cloudflare account
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=hok-draft-engine
R2_PUBLIC_URL=https://cdn.yourdomain.com

# Optional maintainer-only Jev classification. Never use a VITE_ variable for this key.
TYPESAFE_API_KEY=
# Neural experiments are published only to a separate explicit bucket.
EXPERIMENTAL_MODEL_BUCKET=
