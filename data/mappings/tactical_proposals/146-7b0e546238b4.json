    {
      "source": "Kurohiko",
      "url": "https://hok.kurohiko.id/",
      "field": "tactical_tips",
      "content": "1) Sebelum level 4 Luna hampir gak ada power. Gank dia di awal buat nahan farm-nya. 2) Simpen control sampai Luna masuk, baru bunuh."
    },
    {
      "source": "HoKStats",
      "url": "https://hokstats.gg/heroes/luna/",
      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Moonlight Dance",
            "description": "Basic Attacks have two forms, melee and ranged. First Basic Attack in melee form will charge toward the target, and third Basic Attack deals extra damage. Enhanced Basic Attacks and skill damage mark enemies. Magical Attack boost will enhance her Attack Speed.",
            "type": "passive"
          },
          {
            "name": "Crescent Slice",
            "description": "Unleashes a shockwave in the target direction, dealing damage and marking enemies hit.",
            "type": "skill1"
          },
          {
            "name": "Searing Stab",
            "description": "Gains a shield and pulls nearby enemies, dealing damage while stunning, slowing, and marking them.",
            "type": "skill2"
          },
          {
            "name": "New Moon",
            "description": "Dashes to the target location, dealing damage to enemies in her path. If she hits a marked enemy, this skill's cooldown is reset.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "The map shape favors gank routes, where mobility translates directly into kills",
          "Your team can engage first, letting Luna second-wave into low-health targets",
          "The enemy draft includes Yuhuan, Lady Zhen, and Heino, who appear in counter data as matchups Luna can pressure."
        ],
        "avoid_when": [
          "Enemy peel is strong and Luna cannot reach the backline without dying first",
          "Your team has no primary engage, leaving the cleanup pick with nothing to follow up on",
          "The enemy already drafted Athena, Augran, and Fuzi, who counter data identifies as direct answers to Luna."
        ],
        "power_spikes": [
          "Early game: jungle clear into level-4 ganks is the first window where Luna can translate routes into kills.",
          "Ultimate unlocked: New Moon converts mobility into burst, the moment Luna starts threatening picks across the map",
          "Late game: cooldowns become short enough that Searing Stab influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Engaging without follow-up — gap-close gets you to the target, but a solo dive without ally damage trades 1-for-1.",
          "Engaging first instead of second — cleanup picks lose their value as primary engagers.",
          "Ignoring Athena and Augran on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Pathing predictably and getting tracked by the enemy jungler — vary first clear and rotate based on ward placement rather than muscle memory."
        ],
