  "sources": [
    {
      "source": "HOKFIRE",
      "url": "https://www.hokfire.com/",
      "field": "abilities",
      "content": [
        {
          "type": "Passive",
          "name": "Moonlight Dance",
          "desc": "Every three Basic Attacks form a repeating cycle. On the first, she dashes toward the target, and on the third, she deals damage to nearby enemies and places a mark on them. Increasing Magical Attack also increases Attack Speed"
        },
        {
          "type": "Skill 1",
          "name": "Crescent Slice",
          "desc": "Unleashes a shockwave in the target direction, dealing damage and marking enemies hit."
        },
        {
          "type": "Skill 2",
          "name": "Searing Stab",
          "desc": "Gains a shield and pulls nearby enemies, dealing damage while stunning slowing, and marking them."
        },
        {
          "type": "Ultimate",
          "name": "New Moon",
          "desc": "Dashes in the target direction, dealing damage to enemies in her path. Upon hitting marked enemies, her Ultimate's cooldown will be refreshed."
        }
      ]
    },
    {
