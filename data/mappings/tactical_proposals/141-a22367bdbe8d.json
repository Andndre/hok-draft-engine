    {
      "source": "HoKStats",
      "url": "https://hokstats.gg/heroes/diaochan/",
      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Explosion of Fragrance",
            "description": "Applies stacks to the opponent. At max stacks, deals area damage and slows enemies, while recovering Health.",
            "type": "passive"
          },
          {
            "name": "Returning Lotus",
            "description": "Sends out a lotus in the target direction that returns to her when it reaches its max distance, damaging enemies in its path.",
            "type": "skill1"
          },
          {
            "name": "Petals in the Wind",
            "description": "Dashes in the target direction, becoming untargetable during the dash. Releases petals to attack nearby enemies, dealing damage and reducing the cooldown of Skill 2.",
            "type": "skill2"
          },
          {
            "name": "Flowery Potential",
            "description": "Conjures up a magic circle around her, which lasts for a period of time. While she is within the circle, the cooldowns of Skill 1 and Skill 2 are sped up. The circle deals damage to enemies within it when it is conjured and when it expires.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "The team draft favors extended team fights where healing scales",
          "Your team has the structure to use her ability to farm safely and rotate to side lanes when the wave allows, since Diaochan delivers consistent damage output and timely roams.",
          "The enemy draft includes Luna and Zhang Fei, who appear in counter data as matchups Diaochan can pressure."
        ],
        "avoid_when": [
          "The enemy already builds anti-heal items, neutralizing your sustain plan",
          "Your team needs a jungle pick more than Diaochan's specialty, leaving the role unfilled if you commit here.",
          "The enemy already drafted Liang and Mulan, who counter data identifies as direct answers to Diaochan."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Diaochan's mid-game tools come online.",
          "Lifesteal item online: trade patterns flip from neutral to favorable once sustain stacks with damage",
          "Late game: full build online, Diaochan reaches the spike public guides describe — extended fights favor her once items are completed."
        ],
        "common_mistakes": [
          "Forcing all-ins against opponents already wearing anti-heal — your healing barely activates.",
          "Ignoring Liang and Mulan on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Greeding farm in mid lane while side lanes get camped — rotation timing matters more than CS lead in most matchups."
        ],
