  "sources": [
    {
      "source": "HOKFIRE",
      "url": "https://www.hokfire.com/",
      "field": "abilities",
      "content": [
        {
          "skill_id": 58500,
          "type": "Passive",
          "name": "Flow of the World",
          "desc": "Can use Flow at the Base to enhance stats.\nSpends Flow to perform an enhanced Basic Attack that deals <color=#db70d0>damage</color>, then ricochets to deal <color=#db70d0>damage</color> or restore <color=#6fc075>Health</color>.",
          "cd": 1000,
          "cost": 0,
          "tags": [
            "Switch",
            "Damage",
            "Recovery"
          ],
          "icon": "https://camp.honorofkings.com/Global/Common/UGUI/SystemRes/902_HeroSkillIcon/58100.png"
        },
        {
          "skill_id": 58510,
          "type": "Skill 1",
          "name": "Convergence",
          "desc": "Channels the Flow, dealing <color=#db70d0>damage</color> to nearby enemies and <color=#50c1eb>knocking them back</color>. Also <color=#6fc075>recovers Health</color>, gains 5 stacks of Flow, and reduces the cooldown of other skills.\n<color=#4f6f95>Nearby teammates and minions increase Health recovery and Flow stacks.</color>",
          "cd": 12500,
          "cost": 50,
          "tags": [
            "Enhance",
            "Recovery",
            "Knock Back"
          ],
          "icon": "https://camp.honorofkings.com/Global/Common/UGUI/SystemRes/902_HeroSkillIcon/58110.png"
        },
        {
          "skill_id": 58530,
          "type": "Skill 2",
          "name": "Protection Melody",
          "desc": "Raises a platform, <color=#50c1eb>knocking back</color> nearby enemies. Teammates on the platform gain increased <color=#6fc075>vision, attack, and skill range</color> and a <color=#6fc075>shared shield</color>.\nUsing the skill again while on the platform refreshes its duration and expands it, while further boosting the <color=#6fc075>attack and skill range</color> and <color=#6fc075>shield</color> effects. Dashes when leaving the platform.\n<color=#4f6f95>Can spend 4 stacks of Flow to gain an extra Protection Melody use as well as increased attack and skill range while on the platform.</color>",
          "cd": 7500,
          "cost": 35,
          "tags": [
            "Casting Platform",
            "Shield",
            "Enhance"
          ],
          "icon": "https://camp.honorofkings.com/Global/Common/UGUI/SystemRes/902_HeroSkillIcon/58520.png"
        },
        {
          "skill_id": 58520,
          "type": "Skill 3",
          "name": "Lingering Melody",
          "desc": "Gains <color=#6fc075>Movement Speed</color> and unleashes sound waves in the target direction that <color=#6fc075>restore their Health</color> when they hit. Hitting an enemy deals <color=#db70d0>damage</color>, hitting an ally restores <color=#6fc075>Health</color>, and hitting a wall causes the attack to ricochet and create a new sound wave.\n<color=#4f6f95>Can spend 5 stacks of Flow to use this skill again.</color>",
          "cd": 25000,
          "cost": 65,
          "tags": [
            "Damage",
            "Heal",
            "Slow"
          ],
          "icon": "https://camp.honorofkings.com/Global/Common/UGUI/SystemRes/902_HeroSkillIcon/58530.png"
        }
      ]
    },
