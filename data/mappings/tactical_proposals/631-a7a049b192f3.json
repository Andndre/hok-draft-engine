      "content": {
        "skills": [
          {
            "name": "Shuffle",
            "description": "After leaving combat or touching a bouquet, enhances the next Basic Attack to include a dash and deal extra damage. If the attack hits a hero, recovers Health. He can dash again after the initial dash.",
            "type": "passive"
          },
          {
            "name": "Blossom",
            "description": "Tosses a bouquet, damaging and stunning the first enemy hit, then scatters more bouquets. Touching a bouquet enhances his Basic Attack and refreshes the cooldown of Triple Threat.",
            "type": "active"
          },
          {
            "name": "Triple Threat",
            "description": "Attacks the target 3 times, dealing damage. Each hit deals extra true damage and reduces the cooldown of Blossom. He can dash after each hit.",
            "type": "active"
          },
          {
            "name": "Gentlemen's Duel",
            "description": "Dashes forward and marks the first target, increasing their damage taken, then scatters bouquets. While the skill is active, recovers twice as much Health and gains crowd control immunity. He can dash again after the initial dash.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "Pick Florentino when your team needs a mobile Clash Lane duelist who can pressure isolated targets and sustain through precise combos."
        ],
        "avoid_when": [
          "Avoid Florentino when the enemy draft has layered crowd control or reliable ranged disengage that prevents him from collecting bouquets."
        ],
        "power_spikes": [
          "Florentino's main spike comes when Blossom and Triple Threat are both available, letting each bouquet refresh the combo and extend his mobility."
        ],
        "common_mistakes": [
          "Do not mash abilities without collecting bouquets; missing the bouquet path removes the enhanced Basic Attack, cooldown refresh, healing, and extra dashes that sustain the combo."
        ],
