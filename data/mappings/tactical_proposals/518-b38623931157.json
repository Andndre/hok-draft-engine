      "field": "abilities",
      "content": [
        {
          "skill_id": 51800,
          "type": "Passive",
          "name": "Shadow Raid",
          "desc": "Every time Ma Chao releases a skill, his movement speed will increase by 2%, which can be stacked up to 3 times and lasts for 5 seconds. Every time Ma Chao picks up his Cold Fire Spear, his movement speed will gradually increase by 20 to 55 points within 2 seconds (which grows with the hero's level), and the next basic attack will be strengthened. Each additional point of movement speed will increase his base damage by 1 to 2 points (which will grow with the hero's level). When hitting an enemy, it will restore 3% of its Max HP plus 30 health points and reduce the cooldown of all skills by 1 second. When releasing Ten Thousand Blades to Sheath and catching the Cold Fire Spear, the damage, life recovery and attack range will be increased by another 20%.",
          "cd": "0",
          "cost": "0",
          "tags": [
            "Speed Up",
            "Movement",
            "Recovery"
          ],
          "icon": "https://game.gtimg.cn/images/yxzj/img201606/heroimg/518/51800.png"
        },
        {
          "skill_id": 51801,
          "type": "Skill 1",
          "name": "Blade of Desolation",
          "desc": "Ma Chao throws a cold light gun in the designated direction, causing 200/240/280/320/360/400 (+60% physical bonus) points of physical damage to the enemy it touches and inserting it into the position behind the enemy. If this attack directly defeats the target, it will continue to fly for a fixed distance and cause an additional 50% damage to subsequent targets. The cold fire gun can last up to 10 seconds on the ground. When Ma Chao approaches the Lenghui Spear, he will pick up the Lenghui Spear.",
          "cd": "8/7.8/7.6/7.4/7.2/7",
          "cost": "1 javelin",
          "tags": [
            "Damage",
            "Spear Throw"
          ],
          "icon": "https://game.gtimg.cn/images/yxzj/img201606/heroimg/518/51810.png"
        },
        {
          "skill_id": 51802,
          "type": "Skill 2",
          "name": "sunset gun",
          "desc": "Ma Chao summons a cold fire gun to attack the designated location, causing 150/180/210/240/270/300 (+50% physical bonus) points of physical damage and a 30% deceleration effect to nearby enemies in a small range, lasting 2 seconds. The Cold Fire Gun can exist for at most 10 seconds after landing. When Ma Chao approaches the Lenghui Spear, he will pick up the Lenghui Spear.",
          "cd": "8/7.8/7.6/7.4/7.2/7",
          "cost": "1 javelin",
          "tags": [
            "Damage",
            "Slow",
            "Spear Summon"
          ],
          "icon": "https://game.gtimg.cn/images/yxzj/img201606/heroimg/518/51820.png"
        },
        {
          "skill_id": 51803,
          "type": "Skill 3",
          "name": "Ten Thousand Blades Sheathed",
          "desc": "Each time it is released, it summons a Lenghui gun closest to Ma Chao to fly back. The Lenghui gun causes 200/300/400 (+50% physical attack) physical damage to enemies on the flight path (1~2 points of basic damage are added for every 1 point of extra movement speed) and physical damage equal to 5% of the target's health. The entire summoning process lasts 10 seconds (can be summoned up to 4 times).",
          "cd": "50/47.5/45",
          "cost": "0",
          "tags": [
            "Spear Recall",
            "Burst",
            "Recovery"
          ],
          "icon": "https://game.gtimg.cn/images/yxzj/img201606/heroimg/518/51830.png"
        },
        {
          "skill_id": 51804,
          "type": "Skill 4",
