    {
      "source": "HoKStats",
      "url": "https://hokstats.gg/heroes/allain/",
      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Howling Blade",
            "description": "Basic Attacks and skills grant Fury, which increases his Physical Pierce and Magical Pierce and grants damage reduction. At max Fury, he recovers Health, and the lower his Health, the more he recovers.",
            "type": "passive"
          },
          {
            "name": "Meteor Kill",
            "description": "Based on how many stacks of mark he has, deals multi-phase damage in the target direction and launches enemies. He gains marks by hitting enemies with Basic Attacks and his Ultimate.",
            "type": "skill1"
          },
          {
            "name": "Moonlight Flash",
            "description": "Dashes in the target direction, damaging and slowing enemies. He gains Movement Speed and his next 3 Basic Attacks gain increased Attack Speed.",
            "type": "skill2"
          },
          {
            "name": "Death at Sunset",
            "description": "Leaps toward the targeted enemy hero and becomes untargetable. After a short delay, he lands and deals area damage. For every enemy hero hit, he gains marks and Fury. He also gains a shield based on the number of enemies hit.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "The map shape favors gank routes, where mobility translates directly into kills",
          "Your team has the structure to use his ability to soak pressure in lane and threaten side objectives, since Allain delivers a durable front-line presence with steady wave control.",
          "The enemy draft includes Lu Bu and Zhuangzi, who appear in counter data as matchups Allain can pressure."
        ],
        "avoid_when": [
          "The enemy stacks crowd control that interrupts the engage before damage goes out",
          "Your team needs a mid pick more than Allain's specialty, leaving the role unfilled if you commit here.",
          "The enemy already drafted Sima Yi and Marco Polo, who counter data identifies as direct answers to Allain."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Allain's mid-game tools come online.",
          "Mid game: with cooldown reduction online, gap-close skills come back fast enough to chain into multiple fights",
          "Late game: full build online, Allain reaches the spike public guides describe — extended fights favor him once items are completed."
        ],
        "common_mistakes": [
          "Diving while enemy hard control is still up, which directly counters Allain's engage.",
          "Ignoring Sima Yi and Marco Polo on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Forcing solo engages instead of waiting for ally commit — Allain's value compounds when the team follows up on engages."
        ],
