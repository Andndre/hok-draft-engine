    {
      "source": "Kurohiko",
      "url": "https://hok.kurohiko.id/",
      "field": "tactical_tips",
      "content": "Biron kuat banget di clash lane dengan lifesteal, shield, dan dash, di awal susah nyari lawan yang berani adu. Tapi jangkauannya pendek dan gampang di-kite, tanpa flash susah masuk ke backline, jadi biasa aja di teamfight mid-late. Dia hero early game: Guan Yu/Mi Yue/Ma Chao/Sun Ce/Lu Bu (clash) asal gak mati sebelum level 4, sisanya 50:50. Marco Polo/Arli/Lady Sun (marksman), Diaochan/Sima Yi/Liang (mage), Sun Bin (support) juga bagus ngelawan dia."
    },
    {
      "source": "HoKStats",
      "url": "https://hokstats.gg/heroes/biron/",
      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Fearless Chariot",
            "description": "Charges up when Basic Attacks and unenhanced skills hit. Charged skills gain extra effects. When charged to at least 1 bars, Basic Attacks recover Health on hit.",
            "type": "passive"
          },
          {
            "name": "Electrifying Charge",
            "description": "Swings his weapon in the target direction, dealing damage and recovering Health with every hit. While charged, deals more damage and recovers more Health.",
            "type": "skill1"
          },
          {
            "name": "Storm Strike",
            "description": "Dashes in the target direction, gaining an enhanced Basic Attack that deals damage and slows targets. While charged, the next Basic Attack deals more damage, and the slow effect is changed to a launch effect.",
            "type": "skill2"
          },
          {
            "name": "Force Field Suppression",
            "description": "Damages and slows nearby enemies while gaining a shield. When charged, deals more damage, grants a stronger shield, and generates an electric wave that damages nearby enemies while stealing Movement Speed from enemy heroes.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "The enemy team has carries with limited self-peel that Biron can reach before the team can react",
          "Your team needs a setup hero whose Storm Strike creates kill windows for the carry",
          "The enemy draft includes Dun and Wukong, who appear in counter data as matchups Biron can pressure."
        ],
        "avoid_when": [
          "The team needs sustained team-fight damage rather than a single-target diver",
          "The enemy team is loaded with cleanse, dashes, and immunity that bypass crowd control",
          "The enemy already drafted Lady Sun and Sun Bin, who counter data identifies as direct answers to Biron."
        ],
        "power_spikes": [
          "Early game: Biron is listed as an early-game threat in public guide data — convert the early window into objectives before scaling picks come online.",
          "Ultimate unlocked: Force Field Suppression converts mobility into burst, the moment Biron starts threatening picks across the map",
          "Late game: cooldowns become short enough that Storm Strike influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Engaging without follow-up — gap-close gets you to the target, but a solo dive without ally damage trades 1-for-1.",
          "Throwing Storm Strike on the front-line tank instead of saving it for backline carries.",
          "Ignoring Lady Sun and Sun Bin on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Forcing solo engages instead of waiting for ally commit — Biron's value compounds when the team follows up on engages."
        ],
