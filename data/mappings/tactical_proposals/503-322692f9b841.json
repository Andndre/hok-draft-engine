  "sources": [
    {
      "source": "HOKFIRE",
      "url": "https://www.hokfire.com/",
      "field": "abilities",
      "content": [
        {
          "type": "Passive",
          "name": "Fearless Chariot",
          "desc": "Accumulates charge when Basic Attacks or unenhanced skills land hits, for up to 3 bars of charge.While having at least 1 bar, Basic Attack hits recover Health.Using Skill 1, the Ultimate, or an enhanced Basic Attack from Skill 2 will spend 1 bar."
        },
        {
          "type": "Skill 1",
          "name": "Electrifying Charge",
          "desc": "Swings his weapon twice in the target direction, dealing damage andrecovering Health with every hit.While charged, deals more damage and recovers more Health."
        },
        {
          "type": "Skill 2",
          "name": "Storm Strike",
          "desc": "Dashes in the target direction, dealing damage to enemies in his path whilegaining an enhanced Basic Attack that deals damage and slows targetsWhile charged, the next Basic Attack deals more damage, and the sloweffect is changed to a launch effect."
        },
        {
          "type": "Ultimate",
          "name": "Force Field Suppression",
          "desc": "Gains a shield while damaging and slowing nearby enemiesWhile charged, the skill deals more damage, grants a stronger shield, andproduces a spark that deals damage to nearby enemies while stealingMovement Speed from enemy heroes."
        }
      ]
    },
