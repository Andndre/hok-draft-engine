        "pick_when": [
          "The enemy lacks reliable healing reduction, leaving sustain unchecked",
          "Your team has the structure to use her ability to farm safely and rotate to side lanes when the wave allows, since Milady delivers consistent damage output and timely roams.",
          "The enemy draft includes Nakoruru, Pei, and Mai Shiranui, who appear in counter data as matchups Milady can pressure."
        ],
        "avoid_when": [
          "The game state demands burst rather than slow attrition",
          "Your team needs a jungle pick more than Milady's specialty, leaving the role unfilled if you commit here.",
          "The enemy already drafted Allain, Fuzi, and Haya, who counter data identifies as direct answers to Milady."
        ],
        "power_spikes": [
          "Early game: Milady is listed as an early-game threat in public guide data — convert the early window into objectives before scaling picks come online.",
          "Lifesteal item online: trade patterns flip from neutral to favorable once sustain stacks with damage",
          "Late game: cooldowns become short enough that Forced Invasion influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Forcing all-ins against opponents already wearing anti-heal — your healing barely activates.",
          "Ignoring Allain and Fuzi on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Greeding farm in mid lane while side lanes get camped — rotation timing matters more than CS lead in most matchups."
        ],
