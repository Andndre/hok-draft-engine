  "sources": [
    {
      "source": "HOKFIRE",
      "url": "https://www.hokfire.com/",
      "field": "abilities",
      "content": [
        {
          "type": "Passive",
          "name": "Kiss of Death",
          "desc": "Attacks launched from the front of the target will not crit, but backstabs are guaranteed to crit."
        },
        {
          "type": "Skill 1",
          "name": "Arclight",
          "desc": "Arke attacks twice in a row, dealing physical damage."
        },
        {
          "type": "Skill 2",
          "name": "Untouchable",
          "desc": "Arke dashes forward and attacks, marking an enemy while dealing physical damage and gaining Attack Speed. Attacking marked targets slows them and reduces this skill's cooldown. She takes less damage from marked targets."
        },
        {
          "type": "Ultimate",
          "name": "Phantom Dance",
          "desc": "Enters stealth, gaining a Movement Speed boost and Health recovery. Enhances attack after exiting stealth, granting extra Movement Speed boost when dealing damage, and refreshes all skill cooldowns with defeats and assists."
        }
      ]
    },
