    {
      "source": "Kurohiko",
      "url": "https://hok.kurohiko.id/",
      "field": "tactical_tips",
      "content": "Jangan munggungin Arke, terus atur posisi. Arke roaming-nya efisien banget, jadi pas laning jangan adu sama musuh kalau lu gak tahu Arke lagi di mana."
    },
    {
      "source": "HoKStats",
      "url": "https://hokstats.gg/heroes/arke/",
      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Kiss of Death",
            "description": "Attacks launched from the front of the target will not crit, but backstabs are guaranteed to crit.",
            "type": "passive"
          },
          {
            "name": "Arclight",
            "description": "Attacks twice in a row, dealing physical damage.",
            "type": "skill1"
          },
          {
            "name": "Untouchable",
            "description": "Dashes forward and attacks, marking an enemy while dealing physical damage and gaining Attack Speed. Attacking marked targets slows them and reduces this skill's cooldown. She takes less damage from marked targets.",
            "type": "skill2"
          },
          {
            "name": "Phantom Dance",
            "description": "Enters stealth, gaining a Movement Speed boost and Health recovery. She enhances her attacks after exiting stealth, gains extra Movement Speed upon dealing damage, and refreshes all skill cooldowns with defeats and assists.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "The enemy team has carries with limited self-peel that Arke can reach before the team can react",
          "The enemy team relies on long-cooldown engage skills that leave them vulnerable post-fight",
          "The enemy draft includes Wang Zhaojun and Luban No.7, who appear in counter data as matchups Arke can pressure."
        ],
        "avoid_when": [
          "The team needs sustained team-fight damage rather than a single-target diver",
          "The enemy team disengages well, so cleanup windows never open",
          "The enemy team is built around answers to Gap-Close, removing the windows Arke's kit needs to perform."
        ],
        "power_spikes": [
          "Early game: jungle clear into level-4 ganks is the first window where Arke can translate routes into kills.",
          "Mid game: with cooldown reduction online, gap-close skills come back fast enough to chain into multiple fights",
          "Late game: full build online, Arke reaches the spike public guides describe — extended fights favor her once items are completed."
        ],
        "common_mistakes": [
          "Diving while enemy hard control is still up, which directly counters Arke's engage.",
          "Engaging first instead of second — cleanup picks lose their value as primary engagers.",
          "Engaging without checking enemy summoner-spell cooldowns, which often decide whether Arke's commit reaches the target alive.",
          "Pathing predictably and getting tracked by the enemy jungler — vary first clear and rotate based on ward placement rather than muscle memory."
        ],
