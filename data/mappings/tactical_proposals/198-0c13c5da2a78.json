      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Dream-eating",
            "description": "Gains Mass when using skills. Mass increases his Physical Attack, Physical Defense, and Magical Defense.",
            "type": "passive"
          },
          {
            "name": "Lingering Dream",
            "description": "Gains Mass and a shield while damaging enemies within range. Basic Attack hits reduce this skill's cooldown.",
            "type": "skill1"
          },
          {
            "name": "Dream Bubble",
            "description": "Throws a bubble in the target direction, then pulls it back. He does this twice. The bubble damages and slows enemies hit. The bubble can be thrown again as a bomb in the target direction, damaging enemies.",
            "type": "skill2"
          },
          {
            "name": "Dream Roam",
            "description": "Flies in a circle, dealing magical damage to enemies in his path while gaining Mass. When he stops flying, he launches and damages nearby enemies.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "The map shape favors gank routes, where mobility translates directly into kills",
          "Your team has the structure to use their ability to clear camps efficiently and convert pressure into ganks, since Menki delivers tempo from objectives and cross-map kill threats.",
          "The enemy draft includes Lady Zhen, Mai Shiranui, and Xiao Qiao, who appear in counter data as matchups Menki can pressure."
        ],
        "avoid_when": [
          "Enemy peel is strong and Menki cannot reach the backline without dying first",
          "Your team needs a tank pick more than Menki's specialty, leaving the role unfilled if you commit here.",
          "The enemy already drafted Ming, Sima Yi, and Zhuangzi, who counter data identifies as direct answers to Menki."
        ],
        "power_spikes": [
          "Early game: jungle clear into level-4 ganks is the first window where Menki can translate routes into kills.",
          "Ultimate unlocked: Dream Roam converts mobility into burst, the moment Menki starts threatening picks across the map",
          "Late game: cooldowns become short enough that Dream Bubble influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Engaging without follow-up — gap-close gets you to the target, but a solo dive without ally damage trades 1-for-1.",
          "Ignoring Ming and Sima Yi on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Pathing predictably and getting tracked by the enemy jungler — vary first clear and rotate based on ward placement rather than muscle memory."
        ],
