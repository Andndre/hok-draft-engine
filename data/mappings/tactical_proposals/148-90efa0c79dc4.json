  "sources": [
    {
      "source": "HOKFIRE",
      "url": "https://www.hokfire.com/",
      "field": "abilities",
      "content": [
        {
          "type": "Passive",
          "name": "Sanctification (Ziya)",
          "desc": "When Ziya deals damage to a target and they are defeated within 4s, he gains EXP. When reaching level, he gains Sanctify, and increases his level cap to 25. Sanctify allows him to increase a teammate's level cap, and potentially earn EXP."
        },
        {
          "type": "Skill 1",
          "name": "Divine Seal",
          "desc": "Seals enemies within range, dealing magical damage while reducing their Movement Speed, Physical and Magical Defense for 3.5s. If the skill hits an enemy, he gains a Movement Speed boost."
        },
        {
          "type": "Skill 2",
          "name": "Divine Punishment",
          "desc": "Conjures a magic circle that deals 3 strikes of damage to nearby enemies. After a short delay, the magic circle explodes, dealing extra magical damage and launching enemies for 0.8s."
        },
        {
          "type": "Ultimate",
          "name": "Universal Law",
          "desc": "Unleashes 3 shockwaves to deal magical damage. Reaching level 15 increases the Ultimate's charging speed by 10% and grants a chance to allow him to move after initiating the charge."
        }
      ]
    },
    {
