        "pick_when": [
          "The enemy team plays dive comp, giving you space to poke before they engage",
          "Your team has the structure to use his ability to farm safely and rotate to side lanes when the wave allows, since Ziya delivers consistent damage output and timely roams.",
          "The enemy draft includes Diaochan, Ying, and Zilong, who appear in counter data as matchups Ziya can pressure."
        ],
        "avoid_when": [
          "The enemy has hard engage that closes distance through poke patterns",
          "Your team needs a jungle pick more than Ziya's specialty, leaving the role unfilled if you commit here.",
          "The enemy already drafted Biron, Charlotte, and Yao, who counter data identifies as direct answers to Ziya."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Ziya's mid-game tools come online.",
          "Mana sustain online: poke patterns become repeatable once cooldown reduction and mana regen items come online",
          "Late game: full build online, Ziya reaches the spike public guides describe — extended fights favor him once items are completed."
        ],
        "common_mistakes": [
          "Spending mana on poke that does not threaten kills, leaving you empty for the actual fight.",
          "Ignoring Biron and Charlotte on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Greeding farm in mid lane while side lanes get camped — rotation timing matters more than CS lead in most matchups."
        ],
