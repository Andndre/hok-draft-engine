      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Fate's Guidance",
            "description": "Basic Attack damage differs depending on whether he is in melee or ranged mode. Skills and melee Basic Attacks place marks on enemies.",
            "type": "passive"
          },
          {
            "name": "Scepter of Fate",
            "description": "Attacks in the target direction. If the target has a mark, skill cooldown is reduced. Ranged: Deals damage and an extra attack to marked targets. Melee: Deals damage and inflicts slow. Recovers Health upon hitting marked targets.",
            "type": "skill1"
          },
          {
            "name": "Leap of Fate",
            "description": "Dashes forward and switches attack mode. Enters melee mode if enemy heroes are nearby, increasing Physical and Magical Defense and restoring Health; otherwise, enters ranged mode, leaving a memory and gaining Movement Speed.",
            "type": "skill2"
          },
          {
            "name": "Fate Rewind",
            "description": "Gains damage reduction and crowd control immunity, recovers Health based on his current Health, and cannot move. Deals magical damage and travels back to where he was. If there is an allied tower within range, it returns to its state from 1.5s ago.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "The enemy team plays dive comp, giving you space to poke before they engage",
          "The enemy lacks reliable healing reduction, leaving sustain unchecked",
          "The enemy draft includes Diaochan, Mulan, and Wukong, who appear in counter data as matchups Heino can pressure."
        ],
        "avoid_when": [
          "The enemy has hard engage that closes distance through poke patterns",
          "The game state demands burst rather than slow attrition",
          "The enemy already drafted Butterfly, Dharma, and Lu Bu, who counter data identifies as direct answers to Heino."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Heino's mid-game tools come online.",
          "Mana sustain online: poke patterns become repeatable once cooldown reduction and mana regen items come online",
          "Late game: full build online, Heino reaches the spike public guides describe — extended fights favor him once items are completed."
        ],
        "common_mistakes": [
          "Spending mana on poke that does not threaten kills, leaving you empty for the actual fight.",
          "Forcing all-ins against opponents already wearing anti-heal — your healing barely activates.",
          "Ignoring Butterfly and Dharma on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Greeding farm in mid lane while side lanes get camped — rotation timing matters more than CS lead in most matchups."
        ],
