      "content": [
        {
          "type": "Passive",
          "name": "Law of Infinity",
          "desc": "Grants a Movement Speed boost to herself and a nearby teammate. Thetides created by her skills deal extra damage when they overlap"
        },
        {
          "type": "Skill 1",
          "name": "Leaping Koi Tide",
          "desc": "Launches and damages enemies in a line ahead, leaving a tide that dealscontinuous damage. Gains Movement Speed when using skills."
        },
        {
          "type": "Skill 2",
          "name": "Sea of Fate",
          "desc": "Conjures a magic circle that teleports her and an ally within it back to Baserestoring their Mana and granting a Movement Speed boost"
        },
        {
          "type": "Ultimate",
          "name": "Severing Surge",
          "desc": "Launches and damages enemies along a line, leaving a tide that deals"
        }
      ]
    },
    {
      "source": "HOKFIRE",
      "url": "https://www.hokfire.com/",
      "field": "guide",
      "content": {
        "pros": [
          "Game-changing global utility",
          "Strong healing and speed",
          "Flexible engage or disengage"
        ],
        "cons": [
          "Low damage",
          "Ultimate is read-heavy - bad portals throw games",
          "Squishy if caught alone"
        ],
        "gameplay_tips": "Da Qiao rewards good map awareness over mechanics. Her Twin Portals can win games by collapsing your whole team onto an isolated enemy, reinforcing a contested objective, or yanking allies out of a fight that's gone wrong. Use Lover's Bond by staying close to your carry for the speed and heal, poke with Blessing Wave, and treat Lucky Step as your safety button. The hardest part is choosing the right moment to portal - when in doubt, use it to save rather than to gamble on a risky engage.\n\n## Key Combos\n- Ultimate to teleport your team into a gank, then Skill 1 to heal during the fight.\n- Ultimate defensively to pull a diving ally out of a lost fight."
      }
    },
    {
      "source": "Kurohiko",
      "url": "https://hok.kurohiko.id/",
      "field": "tactical_tips",
      "content": "Cepet bunuh hero sekarat di dalem lingkaran biar gak di-teleport pulang. Di mid game tetep ngumpul biar musuh gak cepet kumpul dan ngeroyok."
    },
    {
      "source": "HoKStats",
      "url": "https://hokstats.gg/heroes/da-qiao/",
      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Law of Infinity",
            "description": "Gains Movement Speed. Her tide can be triggered again by the skill to deal damage.",
            "type": "passive"
          },
          {
            "name": "Leaping Koi Tide",
            "description": "Launches and damages enemies in a line ahead, leaving a tide that deals continuous damage. Gains Movement Speed when using skills.",
            "type": "skill1"
          },
          {
            "name": "Sea of Fate",
            "description": "Conjures a portal that allows a teammate to recall and come back.",
            "type": "skill2"
          },
          {
            "name": "Severing Surge",
            "description": "Launches and damages enemies along a line, leaving a tide that deals continuous damage.",
            "type": "ultimate"
          },
          {
            "name": "Eye of the Whirlpool",
            "description": "Conjures a magic circle that deals damage, lets her teammates teleport to it, and gains a shield.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "The enemy draft has squishy backline targets that Da Qiao can isolate with Sea of Fate",
          "Your team has the structure to use her ability to protect the marksman, set vision, and engage on cooldown windows, since Da Qiao delivers utility, vision, and timely peel for the carries.",
          "The enemy draft includes Luna and Mozi, who appear in counter data as matchups Da Qiao can pressure."
        ],
        "avoid_when": [
          "You need sustained damage rather than one-shot windows tied to Severing Surge's cooldown",
          "Your team needs a damage pick more than Da Qiao's specialty, leaving the role unfilled if you commit here.",
          "The enemy already drafted Arke and Han Xin, who counter data identifies as direct answers to Da Qiao."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Da Qiao's mid-game tools come online.",
          "Ultimate unlocked: Severing Surge is the threshold where Da Qiao starts deleting low-resist targets in one rotation",
          "Late game: cooldowns become short enough that Sea of Fate influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Opening fights when the enemy still has full crowd control, getting deleted before damage lands.",
          "Ignoring Arke and Han Xin on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Forgetting vision while looking for picks — losing the marksman because the support roamed without setting wards is a recurring mistake."
        ],
