      "source": "HoKStats",
      "url": "https://hokstats.gg/heroes/annette/",
      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Whisperwind",
            "description": "Gains Mana and increased cooldown speed while moving. If there are teammates nearby, also gains Movement Speed.",
            "type": "passive"
          },
          {
            "name": "Gust Force",
            "description": "Conjures a persistent magic circle at the target location. The magic circle damages and slows enemy units. The magic circle grants Movement Speed to teammates.",
            "type": "active"
          },
          {
            "name": "Wind Cuffs",
            "description": "Fires an orb in the target direction, gaining a shield and Movement Speed. The orb damages enemies it hits. The orb grants a shield to teammates it hits. If the orb passes through a Gust Force magic circle, it pushes the magic circle to its destination.",
            "type": "active"
          },
          {
            "name": "Hurricane Wall",
            "description": "Conjures a barrier around herself, knocking back enemies and dealing damage. Enemies that touch the barrier take damage and are stunned. Teammates within the barrier gain crowd control immunity. Untargetable while channeling.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "Pick Annette when your team needs shields, peel, and area control to protect a backline carry."
        ],
        "avoid_when": [
          "Avoid Annette when your composition lacks damage or needs a Roamer who can start fights from long range."
        ],
        "power_spikes": [
          "Hurricane Wall is Annette's key teamfight spike because it knocks enemies back, stuns at the barrier, and grants nearby allies crowd control immunity."
        ],
        "common_mistakes": [
          "Do not spend Hurricane Wall only for damage; its knockback, barrier, and ally protection are the reasons it can turn a fight."
        ],
