  "sources": [
    {
      "source": "HOKFIRE",
      "url": "https://www.hokfire.com/",
      "field": "abilities",
      "content": [
        {
          "type": "Passive",
          "name": "Whisperwind",
          "desc": "Standing near an allied hero grants Annette bonus movement speed, and while she keeps moving she gains extra mana regeneration and cooldown reduction."
        },
        {
          "type": "Skill 1",
          "name": "Gust Force",
          "desc": "Conjures a ring of swirling wind that damages enemies inside over time and slows them, with the slow stacking the longer they linger."
        },
        {
          "type": "Skill 2",
          "name": "Wind Cuffs",
          "desc": "Fires a wind orb that recoils her backward to create space. The orb damages enemies and shields any allies it passes through, including herself, while briefly boosting her movement speed."
        },
        {
          "type": "Ultimate",
          "name": "Hurricane Wall",
          "desc": "Raises a circular wall of wind that knocks enemies out of its area and deals magic damage as it forms - strong for peeling and zoning in team fights."
        }
      ]
    },
