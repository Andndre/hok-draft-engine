      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Assassination",
            "description": "Gains 2 marks from defeating heroes and 1 mark from assisting or killing monsters/minions. When she accumulates 3 marks, the next skill used will not enter cooldown.",
            "type": "passive"
          },
          {
            "name": "Whirlwind",
            "description": "Deals damage to enemies around her and gains a shield. Her Movement Speed increases during this time.",
            "type": "skill1"
          },
          {
            "name": "Sword Propel",
            "description": "Deals damage in the target direction and inflicts slow.",
            "type": "skill2"
          },
          {
            "name": "Death Dealer",
            "description": "Jumps to the target, dealing damage. If the target is defeated within a certain time, the skill's cooldown will be reset.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "Your team can engage first, letting Butterfly second-wave into low-health targets",
          "Your team has the structure to use her ability to clear camps efficiently and convert pressure into ganks, since Butterfly delivers tempo from objectives and cross-map kill threats.",
          "The enemy draft includes Wang Zhaojun and Luban No.7, who appear in counter data as matchups Butterfly can pressure."
        ],
        "avoid_when": [
          "Your team has no primary engage, leaving the cleanup pick with nothing to follow up on",
          "Your team needs a tank pick more than Butterfly's specialty, leaving the role unfilled if you commit here.",
          "The enemy team is built around answers to Cleanup, removing the windows Butterfly's kit needs to perform."
        ],
        "power_spikes": [
          "Early game: jungle clear into level-4 ganks is the first window where Butterfly can translate routes into kills.",
          "Ultimate online: Death Dealer provides the cleanup finisher once the enemy commits cooldowns",
          "Late game: full build online, Butterfly reaches the spike public guides describe — extended fights favor her once items are completed."
        ],
        "common_mistakes": [
          "Engaging first instead of second — cleanup picks lose their value as primary engagers.",
          "Engaging without checking enemy summoner-spell cooldowns, which often decide whether Butterfly's commit reaches the target alive.",
          "Pathing predictably and getting tracked by the enemy jungler — vary first clear and rotate based on ward placement rather than muscle memory."
        ],
