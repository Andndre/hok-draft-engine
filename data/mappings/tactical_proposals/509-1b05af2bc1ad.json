      "field": "abilities",
      "content": [
        {
          "type": "Passive",
          "name": "Moving Mountain",
          "desc": "Basic Attacks deal extra damage. While protecting a teammate and when in turret mode, Basic Attacks deal ranged damage and inflict slow."
        },
        {
          "type": "Skill 1",
          "name": "Bastion",
          "desc": "Select a teammate: Dashes to the target, then shelters them, granting both himself and the teammate a shield. The teammate controls both heroes' movement during this time. Select an allied tower or any tower ruins: Merges with the tower, becoming a turret and gaining a shield. Becomes untargetable and recovers Health every second. Restores the same amount of Health to the tower and grants it a shield of equal strength."
        },
        {
          "type": "Skill 2",
          "name": "Collision Course",
          "desc": "Charges forward, dealing damage and tossing back the first enemy hero hit and nearby targets. Thrown targets damage and stun nearby enemies upon landing."
        },
        {
          "type": "Ultimate",
          "name": "Allshield",
          "desc": "Deploys a giant shield, knocking back, damaging, and slowing enemies. The shield then travels forward, launching and damaging enemies it touches while knocking down projectiles."
        }
      ]
    },
