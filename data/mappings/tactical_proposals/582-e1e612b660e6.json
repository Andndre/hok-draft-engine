      "content": {
        "skills": [
          {
            "name": "Flow of the World",
            "description": "Can change Flow states at the Base to enhance stats. Spends 1 stack of Flow to perform an enhanced Basic Attack that deals area damage.",
            "type": "passive"
          },
          {
            "name": "Convergence",
            "description": "Channels the Flow, reducing the cooldown of other skills by 50%. Also gains 5–9 stacks of Flow based on the number of nearby heroes and minions and recovers Health based on Flow stacks. Damages and knocks back nearby enemies (without applying crowd control).",
            "type": "skill1"
          },
          {
            "name": "Flow Formation",
            "description": "Deals damage and slows enemies within range, then deals damage over time. Using the skill repeatedly within a short time enhances it, dealing damage and launching or stunning enemies. When new magic circles overlap with the initial one, they increase its damage and refresh its duration. Can spend 4 stacks of Flow to use the skill without triggering cooldown.",
            "type": "skill2"
          },
          {
            "name": "Arcane Arts",
            "description": "Continuously channels a beam to deal damage over time. While the beam is linked with a hero, continuously throws Energy Bombs that deal area damage. Can spend 5 stacks of Flow to stop the skill from entering cooldown after this use.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "Your team lacks reliable burst on isolated picks and needs single-target finishing damage",
          "Your team needs a setup hero whose Flow Formation creates kill windows for the carry",
          "The enemy back line is squishy and predictable, giving Arcane Arts an obvious target every fight."
        ],
        "avoid_when": [
          "The enemy already invested in magic resist and shields that absorb committed burst windows",
          "The enemy team is loaded with cleanse, dashes, and immunity that bypass crowd control",
          "A stronger pick in the same role is open and the matchup does not specifically reward Flowborn (Mage)'s Burst."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Flowborn (Mage)'s mid-game tools come online.",
          "Ultimate unlocked: Arcane Arts is the threshold where Flowborn (Mage) starts deleting low-resist targets in one rotation",
          "Late game: full build online, Flowborn (Mage) reaches the spike public guides describe — extended fights favor them once items are completed."
        ],
        "common_mistakes": [
          "Opening fights when the enemy still has full crowd control, getting deleted before damage lands.",
          "Throwing Flow Formation on the front-line tank instead of saving it for backline carries.",
          "Engaging without checking enemy summoner-spell cooldowns, which often decide whether Flowborn (Mage)'s commit reaches the target alive.",
          "Greeding farm in mid lane while side lanes get camped — rotation timing matters more than CS lead in most matchups."
        ],
