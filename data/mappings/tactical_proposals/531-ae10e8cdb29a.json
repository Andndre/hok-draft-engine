        "pick_when": [
          "The map shape favors gank routes, where mobility translates directly into kills",
          "Your team can engage first, letting Jing second-wave into low-health targets",
          "The enemy draft includes Dharma, Ata, and Lian Po, who appear in counter data as matchups Jing can pressure."
        ],
        "avoid_when": [
          "The team needs sustained team-fight damage rather than a single-target diver",
          "Your team has no primary engage, leaving the cleanup pick with nothing to follow up on",
          "The enemy already drafted Angela, Daji, and Gan & Mo, who counter data identifies as direct answers to Jing."
        ],
        "power_spikes": [
          "Early game: jungle clear into level-4 ganks is the first window where Jing can translate routes into kills.",
          "Ultimate unlocked: Mirror Domain converts mobility into burst, the moment Jing starts threatening picks across the map",
          "Late game: cooldowns become short enough that Shattered Illusions influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Engaging without follow-up — gap-close gets you to the target, but a solo dive without ally damage trades 1-for-1.",
          "Engaging first instead of second — cleanup picks lose their value as primary engagers.",
          "Ignoring Angela and Daji on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Pathing predictably and getting tracked by the enemy jungler — vary first clear and rotate based on ward placement rather than muscle memory."
        ],
