  "sources": [
    {
      "source": "HOKFIRE",
      "url": "https://www.hokfire.com/",
      "field": "abilities",
      "content": [
        {
          "type": "Passive",
          "name": "Lethal Reflections",
          "desc": "Jing and her image apply 2 different types of marks on enemies when they deal damage. If an enemy has both types of mark at the same time, they take damage and the cooldowns of Skill 1 and Skill 2 are reset."
        },
        {
          "type": "Skill 1",
          "name": "Reflective Assault",
          "desc": "Dashes forward, damaging enemies in her path and slowing them while enhancing her next Basic Attack. If no mirror image is present on the battlefield, one will be created to fight alongside her."
        },
        {
          "type": "Skill 2",
          "name": "Shattered Illusions",
          "desc": "Deals damage to nearby enemies while recovering Health and gaining increased Movement Speed. If no mirror image is present on the battlefield, then one will be created to fight alongside her. skill3 Dimensional Shift Switch locations with her mirror image. Stocks up to 4 charges."
        },
        {
          "type": "Ultimate",
          "name": "Mirror Domain",
          "desc": "Dashes forward, pulling enemies to the center of her magic circle and immobilizing them there. She gains damage reduction while inside the circle, and recovers Health when she swaps locations."
        }
      ]
    },
