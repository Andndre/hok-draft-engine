        "pick_when": [
          "Your team needs a setup hero whose Power Word - Fate creates kill windows for the carry",
          "Your team has the structure to use his ability to farm safely and rotate to side lanes when the wave allows, since Liang delivers consistent damage output and timely roams.",
          "The enemy draft includes Han Xin, Lam, and Mulan, who appear in counter data as matchups Liang can pressure."
        ],
        "avoid_when": [
          "The enemy team is loaded with cleanse, dashes, and immunity that bypass crowd control",
          "Your team needs a jungle pick more than Liang's specialty, leaving the role unfilled if you commit here.",
          "The enemy already drafted Li Xin, Mayene, and Mulan, who counter data identifies as direct answers to Liang."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Liang's mid-game tools come online.",
          "Ultimate online: Power Word - Control extends control duration, making team fights snowball off a single hit",
          "Late game: cooldowns become short enough that Power Word - Fate influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Throwing Power Word - Fate on the front-line tank instead of saving it for backline carries.",
          "Ignoring Li Xin and Mayene on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Greeding farm in mid lane while side lanes get camped — rotation timing matters more than CS lead in most matchups."
        ],
