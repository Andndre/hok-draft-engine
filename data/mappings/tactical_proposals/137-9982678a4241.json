    {
      "source": "Kurohiko",
      "url": "https://hok.kurohiko.id/",
      "field": "tactical_tips",
      "content": "1) Sima Yi di awal kekurangan energi. Paksa dia keluar dari zona silence biar gak bisa balikin energi. 2) Pasif skill 2 ngubah sebagian magic damage yang udah diterima jadi heal, bukan ngurangin damage langsung."
    },
    {
      "source": "HoKStats",
      "url": "https://hokstats.gg/heroes/sima-yi/",
      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Quiet Whispers",
            "description": "Gains vision of casters within range. Using this skill will enhance his Basic Attack and deal damage.",
            "type": "passive"
          },
          {
            "name": "Shadow Stings",
            "description": "Summons an untargetable spirit to increase Movement Speed, gaining crowd control immunity and dealing damage after passing through an enemy.",
            "type": "active"
          },
          {
            "name": "Barren Lands",
            "description": "Sima Yi damages and silences enemies in the surrounding area. Passive: Upon taking damage, Sima Yi recovers Health in proportion to the damage.",
            "type": "active"
          },
          {
            "name": "Death Descends",
            "description": "Releases a shockwave over the target area, dealing damage to enemies upon landing.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "Your draft can capitalize on early picks and snowball lane leads",
          "Your team has the structure to use his ability to clear camps efficiently and convert pressure into ganks, since Sima Yi delivers tempo from objectives and cross-map kill threats.",
          "The enemy draft includes Lu Bu, Wuyan, and Menki, who appear in counter data as matchups Sima Yi can pressure."
        ],
        "avoid_when": [
          "The team needs sustained team-fight damage rather than a single-target diver",
          "Your team needs a tank pick more than Sima Yi's specialty, leaving the role unfilled if you commit here.",
          "The enemy already drafted Alessio, Arli, and Lady Zhen, who counter data identifies as direct answers to Sima Yi."
        ],
        "power_spikes": [
          "Early game: Sima Yi is listed as an early-game threat in public guide data — convert the early window into objectives before scaling picks come online.",
          "Mid game: with cooldown reduction online, gap-close skills come back fast enough to chain into multiple fights",
          "Late game: cooldowns become short enough that Barren Lands influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Diving while enemy hard control is still up, which directly counters Sima Yi's engage.",
          "Ignoring Alessio and Arli on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Pathing predictably and getting tracked by the enemy jungler — vary first clear and rotate based on ward placement rather than muscle memory."
        ],
