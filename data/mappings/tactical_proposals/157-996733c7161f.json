      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "HISSATSU SHINOBI-BACHI",
            "description": "Periodically gains an enhanced Basic Attack that lets her dash while dealing damage and knocking back enemies in her path. After using an enhanced Basic Attack or any skill, she can roll and gain Movement Speed.",
            "type": "passive"
          },
          {
            "name": "HISHOU RYUUENJIN",
            "description": "Dashes forward to deal damage and launch enemies in the target area. Recovers Energy upon hit.",
            "type": "skill1"
          },
          {
            "name": "KACHOUSEN",
            "description": "Throws her fan to damage and slow a target enemy while reducing their Magical Defense. Hits recover Energy. After it hits, the fan also deals magical damage to the closest unit behind the target.",
            "type": "skill2"
          },
          {
            "name": "CHOU HISSATSU SHINOBI-BACHI",
            "description": "Dashes forward to deal damage and knock back enemies while reducing their Physical Attack. Recovers Energy upon hitting a target.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "Your team lacks reliable burst on isolated picks and needs single-target finishing damage",
          "The map shape favors gank routes, where mobility translates directly into kills",
          "The enemy back line is squishy and predictable, giving CHOU HISSATSU SHINOBI-BACHI an obvious target every fight."
        ],
        "avoid_when": [
          "The matchup is grouped and shielded, leaving no isolated targets to delete",
          "Enemy peel is strong and Mai Shiranui cannot reach the backline without dying first",
          "The enemy already drafted Alessio, Charlotte, and Di Renjie, who counter data identifies as direct answers to Mai Shiranui."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Mai Shiranui's mid-game tools come online.",
          "Two-item spike: once core damage is online, Mai Shiranui's KACHOUSEN starts one-shotting backline picks",
          "Late game: cooldowns become short enough that KACHOUSEN influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Committing CHOU HISSATSU SHINOBI-BACHI when the target still has a shield, dash, or cleanse available, wasting the cooldown.",
          "Engaging without follow-up — gap-close gets you to the target, but a solo dive without ally damage trades 1-for-1.",
          "Ignoring Alessio and Charlotte on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Greeding farm in mid lane while side lanes get camped — rotation timing matters more than CS lead in most matchups."
        ],
