        "pick_when": [
          "The enemy team has multiple high-mobility threats that need to be locked down before they reach your backline",
          "Your team needs a primary front-line who can engage on cooldown windows",
          "The enemy draft includes Han Xin and Arke, who appear in counter data as matchups Arthur can pressure."
        ],
        "avoid_when": [
          "Your team lacks the follow-up damage to convert your control windows into kills",
          "The enemy stacks anti-tank items like armor penetration and percent-HP damage, melting front-liners quickly",
          "The enemy already drafted Xiang Yu and Lady Sun, who counter data identifies as direct answers to Arthur."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Arthur's mid-game tools come online.",
          "Ultimate online: Might of Excalibur extends control duration, making team fights snowball off a single hit",
          "Late game: Glacial Buckler, Overlord's Platemail, and Eye of the Phoenix on the bar means Arthur can soak commits in 5v5 team fights for his carries."
        ],
        "common_mistakes": [
          "Throwing Whirling Strike on the front-line tank instead of saving it for backline carries.",
          "Building damage items hoping to deal kills, when the team needs the durability that makes you a tank in the first place.",
          "Ignoring Xiang Yu and Lady Sun on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Forcing solo engages instead of waiting for ally commit — Arthur's value compounds when the team follows up on engages."
        ],
