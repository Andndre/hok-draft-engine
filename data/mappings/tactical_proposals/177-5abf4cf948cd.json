        "pick_when": [
          "Your team can engage first, letting Chano second-wave into low-health targets",
          "The enemy team has front-line targets that Chano can chip down with sustained ranged damage",
          "The enemy draft includes Liu Bei and Shouyue, who appear in counter data as matchups Chano can pressure."
        ],
        "avoid_when": [
          "Your team has no primary engage, leaving the cleanup pick with nothing to follow up on",
          "The game is decided early before the marksman can hit core item spikes",
          "The enemy already drafted Ziya and Mai Shiranui, who counter data identifies as direct answers to Chano."
        ],
        "power_spikes": [
          "Early game: farm safely behind the support, surviving lane phase to reach the marksman scaling window.",
          "Ultimate online: Leader Stance provides the cleanup finisher once the enemy commits cooldowns",
          "Late game: full build online, Chano reaches the spike public guides describe — extended fights favor him once items are completed."
        ],
        "common_mistakes": [
          "Engaging first instead of second — cleanup picks lose their value as primary engagers.",
          "Auto-attacking instead of repositioning when the enemy assassin is missing — losing the marksman loses the fight.",
          "Ignoring Ziya and Mai Shiranui on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Auto-attacking through enemy dive instead of repositioning — losing the marksman in early fights collapses the late-game win condition."
        ],
