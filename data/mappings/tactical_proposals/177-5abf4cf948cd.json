      "content": [
        {
          "type": "Passive",
          "name": "Hunting",
          "desc": "Whenever he moves through brush, gains Movement Speed and enhances his next Basic Attack to a double shot that deals extra damage. Leaps when emerging from brush."
        },
        {
          "type": "Skill 1",
          "name": "Soaring Signal",
          "desc": "Leaps into the air, gaining Movement Speed and allowing him to traverse terrain. While airborne, his Basic Attack fires a powerful arrow, dealing physical damage and knocking back enemies."
        },
        {
          "type": "Skill 2",
          "name": "Lupine Trap",
          "desc": "Throws a wolf spirit trap at a target location. When triggered, it deals physical damage and summons a wolf spirit to attack the enemy."
        },
        {
          "type": "Ultimate",
          "name": "Leader Stance",
          "desc": "Summons wolf spirits and gains the ability to shoot while moving. Also boosts Physical Attack, Movement Speed, and Attack Speed for 8s."
        }
      ]
    },
