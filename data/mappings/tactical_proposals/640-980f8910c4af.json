    {
      "source": "HOKFIRE",
      "url": "https://www.hokfire.com/",
      "field": "abilities",
      "content": [
        {
          "skill_id": 64000,
          "type": "Passive",
          "name": "Whisperwind",
          "desc": "Gains Mana and increased cooldown speed while moving. If there are teammates nearby, also gains <color=#6fc075>Movement Speed</color>.",
          "cd": 1000,
          "cost": 0,
          "tags": [
            "Cooldown",
            "Speed Up"
          ],
          "icon": "https://camp.honorofkings.com/Global/Common/UGUI/SystemRes/902_HeroSkillIcon/64000.png"
        },
        {
          "skill_id": 64010,
          "type": "Skill 1",
          "name": "Gust Force",
          "desc": "Conjures a persistent magic circle at the target location.\nThe magic circle <color=#db70d0>damages</color> and <color=#50c1eb>slows</color> enemy units.\nThe magic circle grants <color=#6fc075>Movement Speed</color> to teammates.",
          "cd": 12500,
          "cost": 40,
          "tags": [
            "Damage",
            "Slow",
            "Speed Up"
          ],
          "icon": "https://camp.honorofkings.com/Global/Common/UGUI/SystemRes/902_HeroSkillIcon/64010.png"
        },
        {
          "skill_id": 64020,
          "type": "Skill 2",
          "name": "Wind Cuffs",
          "desc": "Fires an orb in the target direction, gaining a <color=#6fc075>shield</color> and <color=#6fc075>Movement Speed</color>.\nThe orb <color=#db70d0>damages</color> enemies it hits.\nThe orb grants a <color=#6fc075>shield</color> to teammates it hits.\nIf the orb passes through a Gust Force magic circle, it pushes the magic circle to its destination.",
          "cd": 15000,
          "cost": 60,
          "tags": [
            "Damage",
            "Shield",
            "Movement"
          ],
          "icon": "https://camp.honorofkings.com/Global/Common/UGUI/SystemRes/902_HeroSkillIcon/64020.png"
        },
        {
          "skill_id": 64030,
          "type": "Skill 3",
          "name": "Hurricane Wall",
          "desc": "Conjures a barrier<color=#4f6f95></color> around herself, <color=#50c1eb>knocking back</color> enemies and dealing <color=#db70d0>damage</color>. Enemies that touch the barrier take <color=#db70d0>damage</color> and are <color=#50c1eb>stunned</color>. Teammates within the barrier gain <color=#ffce49>crowd control immunity</color>.\n<color=#ffce49>Untargetable</color> while channeling.",
          "cd": 75000,
          "cost": 120,
          "tags": [
            "Immunity",
            "CC Immunity",
            "Crowd Control"
          ],
          "icon": "https://camp.honorofkings.com/Global/Common/UGUI/SystemRes/902_HeroSkillIcon/64030.png"
        }
      ]
    },
