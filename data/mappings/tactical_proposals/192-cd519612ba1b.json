      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Gunner's Spirit",
            "description": "Basic Attacks increase Physical Attack and Critical Rate.",
            "type": "passive"
          },
          {
            "name": "Unleash Your Potential",
            "description": "Gains a Movement Speed boost. Exits Turret Mode if it is active. Permanently gains Physical Attack upon learning.",
            "type": "skill1"
          },
          {
            "name": "Lay the Mines",
            "description": "Places a trap in the target area. The trap grants vision of enemies that trigger it, while also inflicting damage, slow, and sunder on them and granting Huang Zhong a shield.",
            "type": "skill2"
          },
          {
            "name": "Bring out the Artillery",
            "description": "Dashes and deploys a turret while refreshing his Skill 1. He becomes immobile, gains Attack Range, and increases his Physical and Magical Defense. Basic Attacks deal area damage. The turret will be deactivated after a certain number of Basic Attacks.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "The enemy team relies on long-cooldown engage skills that leave them vulnerable post-fight",
          "The enemy team plays dive comp, giving you space to poke before they engage",
          "The enemy draft includes Xuance, Mai Shiranui, and Jing, who appear in counter data as matchups Huang Zhong can pressure."
        ],
        "avoid_when": [
          "The enemy team disengages well, so cleanup windows never open",
          "The enemy has hard engage that closes distance through poke patterns",
          "A stronger pick in the same role is open and the matchup does not specifically reward Huang Zhong's Cleanup."
        ],
        "power_spikes": [
          "Early game: farm safely behind the support, surviving lane phase to reach the marksman scaling window.",
          "Ultimate online: Bring out the Artillery provides the cleanup finisher once the enemy commits cooldowns",
          "Late game: full build online, Huang Zhong reaches the spike public guides describe — extended fights favor him once items are completed."
        ],
        "common_mistakes": [
          "Engaging first instead of second — cleanup picks lose their value as primary engagers.",
          "Spending mana on poke that does not threaten kills, leaving you empty for the actual fight.",
          "Engaging without checking enemy summoner-spell cooldowns, which often decide whether Huang Zhong's commit reaches the target alive.",
          "Auto-attacking through enemy dive instead of repositioning — losing the marksman in early fights collapses the late-game win condition."
        ],
