        "pick_when": [
          "The team draft favors extended team fights where healing scales",
          "Your team has the structure to use his ability to farm safely and rotate to side lanes when the wave allows, since Gao delivers consistent damage output and timely roams.",
          "The enemy draft includes Mai Shiranui, Wukong, and Xuance, who appear in counter data as matchups Gao can pressure."
        ],
        "avoid_when": [
          "The enemy already builds anti-heal items, neutralizing your sustain plan",
          "Your team needs a jungle pick more than Gao's specialty, leaving the role unfilled if you commit here.",
          "A stronger pick in the same role is open and the matchup does not specifically reward Gao's Sustained Damage."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Gao's mid-game tools come online.",
          "Lifesteal item online: trade patterns flip from neutral to favorable once sustain stacks with damage",
          "Late game: cooldowns become short enough that String Bender influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Forcing all-ins against opponents already wearing anti-heal — your healing barely activates.",
          "Engaging without checking enemy summoner-spell cooldowns, which often decide whether Gao's commit reaches the target alive.",
          "Greeding farm in mid lane while side lanes get camped — rotation timing matters more than CS lead in most matchups."
        ],
