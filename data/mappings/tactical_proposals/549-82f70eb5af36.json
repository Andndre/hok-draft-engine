      "content": [
        {
          "skill_id": 54900,
          "type": "Passive",
          "name": "Inner Demon Flame (Xin Mo Xiong Yan)",
          "desc": "Possesses an innate 20% critical rate. Basic attacks and abilities generate 'Mind Energy' (capped at 60). At maximum energy, attack range and damage increase significantly. After casting any skill, the next basic attack becomes an enhanced 4-strike combo with slide dashes, each strike capable of critically hitting and triggering on-hit effects.",
          "cd": "0",
          "cost": "0",
          "tags": [
            "Critical",
            "Burst",
            "Dash",
            "Enhanced Attack"
          ],
          "icon": "https://game.gtimg.cn/images/yxzj/img201606/heroimg/549/54900.png"
        },
        {
          "skill_id": 54901,
          "type": "Skill 1",
          "name": "Mind Barrier (Po Wang Yi Ji)",
          "desc": "Performs a short dash and enters a parry/block stance. Successfully blocking enemy attacks instantly fills Mind Energy to maximum, granting burst damage and sustain on the counterattack.",
          "cd": "7",
          "cost": "45",
          "tags": [
            "Dash",
            "Parry",
            "Damage Block",
            "Counter"
          ],
          "icon": "https://game.gtimg.cn/images/yxzj/img201606/heroimg/549/54900.png"
        },
        {
          "skill_id": 54902,
          "type": "Skill 2",
          "name": "Shadow Levitation (Teng Yun Bi Ri)",
          "desc": "Charges and levitates into the air to evade incoming ground damage and control. Slams down at the target location, dealing physical damage, stunning enemies, and generating Mind Energy.",
          "cd": "8",
          "cost": "50",
          "tags": [
            "Invulnerability",
            "Airborne",
            "Stun",
            "AoE"
          ],
          "icon": "https://game.gtimg.cn/images/yxzj/img201606/heroimg/549/54930.png"
        },
        {
          "skill_id": 54903,
          "type": "Ultimate",
          "name": "Twin Soul Severance (Shuang Xin Gui Yi)",
          "desc": "Becomes untargetable (invulnerable) while unleashing chaotic demon illusions, crashing down upon target enemy heroes with massive burst physical damage and knock-up. Essential for diving the enemy backline and dodging lethal ultimates.",
          "cd": "35",
          "cost": "100",
          "tags": [
            "Untargetable",
            "Burst",
            "Knockup",
            "Finisher"
          ],
          "icon": "https://game.gtimg.cn/images/yxzj/img201606/heroimg/549/54930.png"
        }
      ]
    },
