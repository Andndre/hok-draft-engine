    {
      "source": "HOKFIRE",
      "url": "https://www.hokfire.com/",
      "field": "abilities",
      "content": [
        {
          "skill_id": 52900,
          "type": "Passive",
          "name": "Pangu Ax",
          "desc": "Every time Pangu uses Pangu's ax to attack an enemy hero, he will accumulate 1 grid of energy. After reaching 4 grids, the ax will shatter and turn into an energy arm to attack, and refresh 50% of the maximum cooldown of skill 1. Pangu Ax: Basic attack causes the enemy to bleed, causing physical damage of 1%~1.7% of the target's Max HP every 0.5 seconds, lasting 2 seconds. Energy Arm: Basic attacks gain a larger attack range and cause additional physical damage of 4%~6.8% of the target's Max HP.",
          "cd": "0",
          "cost": "0",
          "tags": [
            "Bleed",
            "Enhance",
            "Transform"
          ],
          "icon": "https://game.gtimg.cn/images/yxzj/img201606/heroimg/529/52900.png"
        },
        {
          "skill_id": 52901,
          "type": "Skill 1",
          "name": "Furious Raid",
          "desc": "Pangu leaps to the designated location, causing 200/240/280/320/360/400 (+100% physical attack) physical damage when landing, and strengthens the next basic attack, releasing the enhanced basic attack. Then it will rush towards the target, knocking back enemies on the path and causing 100/120/140/160/180/200 (+50% physical attack) physical damage. At the same time, it will increase the attack speed by 10/20/30/40/50/60% for 3 seconds. In the energy arm state, you can only charge in the specified direction, gain the same attack speed effect, and the cooldown time is halved.",
          "cd": "12/11.2/10.4/9.6/8.8/8",
          "cost": "0",
          "tags": [
            "Movement",
            "Knock Back",
            "Jump"
          ],
          "icon": "https://game.gtimg.cn/images/yxzj/img201606/heroimg/529/52910.png"
        },
        {
          "skill_id": 52902,
          "type": "Skill 2",
          "name": "Grip of Suppression",
          "desc": "Pangu summons the Hand of Justice to attack the designated enemy, marking the hit enemy and causing 200/240/280/320/360/400 (+50% physical attack) physical damage and 30% slowdown, lasting 2 seconds. Pangu's basic attack will restore 6% of the Max HP when hitting the marked target. [Suppressing Grip] will disarm the enemy, making it unable to perform basic attacks for 2 seconds.",
          "cd": "10/9.6/9.2/8.8/8.4/8",
          "cost": "0",
          "tags": [
            "Disarm",
            "Slow",
            "Recovery"
          ],
          "icon": "https://game.gtimg.cn/images/yxzj/img201606/heroimg/529/52920.png"
        },
        {
          "skill_id": 52903,
          "type": "Skill 3",
          "name": "Create a new world",
          "desc": "Pangu jumped into the air and used Pangu's ax to create 5 cracks. Each crack caused 200/400/600 (+90% physical attack) physical damage, and caused disarm and 90% deceleration for 2 seconds. The deceleration effect continued to decay. Rift will only cause 25% damage when hitting the same unit repeatedly. After releasing the skill, Pangu immediately entered the energy arm state. During the skill release process, the super body effect is obtained. Using skill 3 during the leap of skill 1 can immediately create a rift.",
          "cd": "60/55/50",
          "cost": "0",
          "tags": [
            "Disarm",
            "Slow",
            "Fissure"
          ],
          "icon": "https://game.gtimg.cn/images/yxzj/img201606/heroimg/529/52930.png"
        },
        {
          "skill_id": 52904,
          "type": "Skill 4",
          "name": "",
