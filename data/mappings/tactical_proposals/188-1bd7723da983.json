      "content": [
        {
          "skill_id": 18800,
          "type": "Passive",
          "name": "Harmony of Nine Cauldrons (Jiu Ding Qi Ming)",
          "desc": "Can place sacred Cauldrons (Ding) across the battlefield. Learning the Ultimate converts Da Yu's recall spell into a Teleport when near any Cauldron, allowing him to teleport with iron body (crowd control immunity) to any active Cauldron location. Active Cauldrons grant vision, continuous HP regeneration, and act as global strategic fast-travel beacons.",
          "cd": "0",
          "cost": "0",
          "tags": [
            "Teleport",
            "Global Presence",
            "Vision",
            "Regeneration",
            "Iron Body"
          ],
          "icon": "https://game.gtimg.cn/images/yxzj/img201606/heroimg/188/18800.png"
        },
        {
          "skill_id": 18801,
          "type": "Skill 1",
          "name": "Mountain Stabilizer (Sui Shan Ding Shi)",
          "desc": "Summons a defensive Cauldron at the target spot, unleashing concentric shockwaves that deal physical damage and slow/knock up enemies. Provides vision in bushes and heals passing allies.",
          "cd": "7",
          "cost": "40",
          "tags": [
            "Summon",
            "Shockwave",
            "Knockup",
            "Heal",
            "Vision"
          ],
          "icon": "https://game.gtimg.cn/images/yxzj/img201606/heroimg/188/18800.png"
        },
        {
          "skill_id": 18802,
          "type": "Skill 2",
          "name": "Heaven Hunter Stance (Pi Ming Shou Tian)",
          "desc": "Enters an empowered hunting stance, gaining movement speed and extending basic attacks into ranged empowered strikes with delay-interrupt mechanics (fast/slow blade timing), dealing physical damage and interrupting enemy dashes while regenerating HP.",
          "cd": "9",
          "cost": "50",
          "tags": [
            "Empowered Attack",
            "Interrupt",
            "Slow",
            "Heal"
          ],
          "icon": "https://game.gtimg.cn/images/yxzj/img201606/heroimg/188/18800.png"
        },
        {
          "skill_id": 18803,
          "type": "Ultimate",
          "name": "Heaven and Earth as One (Qian Kun Yi Tong)",
          "desc": "Calls down a colossal Primeval Cauldron from the sky, crashing into the target area with massive area knock-up and chained resonance damage with all nearby Cauldrons. Provides team-wide damage mitigation and sustained territorial dominance.",
          "cd": "45",
          "cost": "100",
          "tags": [
            "Ultimate",
            "Area Knockup",
            "Resonance",
            "Damage Reduction"
          ],
          "icon": "https://game.gtimg.cn/images/yxzj/img201606/heroimg/188/18800.png"
        }
      ]
    },
