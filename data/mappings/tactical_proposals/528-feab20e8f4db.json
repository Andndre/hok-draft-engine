          {
            "name": "Wavebreaker",
            "description": "Becomes submerged and gains Movement Speed. Use this skill again to dash and deal damage. Can remain submerged indefinitely in the river. Gains extra Movement Speed when an enemy hero with low Health is nearby.",
            "type": "skill1"
          },
          {
            "name": "Space Split",
