        ],
        "pick_when": [
          "The enemy team has carries with limited self-peel that Lam can reach before the team can react",
          "Your team can engage first, letting Lam second-wave into low-health targets",
          "The enemy draft includes Lu Bu, Wuyan, and Xiang Yu, who appear in counter data as matchups Lam can pressure."
        ],
        "avoid_when": [
          "Enemy peel is strong and Lam cannot reach the backline without dying first",
          "Your team has no primary engage, leaving the cleanup pick with nothing to follow up on",
          "The enemy already drafted Erin, Liang, and Luara, who counter data identifies as direct answers to Lam."
        ],
        "power_spikes": [
          "Early game: jungle clear into level-4 ganks is the first window where Lam can translate routes into kills.",
          "Ultimate unlocked: Death From Below converts mobility into burst, the moment Lam starts threatening picks across the map",
          "Late game: cooldowns become short enough that Space Split influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Engaging without follow-up — gap-close gets you to the target, but a solo dive without ally damage trades 1-for-1.",
          "Engaging first instead of second — cleanup picks lose their value as primary engagers.",
          "Ignoring Erin and Liang on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Pathing predictably and getting tracked by the enemy jungler — vary first clear and rotate based on ward placement rather than muscle memory."
        ],
