      "field": "abilities",
      "content": [
        {
          "type": "Passive",
          "name": "Secret Skill - Rush",
          "desc": "When an enemy is within a certain range from Prince of Lanling, moving toward them will grant him increased Movement Speed."
        },
        {
          "type": "Skill 1",
          "name": "Secret Skill - Split",
          "desc": "Deals damage to enemies within a certain range, and deals a 2nd strike of damage to a random enemy in range."
        },
        {
          "type": "Skill 2",
          "name": "Secret Skill - Sling",
          "desc": "Throws a dagger that damages, slows, and marks the first enemy in its path. When attacking marked targets, stuns them and recovers Health. Marks deal grievous damage when disappearing."
        },
        {
          "type": "Ultimate",
          "name": "Secret Skill - Strike",
          "desc": "Exits stealth mode and dashes in the target direction, dealing damage to enemies in his path."
        }
      ]
    },
