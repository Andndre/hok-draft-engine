      "content": {
        "skills": [
          {
            "name": "Secret Skill - Rush",
            "description": "When an enemy is within a certain range, moving toward them will grant him increased Movement Speed.",
            "type": "passive"
          },
          {
            "name": "Secret Skill - Split",
            "description": "Deals damage to enemies within a certain range, and deals a second strike of damage to a random enemy in range. September 10 update: Skill 1 - Secret Skill - Split: base damage 350 (+70 per skill level) (+125% extra Physical Attack) → 400 (+80 per skill level) (+135% extra Physical Attack).",
            "type": "skill1"
          },
          {
            "name": "Secret Skill - Sling",
            "description": "Throws a dagger that damages, slows, and marks the first enemy in its path. When attacking marked targets, he stuns them and recovers Health. Marks deal grievous damage when disappearing.",
            "type": "skill2"
          },
          {
            "name": "Secret Skill - Strike",
            "description": "Exits stealth mode and dashes in the target direction, dealing damage to enemies in his path. September 10 update: Ultimate - Secret Skill - Strike: base damage 700 (+350 per skill level) (+250% extra Physical Attack) → 750 (+375 per skill level) (+255% extra Physical Attack).",
            "type": "ultimate"
          },
          {
            "name": "Secret Skill - Shadow",
            "description": "Enters stealth after a short delay, increasing Movement Speed. Leaving stealth increases Attack Speed. Stealth ends if near an enemy hero for too long.",
            "type": "skill4"
          }
        ],
        "pick_when": [
          "The enemy team has carries with limited self-peel that Gao Changgong can reach before the team can react",
          "Your team can engage first, letting Gao Changgong second-wave into low-health targets",
          "The enemy composition leaves room for Gao Changgong to reach the targets his kit punishes."
        ],
        "avoid_when": [
          "The team needs sustained team-fight damage rather than a single-target diver",
          "Your team has no primary engage, leaving the cleanup pick with nothing to follow up on",
          "The enemy team is built around answers to Gap-Close, removing the windows Gao Changgong's kit needs to perform."
        ],
        "power_spikes": [
          "Early game: Gao Changgong is listed as an early-game threat in public guide data — convert the early window into objectives before scaling picks come online.",
          "Ultimate unlocked: Secret Skill - Strike converts mobility into burst, the moment Gao Changgong starts threatening picks across the map",
          "Late game: cooldowns become short enough that Secret Skill - Sling influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Engaging without follow-up — gap-close gets you to the target, but a solo dive without ally damage trades 1-for-1.",
          "Engaging first instead of second — cleanup picks lose their value as primary engagers.",
          "Engaging without checking enemy summoner-spell cooldowns, which often decide whether Gao Changgong's commit reaches the target alive.",
          "Pathing predictably and getting tracked by the enemy jungler — vary first clear and rotate based on ward placement rather than muscle memory."
        ],
