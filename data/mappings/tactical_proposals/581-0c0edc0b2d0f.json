  "source_hash": "0c0edc0b2d0fc4b3c1dc2cb3a3ef8d716afe443456f0274ef64b69a362ab5f11",
  "sources": [
    {
      "source": "HOKFIRE",
      "url": "https://www.hokfire.com/",
      "field": "abilities",
      "content": [
        {
          "type": "Passive",
          "name": "Flow of the World",
          "desc": "Can change Flow states at the Base to enhance stats. Vitality: Increases max Health and Physical and Magical Defense. Piercing Heart: Increases max Health and Physical Attack. Haste: Increases max Health and Movement Speed. Focus: Increases max Health and Cooldown Reduction. Spend 1 stack of Flow to perform an enhanced Basic Attack and deal damage and gain recovery."
        },
        {
          "type": "Skill 1",
          "name": "Convergence",
          "desc": "Channels the Flow, reducing the cooldown of other skills by 50%. Also gains 5-9 stacks of Flow based on the number of nearby heroes and minions and recovers Health based on Flow stacks. Damages and knocks back nearby enemies (without applying crowd control)."
        },
        {
          "type": "Skill 2",
          "name": "Power From Within",
          "desc": "Charges at the target and slashes, dealing damage, launching enemies, and gaining a shield. Using the skill continuously over a short time converts it to Clearing Slash and Rifting Slash. If the skill is not on cooldown, spend 4 stacks of Flow to stop it from entering cooldown after use."
        },
        {
          "type": "Ultimate",
          "name": "All In",
          "desc": "Leaps to the target location and attacks, dealing damage and launching enemies. If the skill is not on cooldown, spend 5 stacks of Flow to stop it from entering cooldown after this use."
        }
      ]
    },
    {
      "source": "HOKFIRE",
      "url": "https://www.hokfire.com/",
      "field": "guide",
      "content": {
        "pros": [
          "Absorbs a lot of damage for the team",
          "Brings reliable crowd control to open fights",
          "Very hard to bring down once built"
        ],
        "cons": [
          "Deals limited personal damage",
          "Needs the team to follow up on engages",
          "Can be kited by mobile enemies"
        ],
        "gameplay_tips": "Flowborn (Tank) is a Tank who plays the Clash Lane. Your aim is to soak damage, start fights and peel for your carries. Pick your moment to use All In, then follow up with Convergence and Power From Within. Manage the wave, respect ganks, and look to roam once you have a lead."
      }
    },
    {
      "source": "Kurohiko",
      "url": "https://hok.kurohiko.id/",
      "field": "tactical_tips",
      "content": ""
    },
    {
      "source": "HoKStats",
      "url": "https://hokstats.gg/heroes/flowborn-tank/",
      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Flow of the World",
            "description": "Can change Flow states at the Base to enhance stats. Vitality: Increases max Health and Physical and Magical Defense. Piercing Heart: Increases max Health and Physical Attack. Haste: Increases max Health and Movement Speed. Focus: Increases max Health and Cooldown Reduction. Spend 1 stack of Flow to perform an enhanced Basic Attack and deal damage and gain recovery.",
            "type": "passive"
          },
          {
            "name": "Convergence",
            "description": "Channels the Flow, reducing the cooldown of other skills by 50%. Also gains 5–9 stacks of Flow based on the number of nearby heroes and minions and recovers Health based on Flow stacks. Damages and knocks back nearby enemies (without applying crowd control).",
            "type": "skill1"
          },
          {
            "name": "Power From Within",
            "description": "Charges at the target and slashes, dealing damage, launching enemies, and gaining a shield. Using the skill continuously over a short time converts it to Clearing Slash and Rifting Slash. If the skill is not on cooldown, spend 4 stacks of Flow to stop it from entering cooldown after use.",
            "type": "skill2"
          },
          {
            "name": "All In",
            "description": "Leaps to the target location and attacks, dealing damage and launching enemies. If the skill is not on cooldown, spend 5 stacks of Flow to stop it from entering cooldown after this use.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "The enemy team has multiple high-mobility threats that need to be locked down before they reach your backline",
          "Your team needs a primary front-line who can engage on cooldown windows",
          "The enemy team relies on grouped fights or channeled abilities, exactly what Power From Within interrupts best."
        ],
        "avoid_when": [
          "Your team lacks the follow-up damage to convert your control windows into kills",
          "The enemy stacks anti-tank items like armor penetration and percent-HP damage, melting front-liners quickly",
          "The enemy team is built around answers to Crowd Control, removing the windows Flowborn (Tank)'s kit needs to perform."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Flowborn (Tank)'s mid-game tools come online.",
          "Ultimate online: All In extends control duration, making team fights snowball off a single hit",
          "Late game: Bloodweeper, Overlord's Platemail, and Glacial Buckler on the bar means Flowborn (Tank) can soak commits in 5v5 team fights for their carries."
        ],
        "common_mistakes": [
          "Throwing Power From Within on the front-line tank instead of saving it for backline carries.",
          "Building damage items hoping to deal kills, when the team needs the durability that makes you a tank in the first place.",
          "Engaging without checking enemy summoner-spell cooldowns, which often decide whether Flowborn (Tank)'s commit reaches the target alive.",
          "Forcing solo engages instead of waiting for ally commit — Flowborn (Tank)'s value compounds when the team follows up on engages."
        ],
