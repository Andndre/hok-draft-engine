          {
            "name": "The King's Return",
            "description": "Unleashes sword energy, dealing damage to enemies and slowing them. Recovers Health if he hits a hero. While using Sacred Tree Blessing, he unleashes 1 additional blast of sword energy.",
            "type": "skill2"
          },
          {
            "name": "Sacred Tree Blessing",
            "description": "Cleanses himself of all crowd control effects, deals physical damage to nearby enemies, and gains max Health. While this skill is active, Skill 2 and enhanced Basic Attacks unleash sword energy. He also continuously gains enhanced Basic Attacks. Tap again to end the skill.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "Your draft needs a Fighter who can play Clash Lane or Jungle and stay relevant through sustained trades.",
          "The enemy team has to fight you in melee range, giving Fatih time to cycle skills into enhanced basic attacks.",
          "Your team can use Fatih as a side-lane pressure point while he scales into item-dependent duels."
        ],
        "avoid_when": [
          "The enemy composition can kite from range and deny Fatih repeated basic attacks after each skill cast.",
          "You need immediate long-range initiation rather than a melee sustain fighter who ramps through repeated trades.",
          "The enemy team can stack anti-heal or burst him before Sacred Tree Blessing and lifesteal can turn the fight."
        ],
        "power_spikes": [
          "Early lane or jungle: public guide data recommends prioritizing Skill 1 to improve early combat ability.",
          "Ultimate available: Sacred Tree Blessing lets Fatih remove crowd control, gain max health, and improve Skill 2 plus enhanced basic attacks.",
          "Core damage items online: Axe of Torment, Eternity Blade, Master Sword, Shadow Ripper, and Bloodweeper push him toward stronger extended fights."
        ],
        "common_mistakes": [
          "Using skills without weaving enhanced basic attacks, which wastes Fatih's main recovery and damage pattern.",
          "Casting Sacred Tree Blessing before enemy control is committed instead of using it as a turn tool.",
          "Building only damage when the matchup requires Eye of the Phoenix or Spikemail-style durability.",
          "Forcing short burst trades when Fatih's value is strongest in prolonged melee fights."
        ],
