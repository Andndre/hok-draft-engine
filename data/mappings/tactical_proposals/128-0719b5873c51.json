      "field": "abilities",
      "content": [
        {
          "type": "Passive",
          "name": "Only the Strong (Fatih)",
          "desc": "Enhance Recovery Whenever he uses a skill, gains an enhanced Basic Attack that unleashes sword energy. Enhanced Basic Attacks have higher Attack Speed and restore Health. While using Sacred Tree Blessing, enhanced Basic Attacks unleash 1 additional blast of sword energy."
        },
        {
          "type": "Skill 1",
          "name": "The King's Blade",
          "desc": "Damage Movement Crowd Control Dashes forward to deal damage. The 3rd skill use also launches the enemy."
        },
        {
          "type": "Skill 2",
          "name": "The King's Return",
          "desc": "Damage Slow Unleashes sword energy, dealing damage to enemies and slowing them. Recovers Health if he hits a hero. While using Sacred Tree Blessing, he unleashes 1 additional blast of sword energy."
        },
        {
          "type": "Ultimate",
          "name": "Sacred Tree Blessing",
          "desc": "Enhance Purify Recovery Removes all crowd control effects on himself, dealing physical damage to nearby enemies and gaining max Health. Boosts the effects of Skill 2 and enhanced Basic Attacks while this skill is active. Tap again to end the skill."
        }
      ]
    },
