        "pick_when": [
          "The enemy lacks reliable healing reduction, leaving sustain unchecked",
          "Your team needs a primary damage carry that scales with items and team-fight positioning",
          "The enemy draft includes Ying, Han Xin, and Lam, who appear in counter data as matchups Erin can pressure."
        ],
        "avoid_when": [
          "The game state demands burst rather than slow attrition",
          "The enemy stacks dive and assassins, making it impossible for the marksman to free-cast in fights",
          "The enemy already drafted Dun, who counter data identifies as direct answers to Erin."
        ],
        "power_spikes": [
          "Early game: farm safely behind the support, surviving lane phase to reach the marksman scaling window.",
          "Lifesteal item online: trade patterns flip from neutral to favorable once sustain stacks with damage",
          "Late game: with full damage online, sustained DPS outpaces enemy healing in extended fights."
        ],
        "common_mistakes": [
          "Forcing all-ins against opponents already wearing anti-heal — your healing barely activates.",
          "Auto-attacking instead of repositioning when the enemy assassin is missing — losing the marksman loses the fight.",
          "Ignoring Dun on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Auto-attacking through enemy dive instead of repositioning — losing the marksman in early fights collapses the late-game win condition."
