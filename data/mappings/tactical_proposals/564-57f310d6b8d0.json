    {
      "source": "HOKFIRE",
      "url": "https://www.hokfire.com/",
      "field": "abilities",
      "content": [
        {
          "type": "Passive",
          "name": "Slack Off a Lil Bit",
          "desc": "Recovery replaced by Slack Off, which restores Strength and Health. She will also slack off while at rest.She will not slack off when she attacks, is attacked, moves, or is in the Serious State."
        },
        {
          "type": "Skill 1",
          "name": "Whatever (I)",
          "desc": "Costs 1 Punch Strength. Runs forward, pulling in enemies in a cone-shaped area and damaging them.F ollow up with Skill 2 or another use of this skill for various effects."
        },
        {
          "type": "Skill 2",
          "name": "Whatever (II)",
          "desc": "Costs 1 Kick Strength. Jumps to dodge crowd controls and damage, and recover Health. Can follow up with Skill 2 or another use of this skill for different effects."
        },
        {
          "type": "Ultimate",
          "name": "Get Serious",
          "desc": "Damages nearby enemies. Recovers 1 Punch Strength and Kick Strength Bar, and increases max Strength for each by 1. Gains Movement Speed and is less affected by slow."
        }
      ]
    },
