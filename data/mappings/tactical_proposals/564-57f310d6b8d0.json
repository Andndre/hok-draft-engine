      "content": {
        "skills": [
          {
            "name": "Slack Off a Lil Bit",
            "description": "Using skills consumes Strength, which is recovered over time. When not moving, Strength and Health recover faster.",
            "type": "passive"
          },
          {
            "name": "Whatever (I)",
            "description": "Runs in the target direction and pulls enemies in front, dealing area damage and slowing them. 1-1 Combo: Deals area damage and launches enemies. 1-2 Combo: Deals damage and recovers Health.",
            "type": "skill1"
          },
          {
            "name": "Exploit Weakness",
            "description": "Runs in the target direction and pulls enemies in front, dealing area damage and slowing them. 1-1 Combo: Deals area damage and launches enemies. 1-2 Combo: Deals damage and recovers Health.",
            "type": "skill1"
          },
          {
            "name": "Defend by Attacking",
            "description": "Runs in the target direction and pulls enemies in front, dealing area damage and slowing them. 1-1 Combo: Deals area damage and launches enemies. 1-2 Combo: Deals damage and recovers Health.",
            "type": "skill1"
          },
          {
            "name": "Feint to Retreat",
            "description": "Skill 2: Flips forward, gains immunity and damage reduction, and recovers Health. 2-1 Combo: Blinks behind the enemy, knocking them back and damaging them. 2-2 Combo: Deals damage before leaping back, gaining immunity and damage reduction, and recovering Health.",
            "type": "skill2"
          },
          {
            "name": "Whatever (II)",
            "description": "Skill 2: Flips forward, gains immunity and damage reduction, and recovers Health. 2-1 Combo: Blinks behind the enemy, knocking them back and damaging them. 2-2 Combo: Deals damage before leaping back, gaining immunity and damage reduction, and recovering Health.",
            "type": "skill2"
          },
          {
            "name": "Flee Danger",
            "description": "Skill 2: Flips forward, gains immunity and damage reduction, and recovers Health. 2-1 Combo: Blinks behind the enemy, knocking them back and damaging them. 2-2 Combo: Deals damage before leaping back, gaining immunity and damage reduction, and recovering Health.",
            "type": "skill2"
          },
          {
            "name": "Get Serious",
            "description": "Damages nearby enemies and recovers Punch Strength and Kick Strength. For 10s, increases max Strength and gains Movement Speed.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "The enemy team has carries with limited self-peel that Mayene can reach before the team can react",
          "The enemy team has multiple high-mobility threats that need to be locked down before they reach your backline",
          "The enemy draft includes Nuwa, Mi Yue, and Liang, who appear in counter data as matchups Mayene can pressure."
        ],
        "avoid_when": [
          "Enemy peel is strong and Mayene cannot reach the backline without dying first",
          "Your team lacks the follow-up damage to convert your control windows into kills",
          "The enemy already drafted Yaria, who counter data identifies as direct answers to Mayene."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Mayene's mid-game tools come online.",
          "Mid game: with cooldown reduction online, gap-close skills come back fast enough to chain into multiple fights",
          "Late game: cooldowns become short enough that Whatever (II) influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Diving while enemy hard control is still up, which directly counters Mayene's engage.",
          "Throwing Whatever (II) on the front-line tank instead of saving it for backline carries.",
          "Ignoring Yaria on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Forcing solo engages instead of waiting for ally commit — Mayene's value compounds when the team follows up on engages."
        ],
