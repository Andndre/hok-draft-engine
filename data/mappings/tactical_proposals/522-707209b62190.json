          "type": "Skill 2",
          "name": "Starburn (Yao)",
          "desc": "Moves quickly, dealing damage and slowing enemies in his path."
        },
        {
          "type": "Ultimate",
          "name": "Return to Dust",
          "desc": "Returns to his location 2s ago, removes Star Reduction, and deals damage to enemies in his path. Passive: Some of his damage taken is converted into Star Reduction after a short delay."
        }
      ]
