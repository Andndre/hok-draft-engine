        "pick_when": [
          "The enemy team has carries with limited self-peel that Yao can reach before the team can react",
          "The enemy team relies on long-cooldown engage skills that leave them vulnerable post-fight",
          "The enemy draft includes Angela, Mi Yue, and Ziya, who appear in counter data as matchups Yao can pressure."
        ],
        "avoid_when": [
          "The team needs sustained team-fight damage rather than a single-target diver",
          "The enemy team disengages well, so cleanup windows never open",
          "The enemy team is built around answers to Gap-Close, removing the windows Yao's kit needs to perform."
        ],
        "power_spikes": [
          "Early game: jungle clear into level-4 ganks is the first window where Yao can translate routes into kills.",
          "Mid game: with cooldown reduction online, gap-close skills come back fast enough to chain into multiple fights",
          "Late game: cooldowns become short enough that Star Rush influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Diving while enemy hard control is still up, which directly counters Yao's engage.",
          "Engaging first instead of second — cleanup picks lose their value as primary engagers.",
          "Engaging without checking enemy summoner-spell cooldowns, which often decide whether Yao's commit reaches the target alive.",
          "Pathing predictably and getting tracked by the enemy jungler — vary first clear and rotate based on ward placement rather than muscle memory."
        ],
