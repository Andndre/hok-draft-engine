  "sources": [
    {
      "source": "HOKFIRE",
      "url": "https://www.hokfire.com/",
      "field": "abilities",
      "content": [
        {
          "type": "Passive",
          "name": "Jade Carriage - View from Above",
          "desc": "Can jump onto and walk on natural walls while gaining Movement Speed. Basic Attack becomes ranged while on a wall."
        },
        {
          "type": "Skill 1",
          "name": "Jade Chase - Returning Strike",
          "desc": "Dashes, dealing damage to enemies in his path and launching them. Enhances his next 2 Basic Attacks. Enhanced Basic Attacks deal extra damage and restore Health."
        },
        {
          "type": "Skill 2",
          "name": "Stepping on Jade",
          "desc": "Jumps onto the target wall."
        },
        {
          "type": "Ultimate",
          "name": "Hardened Jade Seal",
          "desc": "Deals damage and marks nearby enemies. Using the skill again unleashes 4 strikes of damage and restores his Health. If a marked enemy's Health is below a certain threshold, the last strike deals grievous damage. When on a wall, he can use this skill to jump down."
        }
      ]
    },
