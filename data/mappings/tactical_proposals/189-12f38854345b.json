    {
      "source": "HoKStats",
      "url": "https://hokstats.gg/heroes/guiguzi/",
      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "The Laws of Nature",
            "description": "After leaving the enemy's vision, the next Basic Attack deals extra damage and slows the enemy.",
            "type": "passive"
          },
          {
            "name": "Prophecy - Hidden Hand",
            "description": "Gains a Movement Speed boost and camouflages himself, reducing the Physical and Magical Defense of enemies touched while dealing damage to them.",
            "type": "skill1"
          },
          {
            "name": "The Animist",
            "description": "Summons spriteflies, and after a brief delay, pulls in nearby enemies, dealing damage and stunning them. If he hits an enemy hero, he and nearby teammates gain a shield.",
            "type": "skill2"
          },
          {
            "name": "Prophecy - Out of Sight",
            "description": "After 1s, camouflages and grants Movement Speed to himself and nearby teammates. Gains vision of the nearest enemy hero. The disguise breaks upon using Basic Attacks, skills, or actions that affect enemies.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "The enemy team has multiple high-mobility threats that need to be locked down before they reach your backline",
          "Your team has the structure to use his ability to protect the marksman, set vision, and engage on cooldown windows, since Guiguzi delivers utility, vision, and timely peel for the carries.",
          "The enemy draft includes Li Xin, Mozi, and Zilong, who appear in counter data as matchups Guiguzi can pressure."
        ],
        "avoid_when": [
          "Your team lacks the follow-up damage to convert your control windows into kills",
          "Your team needs a damage pick more than Guiguzi's specialty, leaving the role unfilled if you commit here.",
          "A stronger pick in the same role is open and the matchup does not specifically reward Guiguzi's Crowd Control."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Guiguzi's mid-game tools come online.",
          "Ultimate online: Prophecy - Out of Sight extends control duration, making team fights snowball off a single hit",
          "Late game: cooldowns become short enough that The Animist influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Throwing The Animist on the front-line tank instead of saving it for backline carries.",
          "Engaging without checking enemy summoner-spell cooldowns, which often decide whether Guiguzi's commit reaches the target alive.",
          "Forgetting vision while looking for picks — losing the marksman because the support roamed without setting wards is a recurring mistake."
        ],
