    {
      "source": "Kurohiko",
      "url": "https://hok.kurohiko.id/",
      "field": "tactical_tips",
      "content": "1) Hero damage jaga posisi pas teamfight dan serang Dian Wei dari jauh. 2) Tank yang HP-nya rendah jangan ngelawan Dian Wei pas ult-nya ready."
    },
    {
      "source": "HoKStats",
      "url": "https://hokstats.gg/heroes/dian-wei/",
      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Mounting Rage",
            "description": "All skills can cleanse crowd controls. Each successful cleanse boosts his Physical Attack and Attack Range, for up to 6 stacks.",
            "type": "passive"
          },
          {
            "name": "Holding On to Sanity",
            "description": "Gains a Movement Speed bonus and enhances the next Basic Attack to deal extra damage.",
            "type": "skill1"
          },
          {
            "name": "Outburst",
            "description": "Deals damage to enemies within range and slows them. His Attack Speed and Lifesteal are enhanced when striking an enemy. If he misses, he gains only half of the Attack Speed, Lifesteal, and extra Health recovery effects.",
            "type": "skill2"
          },
          {
            "name": "Leap of Fury",
            "description": "Leaps toward the target enemy, dealing damage and slowing them. Enhances himself, dealing extra damage to enemies while enhanced.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "The enemy team relies on long-cooldown engage skills that leave them vulnerable post-fight",
          "Your team has the structure to use his ability to clear camps efficiently and convert pressure into ganks, since Dian Wei delivers tempo from objectives and cross-map kill threats.",
          "The enemy draft includes Marco Polo and Musashi, who appear in counter data as matchups Dian Wei can pressure."
        ],
        "avoid_when": [
          "The enemy team disengages well, so cleanup windows never open",
          "Your team needs a tank pick more than Dian Wei's specialty, leaving the role unfilled if you commit here.",
          "The enemy already drafted Sun Bin and Diaochan, who counter data identifies as direct answers to Dian Wei."
        ],
        "power_spikes": [
          "Early game: jungle clear into level-4 ganks is the first window where Dian Wei can translate routes into kills.",
          "Ultimate online: Leap of Fury provides the cleanup finisher once the enemy commits cooldowns",
          "Late game: full build online, Dian Wei reaches the spike public guides describe — extended fights favor him once items are completed."
        ],
        "common_mistakes": [
          "Engaging first instead of second — cleanup picks lose their value as primary engagers.",
          "Ignoring Sun Bin and Diaochan on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Pathing predictably and getting tracked by the enemy jungler — vary first clear and rotate based on ward placement rather than muscle memory."
        ],
