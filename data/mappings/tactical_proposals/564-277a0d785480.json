  "sources": [
    {
      "source": "HOKFIRE",
      "url": "https://www.hokfire.com/",
      "field": "abilities",
      "content": [
        {
          "skill_id": 56400,
          "type": "Passive",
          "name": "Slack Off a Lil Bit",
          "desc": "Using skills consumes Strength, which is <color=#6bc872>recovered</color> over time. When not moving, Strength and Health <color=#6bc872>recover</color> faster.",
          "cd": 1000,
          "cost": 0,
          "tags": [
            "Recover"
          ],
          "icon": "https://camp.honorofkings.com/Global/Common/UGUI/SystemRes/902_HeroSkillIcon/56400.png"
        },
        {
          "skill_id": 56410,
          "type": "Skill 1",
          "name": "Whatever (I)",
          "desc": "Runs in the target direction and pulls enemies in front, dealing <color=#ff6600>area damage</color> and <color=#2bc6ff>slowing</color> them.\n1-1 Combo: Deals <color=#ff6600>area damage</color> and <color=#2bc6ff>launches</color> enemies.\n1-2 Combo: Deals <color=#ff6600>damage</color> and <color=#6bc872>recovers</color> Health.",
          "cd": 0,
          "cost": 0,
          "tags": [
            "Damage",
            "Crowd Control",
            "Movement"
          ],
          "icon": "https://camp.honorofkings.com/Global/Common/UGUI/SystemRes/902_HeroSkillIcon/56410.png"
        },
        {
          "skill_id": 56420,
          "type": "Skill 2",
          "name": "Whatever (II)",
          "desc": "Skill 2: <color=#6bc872>Flips</color> forward, gains <color=#ffc834>immunity</color> and <color=#6bc872>damage reduction</color>, and <color=#6bc872>recovers</color> Health.\n2-1 Combo: Blinks behind the enemy, <color=#2bc6ff>knocking them back</color> and <color=#ff6600>damaging</color> them.\n2-2 Combo: Deals <color=#ff6600>damage</color> before leaping back, gaining <color=#ffc834>immunity</color> and <color=#6bc872>damage reduction</color>, and <color=#6bc872>recovering</color> Health.",
          "cd": 0,
          "cost": 0,
          "tags": [
            "Immunity",
            "Damage Reduction",
            "Movement"
          ],
          "icon": "https://camp.honorofkings.com/Global/Common/UGUI/SystemRes/902_HeroSkillIcon/56420.png"
        },
        {
          "skill_id": 56430,
          "type": "Skill 3",
          "name": "Get Serious",
          "desc": "<color=#ff6600>Damages</color> nearby enemies and <color=#6bc872>recovers</color> Punch Strength and Kick Strength. For 10s, increases max Strength and gains <color=#6bc872>Movement Speed</color>.",
          "cd": 60000,
          "cost": 0,
          "tags": [
            "Enhance",
            "Haste",
            "Damage"
          ],
          "icon": "https://camp.honorofkings.com/Global/Common/UGUI/SystemRes/902_HeroSkillIcon/56430.png"
        }
      ]
    },
