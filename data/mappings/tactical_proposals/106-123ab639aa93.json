        "pick_when": [
          "Your team wants to siege objectives where ranged poke whittles down defenders",
          "Your team has the structure to use her ability to farm safely and rotate to side lanes when the wave allows, since Xiao Qiao delivers consistent damage output and timely roams.",
          "The enemy draft includes Ukyo Tachibana and Han Xin, who appear in counter data as matchups Xiao Qiao can pressure."
        ],
        "avoid_when": [
          "The team fight will happen in cramped jungle spaces where poke ranges are minimized",
          "Your team needs a jungle pick more than Xiao Qiao's specialty, leaving the role unfilled if you commit here.",
          "The enemy already drafted Liu Bei and Menki, who counter data identifies as direct answers to Xiao Qiao."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Xiao Qiao's mid-game tools come online.",
          "Mana sustain online: poke patterns become repeatable once cooldown reduction and mana regen items come online",
          "Late game: full build online, Xiao Qiao reaches the spike public guides describe — extended fights favor her once items are completed."
        ],
        "common_mistakes": [
          "Spending mana on poke that does not threaten kills, leaving you empty for the actual fight.",
          "Ignoring Liu Bei and Menki on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Greeding farm in mid lane while side lanes get camped — rotation timing matters more than CS lead in most matchups."
