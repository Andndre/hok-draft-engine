      "content": {
        "skills": [
          {
            "name": "Divine Awakening",
            "description": "Able to move in her Divine form after dying. When resurrected, flies toward the nearest allied tower, dealing damage and launching enemies within takeoff range.",
            "type": "passive"
          },
          {
            "name": "Holy Advance",
            "description": "Raises her shield and dashes, knocking back and dealing damage to enemies while gaining a shield that grants crowd control immunity.",
            "type": "skill1"
          },
          {
            "name": "Victory Call",
            "description": "Dashes in the target direction.",
            "type": "skill1"
          },
          {
            "name": "Unstoppable Spear",
            "description": "Dashes in the target direction and enhances the next Basic Attack, in which she charges at the enemy and deals damage to them.",
            "type": "skill2"
          },
          {
            "name": "Victory Call",
            "description": "Flaps her wings, granting a shield to a nearby teammate.",
            "type": "skill2"
          },
          {
            "name": "Immovable Aegis",
            "description": "Raises a shield that grants crowd control immunity. Damage taken while the shield is up will be returned after a brief delay, dealing damage to enemies within range.",
            "type": "ultimate"
          },
          {
            "name": "Victory Call",
            "description": "Flies toward the nearest allied tower, dealing damage and launching enemies within takeoff range.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "The enemy team has carries with limited self-peel that Athena can reach before the team can react",
          "Your team has the structure to use her ability to clear camps efficiently and convert pressure into ganks, since Athena delivers tempo from objectives and cross-map kill threats.",
          "The enemy draft includes Dharma and Gao Changgong, who appear in counter data as matchups Athena can pressure."
        ],
        "avoid_when": [
          "The team needs sustained team-fight damage rather than a single-target diver",
          "Your team needs a tank pick more than Athena's specialty, leaving the role unfilled if you commit here.",
          "The enemy already drafted Sun Bin and Guan Yu, who counter data identifies as direct answers to Athena."
        ],
        "power_spikes": [
          "Early game: Athena is listed as an early-game threat in public guide data — convert the early window into objectives before scaling picks come online.",
          "Mid game: with cooldown reduction online, gap-close skills come back fast enough to chain into multiple fights",
          "Late game: cooldowns become short enough that Unstoppable Spear influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Diving while enemy hard control is still up, which directly counters Athena's engage.",
          "Ignoring Sun Bin and Guan Yu on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Pathing predictably and getting tracked by the enemy jungler — vary first clear and rotate based on ward placement rather than muscle memory."
        ],
