        {
          "type": "Passive",
          "name": "Divine Awakening",
          "desc": "Able to move in true form after dying. Deals damage and launches enemies in range when resurrected.Deals extra damage to non-hero units."
        },
        {
          "type": "Skill 1",
          "name": "Holy Advance",
          "desc": "Dashes ahead with shield up, knocking back the enemy and dealing damagewhile gaining a shield that grants crowd control immunity."
        },
        {
          "type": "Skill 2",
          "name": "Unstoppable Spear",
          "desc": "Shifts in the target direction and enhances the next Basic Attack, chargingand dealing damage to the enemy. Hitting the same target 3 timessuccessively deals extra damage equal to lost Health."
        },
        {
          "type": "Ultimate",
          "name": "Immovable Aegis",
          "desc": "Raises a shield that grants crowd control immunity. Damage taken while theshield is up will be returned after a brief delay, dealing damage to enemieswithin range."
        }
      ]
    },
