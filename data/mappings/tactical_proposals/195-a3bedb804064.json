    {
      "source": "Kurohiko",
      "url": "https://hok.kurohiko.id/",
      "field": "tactical_tips",
      "content": "Xuance damage-nya tinggi dan punya control, jungler kuat di early-mid. Selain ngindarin sabitnya, bisa dilawan pakai Liu Bei/Arthur/Pangu/Musashi (jungle), Kongming/Diaochan/Mozi/Liang/Gao (mage), Fuzi/Guan Yu/Meng Tian/Sun Ce (fighter), Arli/Di Renjie (marksman), Lian Po/Donghuang (support)."
    },
    {
      "source": "HoKStats",
      "url": "https://hokstats.gg/heroes/xuance/",
      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Crazed Prelude",
            "description": "Deals extra damage to enemies at long range and slows them, while gaining a Movement Speed boost.",
            "type": "passive"
          },
          {
            "name": "Flailing Sickles",
            "description": "Dashes in the target direction, pulling enemies marked by his sickle a certain distance. Also enhances his next Basic Attack.",
            "type": "skill1"
          },
          {
            "name": "Nightmare Hooks",
            "description": "Charges up and gains Movement Speed. After charging, he throws the sickle to immobilize enemies and deal damage, marking the first enemy hit. Using the skill again will pull back and damage the marked enemy.",
            "type": "skill2"
          },
          {
            "name": "Crimson Blur",
            "description": "Dashes behind a target marked by his sickle, dealing damage. Beyond a certain range, he moves toward the target instead. If he has not marked a target, the hook latches onto one, dealing damage. Takes 50% less damage during the dash. Passive: Kills and assists grant Movement Speed and Attack Speed, up to 3 stacks.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "The enemy team has carries with limited self-peel that Xuance can reach before the team can react",
          "Your team can engage first, letting Xuance second-wave into low-health targets",
          "The enemy composition leaves room for Xuance to reach the targets his kit punishes."
        ],
        "avoid_when": [
          "The enemy stacks crowd control that interrupts the engage before damage goes out",
          "Your team has no primary engage, leaving the cleanup pick with nothing to follow up on",
          "The enemy already drafted Daji, Diaochan, and Gao, who counter data identifies as direct answers to Xuance."
        ],
        "power_spikes": [
          "Early game: jungle clear into level-4 ganks is the first window where Xuance can translate routes into kills.",
          "Ultimate unlocked: Crimson Blur converts mobility into burst, the moment Xuance starts threatening picks across the map",
          "Late game: cooldowns become short enough that Nightmare Hooks influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Engaging without follow-up — gap-close gets you to the target, but a solo dive without ally damage trades 1-for-1.",
          "Engaging first instead of second — cleanup picks lose their value as primary engagers.",
          "Ignoring Daji and Diaochan on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Pathing predictably and getting tracked by the enemy jungler — vary first clear and rotate based on ward placement rather than muscle memory."
        ],
