      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Reaper's Revenge",
            "description": "Gains Energy when dealing or taking damage, increasing his Movement Speed and enhancing his recovery effects.",
            "type": "passive"
          },
          {
            "name": "Blood Echo",
            "description": "Deals damage to nearby enemies and recovers Health. Charging up will boost the skill's effects. Passive: When taking damage, there is a chance to automatically trigger Skill 1.",
            "type": "skill1"
          },
          {
            "name": "Deathscythe",
            "description": "Summons scythes in the target direction, pulling back enemies within range while inflicting damage and slow.",
            "type": "skill2"
          },
          {
            "name": "Lay Waste",
            "description": "Leaps to the target location and taunts enemies while dealing damage and enhancing his recovery effects. Taunt duration increases with max Health.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "Your team needs a setup hero whose Deathscythe creates kill windows for the carry",
          "The enemy team has high physical or magic burst that demands a dedicated tank to absorb",
          "The enemy draft includes Arke and Garo, who appear in counter data as matchups Bai Qi can pressure."
        ],
        "avoid_when": [
          "The enemy team is loaded with cleanse, dashes, and immunity that bypass crowd control",
          "Your team comp lacks damage and adding another non-damage pick collapses the win condition",
          "The enemy already drafted Zhuangzi, who counter data identifies as direct answers to Bai Qi."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Bai Qi's mid-game tools come online.",
          "Ultimate online: Lay Waste extends control duration, making team fights snowball off a single hit",
          "Late game: Eye of the Phoenix, Overlord's Platemail, and Spikemail on the bar means Bai Qi can soak commits in 5v5 team fights for his carries."
        ],
        "common_mistakes": [
          "Throwing Deathscythe on the front-line tank instead of saving it for backline carries.",
          "Building damage items hoping to deal kills, when the team needs the durability that makes you a tank in the first place.",
          "Ignoring Zhuangzi on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Forcing solo engages instead of waiting for ally commit — Bai Qi's value compounds when the team follows up on engages."
        ],
