      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Warrior's Soul",
            "description": "Gains crowd control immunity when using skills. During combat, generates Battle Spirit, which increases damage reduction and Attack Speed. When out of combat, Battle Spirit is consumed to recover health.",
            "type": "passive"
          },
          {
            "name": "Burst Ram",
            "description": "Dashes in the target direction, dealing damage and launching enemies in his path. When upgraded, gains a passive effect that enhances every 3rd Basic Attack.",
            "type": "skill1"
          },
          {
            "name": "Magma Slam",
            "description": "Charges up at the original location, gaining a shield and slowing nearby enemies while pulling non-hero enemy units toward the center. After a brief delay, deals area damage. If there are enemy units within range, Skill 1's cooldown is reset.",
            "type": "skill2"
          },
          {
            "name": "Tremor Smash",
            "description": "Leaps to the target location and hammers the ground 3 times. The first 2 strikes deal damage and slow enemies, while the 3rd strike deals damage and launches them.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "The enemy team has multiple high-mobility threats that need to be locked down before they reach your backline",
          "Your team needs a primary front-line who can engage on cooldown windows",
          "The enemy draft includes Luban No.7 and Marco Polo, who appear in counter data as matchups Lian Po can pressure."
        ],
        "avoid_when": [
          "Your team lacks the follow-up damage to convert your control windows into kills",
          "The enemy stacks anti-tank items like armor penetration and percent-HP damage, melting front-liners quickly",
          "The enemy already drafted Jing, Li Bai, and Ukyo Tachibana, who counter data identifies as direct answers to Lian Po."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Lian Po's mid-game tools come online.",
          "Ultimate online: Tremor Smash extends control duration, making team fights snowball off a single hit",
          "Late game: Boots of Fortitude, Succubus Cloak, and Overlord's Platemail on the bar means Lian Po can soak commits in 5v5 team fights for his carries."
        ],
        "common_mistakes": [
          "Throwing Magma Slam on the front-line tank instead of saving it for backline carries.",
          "Building damage items hoping to deal kills, when the team needs the durability that makes you a tank in the first place.",
          "Ignoring Jing and Li Bai on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Forcing solo engages instead of waiting for ally commit — Lian Po's value compounds when the team follows up on engages."
        ],
