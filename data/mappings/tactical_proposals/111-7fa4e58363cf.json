        "pick_when": [
          "Your draft can capitalize on early picks and snowball lane leads",
          "The enemy team relies on long-cooldown engage skills that leave them vulnerable post-fight",
          "The enemy draft includes Diaochan, Nakoruru, and Ying, who appear in counter data as matchups Lady Sun can pressure."
        ],
        "avoid_when": [
          "Enemy peel is strong and Lady Sun cannot reach the backline without dying first",
          "The enemy team disengages well, so cleanup windows never open",
          "The enemy team is built around answers to Gap-Close, removing the windows Lady Sun's kit needs to perform."
        ],
        "power_spikes": [
          "Early game: farm safely behind the support, surviving lane phase to reach the marksman scaling window.",
          "Mid game: with cooldown reduction online, gap-close skills come back fast enough to chain into multiple fights",
          "Late game: full build online, Lady Sun reaches the spike public guides describe — extended fights favor her once items are completed."
        ],
        "common_mistakes": [
          "Diving while enemy hard control is still up, which directly counters Lady Sun's engage.",
          "Engaging first instead of second — cleanup picks lose their value as primary engagers.",
          "Engaging without checking enemy summoner-spell cooldowns, which often decide whether Lady Sun's commit reaches the target alive.",
          "Auto-attacking through enemy dive instead of repositioning — losing the marksman in early fights collapses the late-game win condition."
        ],
