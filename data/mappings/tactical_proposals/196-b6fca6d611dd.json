      "source": "Kurohiko",
      "url": "https://hok.kurohiko.id/",
      "field": "tactical_tips",
      "content": "1) Pas Shouyue pakai skill 2, terjang ke deketnya biar dia batalin. 2) Skill area bisa kena Shouyue yang lagi nyamar."
    },
    {
      "source": "HoKStats",
      "url": "https://hokstats.gg/heroes/shouyue/",
      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Accuracy",
            "description": "When out of combat, gains marks that increase his Physical Pierce and Basic Attack damage. Hitting enemy heroes with Basic Attacks or skills will consume marks. When his Attack Speed reaches certain thresholds, he gains marks faster.",
            "type": "passive"
          },
          {
            "name": "The Tranquil Eye",
            "description": "Places a device that grants vision. Passive: When out of combat and near natural terrain or a scouting device, he disguises himself, gaining Movement Speed and Attack Speed.",
            "type": "skill1"
          },
          {
            "name": "Wild Wind",
            "description": "Snipes in the target direction, damaging and slowing targets. This skill will be enhanced when his Attack Speed reaches certain thresholds.",
            "type": "skill2"
          },
          {
            "name": "Getaway",
            "description": "Leaps backward and fires in the target direction, dealing damage and slowing the target hit while gaining increased Movement Speed. Bullets stocked are shared with Skill 2. Passive: Increases Basic Attack range.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "Your team wants to siege objectives where ranged poke whittles down defenders",
          "Your team needs a primary damage carry that scales with items and team-fight positioning",
          "The enemy draft includes Diaochan, Nakoruru, and Ying, who appear in counter data as matchups Shouyue can pressure."
        ],
        "avoid_when": [
          "The team fight will happen in cramped jungle spaces where poke ranges are minimized",
          "The enemy stacks dive and assassins, making it impossible for the marksman to free-cast in fights",
          "The enemy already drafted Liu Bang, who counter data identifies as direct answers to Shouyue."
        ],
        "power_spikes": [
          "Early game: farm safely behind the support, surviving lane phase to reach the marksman scaling window.",
          "Mana sustain online: poke patterns become repeatable once cooldown reduction and mana regen items come online",
          "Late game: full build online, Shouyue reaches the spike public guides describe — extended fights favor him once items are completed."
        ],
        "common_mistakes": [
          "Spending mana on poke that does not threaten kills, leaving you empty for the actual fight.",
          "Auto-attacking instead of repositioning when the enemy assassin is missing — losing the marksman loses the fight.",
          "Ignoring Liu Bang on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Auto-attacking through enemy dive instead of repositioning — losing the marksman in early fights collapses the late-game win condition."
        ],
