      "field": "abilities",
      "content": [
        {
          "type": "Passive",
          "name": "Accuracy",
          "desc": "Basic Attacks deal extra damage, and Critical Rate is converted into Physical Attack. Extra Critical Rate increases Basic Attack damage. When out of combat and next to a wall, gains disguise and Movement Speed."
        },
        {
          "type": "Skill 1",
          "name": "The Tranquil Eye",
          "desc": "Plants a device that continuously grants vision Passive: Gains increased Physical Pierce when standing still, but loses it when moving."
        },
        {
          "type": "Skill 2",
          "name": "Wild Wind",
          "desc": "Fires in the target direction, damaging and slowing the target hit."
        },
        {
          "type": "Ultimate",
          "name": "Getaway",
          "desc": "Leaps backwards and fires in the target direction, damaging and slowing the target hit while gaining Movement Speed. Rounds stocked are shared with Skill 2. Passive: Increases Basic Attack range."
        }
      ]
    },
