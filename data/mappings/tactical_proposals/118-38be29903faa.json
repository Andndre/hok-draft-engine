    {
      "source": "Kurohiko",
      "url": "https://hok.kurohiko.id/",
      "field": "tactical_tips",
      "content": "1) Assassin masuk abis Sun Bin pakai control. 2) Control-nya bisa dihindarin tinggal gerak. 3) Nyebar pas teamfight biar silence dan slow ult-nya gak kena banyak orang."
    },
    {
      "source": "HoKStats",
      "url": "https://hokstats.gg/heroes/sun-bin/",
      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Hourglass of Time",
            "description": "Gains a Movement Speed bonus after using skills.",
            "type": "passive"
          },
          {
            "name": "Time Bomb",
            "description": "Fires a bomb in the target direction, which deals damage and attaches itself to the hit enemy. After a brief delay, inflicts area damage and slow.",
            "type": "skill1"
          },
          {
            "name": "Time Flux",
            "description": "Increases his and nearby teammates' Movement Speed. When the effect ends, he restores Health equal to 25% of the damage taken during the effect's duration. Passive: Gains Cooldown Reduction.",
            "type": "skill2"
          },
          {
            "name": "Time Lapse",
            "description": "Throws a bomb in the target direction, inflicting area damage, slow, and silence upon coming in contact with an enemy or reaching its max range. After a brief delay, the bomb deals area damage again.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "The enemy team has multiple high-mobility threats that need to be locked down before they reach your backline",
          "Your team has the structure to use his ability to protect the marksman, set vision, and engage on cooldown windows, since Sun Bin delivers utility, vision, and timely peel for the carries.",
          "The enemy draft includes Kaizer and Musashi, who appear in counter data as matchups Sun Bin can pressure."
        ],
        "avoid_when": [
          "Your team lacks the follow-up damage to convert your control windows into kills",
          "Your team needs a damage pick more than Sun Bin's specialty, leaving the role unfilled if you commit here.",
          "A stronger pick in the same role is open and the matchup does not specifically reward Sun Bin's Crowd Control."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Sun Bin's mid-game tools come online.",
          "Ultimate online: Time Lapse extends control duration, making team fights snowball off a single hit",
          "Late game: full build online, Sun Bin reaches the spike public guides describe — extended fights favor him once items are completed."
        ],
        "common_mistakes": [
          "Throwing Time Flux on the front-line tank instead of saving it for backline carries.",
          "Engaging without checking enemy summoner-spell cooldowns, which often decide whether Sun Bin's commit reaches the target alive.",
          "Forgetting vision while looking for picks — losing the marksman because the support roamed without setting wards is a recurring mistake."
        ],
