      "content": {
        "skills": [
          {
            "name": "Hidden Dragon",
            "description": "The Dragon Souls from his last 2 skill uses grant effects to his Basic Attacks, which damages one extra enemy. He gains marks when using skills, enhancing his next Basic Attack. When a target is attacked by more than 1 Dragon Soul, subsequent hits deal only 1% damage. When switching between Dragon Souls, souls of the same element are prioritized.",
            "type": "passive"
          },
          {
            "name": "Flaming Palm",
            "description": "Unleashes sword energy, dealing physical damage and true damage to enemies within range. Subsequent Basic Attacks deal extra damage.",
            "type": "skill1"
          },
          {
            "name": "Downpour",
            "description": "Unleashes sword energy, dealing physical damage to enemies within range and recovering Health on hit. Subsequent Basic Attacks restore Health and Mana.",
            "type": "skill2"
          },
          {
            "name": "Riding the Wind",
            "description": "Unleashes sword energy, immediately gaining Movement Speed while damaging and knocking back enemies within range. The Movement Speed increase persists after the skill ends.",
            "type": "ultimate"
          },
          {
            "name": "Infinite Vastness",
            "description": "Soars into the sky, then dives forward to damage and slow enemies in his path. Landing deals equal damage and applies Dread. Enhances himself, allowing his Basic Attacks to hit up to 2 more enemies.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "The enemy team has multiple high-mobility threats that need to be locked down before they reach your backline",
          "The team draft favors extended team fights where healing scales",
          "The enemy draft includes Guan Yu, who appear in counter data as matchups Ao'yin can pressure."
        ],
        "avoid_when": [
          "Your team lacks the follow-up damage to convert your control windows into kills",
          "The enemy already builds anti-heal items, neutralizing your sustain plan",
          "The enemy already drafted Garo, who counter data identifies as direct answers to Ao'yin."
        ],
        "power_spikes": [
          "Early game: farm safely behind the support, surviving lane phase to reach the marksman scaling window.",
          "Ultimate online: Riding the Wind extends control duration, making team fights snowball off a single hit",
          "Late game: full build online, Ao'yin reaches the spike public guides describe — extended fights favor him once items are completed."
        ],
        "common_mistakes": [
          "Throwing Downpour on the front-line tank instead of saving it for backline carries.",
          "Forcing all-ins against opponents already wearing anti-heal — your healing barely activates.",
          "Ignoring Garo on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Auto-attacking through enemy dive instead of repositioning — losing the marksman in early fights collapses the late-game win condition."
        ],
