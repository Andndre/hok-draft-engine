      "field": "abilities",
      "content": [
        {
          "skill_id": 52500,
          "type": "Passive",
          "name": "Jixia Technology",
          "desc": "Passive: Master Luban's skills will provide himself with a shield that absorbs 50 (+5*hero level) (+0.15Ap) (+2%*maximum life) damage when casting a spell or hitting the target. The shield lasts for 5 seconds and can be stacked 4 times. Every 5 seconds, Master Luban's mechanical arm completes charging and strengthens the next basic attack with 400 (+40% spell bonus) points of spell damage.",
          "cd": "0",
          "cost": "0",
          "tags": [
            "Shield",
            "Enhance"
          ],
          "icon": "https://game.gtimg.cn/images/yxzj/img201606/heroimg/525/52500.png"
        },
        {
          "skill_id": 52501,
          "type": "Skill 1",
          "name": "boost jump",
          "desc": "Master Luban jumps forward with the help of the jet power of the mechanical arm, and when he lands, he deploys a force field to knock up surrounding enemies for 0.5 seconds and cause 350/480/610/740/870/1000 (+40% Magical Attack) magic damage.",
          "cd": "10/9.6/9.2/8.8/8.4/8",
          "cost": "50",
          "tags": [
            "Movement",
            "Knock Back",
            "Jump"
          ],
          "icon": "https://game.gtimg.cn/images/yxzj/img201606/heroimg/525/52510.png"
        },
        {
          "skill_id": 52502,
          "type": "Skill 2",
          "name": "Assistants rush to help",
          "desc": "Master Luban grants a shield to a teammate and himself, and creates a link between him and himself, which lasts for 6 seconds. After the teammate confirms the interaction, he will immediately move to Master Luban's position and cause 450/540/630/720/810/900 (+45% Magical Attack) magic damage to enemies on the path. When starting to cast a spell, Master Luban's movement speed increases by 50% for 1.5 seconds. If teammates do not interact during the link, 30% of the cooldown will be returned.",
          "cd": "10/9.8/9.6/9.4/9.2/9",
          "cost": "45",
          "tags": [
            "Tether",
            "Shield",
            "Ally Mobility"
          ],
          "icon": "https://game.gtimg.cn/images/yxzj/img201606/heroimg/525/52520.png"
        },
        {
          "skill_id": 52503,
          "type": "Skill 3",
          "name": "Powerful storage",
          "desc": "Master Luban launches a mechanical arm to the fan-shaped area ahead, connecting up to 6 enemies in the area, giving priority to hero units. The connected enemy will take 250/300/350 (+25% Magical Attack) spell damage. If the connected enemy is far enough away from Master Luban, the connection will be severed. Otherwise, the enemy will be pulled to Master Luban after 1.25 seconds. Each unit pulled back will cause a small range of 600/900/1200 (+60% Magical Attack) spell damage around Master Luban, starting from the second enemy, only 25% of the damage will be caused.",
          "cd": "40/35/30",
          "cost": "60",
          "tags": [
            "Crowd Control",
            "Pull",
            "Stun"
          ],
          "icon": "https://game.gtimg.cn/images/yxzj/img201606/heroimg/525/52530.png"
        },
        {
