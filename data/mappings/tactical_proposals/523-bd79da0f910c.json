  "sources": [
    {
      "source": "HOKFIRE",
      "url": "https://www.hokfire.com/",
      "field": "abilities",
      "content": [
        {
          "type": "Passive",
          "name": "Maiden's Trick",
          "desc": "The farther away the enemy is, the more damage skills deal."
        },
        {
          "type": "Skill 1",
          "name": "Silk Imprint",
          "desc": "Throws her artifact, damaging enemies and pulling them toward it. Can be used again to pull the enemy in the target direction."
        },
        {
          "type": "Skill 2",
          "name": "Silky Beauty",
          "desc": "Releases an energy orb that continuously deals damage to enemies within range for a short time, and then explodes to deal additional damage. Enemies are slowed the first time the orb hits them."
        },
        {
          "type": "Ultimate",
          "name": "Sole Focus",
          "desc": "Resets Skill 2's cooldown and enhances herself. While enhanced, gains Movement Speed and reduces Skill 2's cooldown by half. Skill 1 can pull the enemy twice."
        }
      ]
    },
