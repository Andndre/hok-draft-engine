    {
      "source": "Kurohiko",
      "url": "https://hok.kurohiko.id/",
      "field": "tactical_tips",
      "content": "Shi itu mage control dengan burst rendah dan ngandelin banget tim, sering jadi hero utility. Hero lincah berjangkauan jauh gampang counter dia. Saran: Jin Chan/Diaochan/Shangguan/Sima Yi/Shen Mengxi/Nuwa/Mozi (mid), Lam/Gao Changgong/Arke (jungle), Lian Po/Zhuangzi (support)."
    },
    {
      "source": "HoKStats",
      "url": "https://hokstats.gg/heroes/shi/",
      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Maiden's Trick",
            "description": "The farther away the enemy is, the more damage skills deal.",
            "type": "passive"
          },
          {
            "name": "Silk Imprint",
            "description": "Throws her artifact, damaging enemies and pulling them toward it. Can be used again to pull the enemy in the target direction.",
            "type": "skill1"
          },
          {
            "name": "Silky Beauty",
            "description": "Releases an energy orb that continuously deals damage to enemies within range for a short time, and then explodes to deal additional damage. Enemies are slowed the first time the orb hits them.",
            "type": "skill2"
          },
          {
            "name": "Sole Focus",
            "description": "Resets Skill 2's cooldown and enhances herself. While enhanced, gains Movement Speed and reduces Skill 2's cooldown by half. Skill 1 can pull the enemy twice.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "The enemy team has multiple high-mobility threats that need to be locked down before they reach your backline",
          "Your team has the structure to use her ability to farm safely and rotate to side lanes when the wave allows, since Shi delivers consistent damage output and timely roams.",
          "The enemy draft includes Li Bai, Wukong, and Ukyo Tachibana, who appear in counter data as matchups Shi can pressure."
        ],
        "avoid_when": [
          "Your team lacks the follow-up damage to convert your control windows into kills",
          "Your team needs a jungle pick more than Shi's specialty, leaving the role unfilled if you commit here.",
          "The enemy already drafted Athena, who counter data identifies as direct answers to Shi."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Shi's mid-game tools come online.",
          "Ultimate online: Sole Focus extends control duration, making team fights snowball off a single hit",
          "Late game: cooldowns become short enough that Silky Beauty influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Throwing Silky Beauty on the front-line tank instead of saving it for backline carries.",
          "Ignoring Athena on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Greeding farm in mid lane while side lanes get camped — rotation timing matters more than CS lead in most matchups."
        ],
