  "sources": [
    {
      "source": "HOKFIRE",
      "url": "https://www.hokfire.com/",
      "field": "abilities",
      "content": [
        {
          "type": "Passive",
          "name": "Bloodthirsty Ancestry",
          "desc": "Becomes enhanced when Skill 1 or Ultimate hits an enemy hero. While enhanced, Basic Attacks, Skill 1, and Ultimate deal true damage and restore Health."
        },
        {
          "type": "Skill 1",
          "name": "Impaling Thrust",
          "desc": "Performs a sweep attack to the target area. Restores a certain amount of Health with each enemy hero hit. Failing to hit a hero will cause the enhancement to disappear."
        },
        {
          "type": "Skill 2",
          "name": "Souleater",
          "desc": "Slows enemies in the target area and grants a shield for each enemy hit (upto 3 stacks). The shield value is converted to Health over time."
        },
        {
          "type": "Ultimate",
          "name": "Tremble, Mortals",
          "desc": "Leaps to the target location, launching and damaging enemies within range upon landing, then forming a killing field. While inside the killing field, he gains increased Physical and Magical Defense, while enemies suffer damage and slow."
        }
      ]
    },
    {
      "source": "HOKFIRE",
      "url": "https://www.hokfire.com/",
      "field": "guide",
      "content": {
        "pros": [
          "Strong sustained damage",
          "Hard engage with a reliable stun",
          "Tanky once he hits his ult"
        ],
        "cons": [
          "Kited easily before items",
          "Weak early game",
          "Ult on a long cooldown"
        ],
        "gameplay_tips": "## Early Game\nFarm safely and respect ranged matchups until level 4.\n\n## Team Fights\nWait for the enemy to commit, then Charge the highest-value target and pop your Ultimate.\n\n- Never open a fight without your Ultimate available\n- Use Sky-Piercer Sweep to peel enemies off your carry"
      }
    },
    {
      "source": "Kurohiko",
      "url": "https://hok.kurohiko.id/",
      "field": "tactical_tips",
      "content": "Lu Bu kasih true damage yang nembus armor dan shield, kuat lawan hero tebel dan ber-shield, tapi lambat bantu tim dan kurang ngancem backline. Hero clash yang bisa ngimbangin: Mi Yue, Fuzi (jago bertahan di lane), Ma Chao (gerakannya licin), Yao (susah disentuh), Li Xin, Yang Jian. Gak neken penuh, tapi laning 50:50."
    },
    {
      "source": "HoKStats",
      "url": "https://hokstats.gg/heroes/lu-bu/",
      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Bloodthirsty Ancestry",
            "description": "Enchants his weapon when it hits an enemy during Skill 1 or Ultimate. While enchanted, Basic Attacks and Skills deal additional true damage and recover his Health.",
            "type": "passive"
          },
          {
            "name": "Impaling Thrust",
            "description": "Performs a sweep attack on the target area. Restores a certain amount of Health with each enemy hero hit. Failing to hit a hero will cause his enhancement to disappear.",
            "type": "skill1"
          },
          {
            "name": "Souleater",
            "description": "Slows and damages enemies in the target area and gains a shield for each enemy hit (up to 3 stacks). The shield value is converted to Health over time.",
            "type": "skill2"
          },
          {
            "name": "Tremble, Mortals",
            "description": "Leaps to the target location, launching and damaging enemies within range upon landing, then forming a ring of slaughter. While inside the ring, he gains increased Physical and Magical Defense, while enemies suffer damage and slow.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "Your team can engage first, letting Lu Bu second-wave into low-health targets",
          "The enemy team has high physical or magic burst that demands a dedicated tank to absorb",
          "The enemy draft includes Heino, Daji, and Luna, who appear in counter data as matchups Lu Bu can pressure."
        ],
        "avoid_when": [
          "Your team has no primary engage, leaving the cleanup pick with nothing to follow up on",
          "Your team comp lacks damage and adding another non-damage pick collapses the win condition",
          "The enemy already drafted Han Xin, Lam, and Pei, who counter data identifies as direct answers to Lu Bu."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Lu Bu's mid-game tools come online.",
          "Ultimate online: Tremble, Mortals provides the cleanup finisher once the enemy commits cooldowns",
          "Late game: full build online, Lu Bu reaches the spike public guides describe — extended fights favor him once items are completed."
        ],
        "common_mistakes": [
          "Engaging first instead of second — cleanup picks lose their value as primary engagers.",
          "Building damage items hoping to deal kills, when the team needs the durability that makes you a tank in the first place.",
          "Ignoring Han Xin and Lam on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Forcing solo engages instead of waiting for ally commit — Lu Bu's value compounds when the team follows up on engages."
        ],
