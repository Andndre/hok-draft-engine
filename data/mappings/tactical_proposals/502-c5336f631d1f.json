          },
          {
            "name": "Guarding Stance",
            "description": "Gains a shield and Attack Speed. Deals damage to enemies within range and continues to deal damage over time.",
            "type": "skill2"
          },
          {
            "name": "Tiger Form",
            "description": "Switches to tiger form, gaining Movement Speed and enhancing the next 2 Basic Attacks. The 1st Basic Attack lets him dash toward a locked-on target, damaging and slowing them. The 2nd Basic Attack deals magical damage.",
            "type": "ultimate"
          },
          {
            "name": "Beastly Instincts",
            "description": "Gains extra Physical Attack, Physical Defense, Magical Defense, and Movement Speed while in tiger form.",
            "type": "ultimate"
          },
          {
            "name": "Roaring Tiger Stance",
            "description": "Bites enemies, dealing damage. Restores Energy when this attack defeats an enemy.",
            "type": "ultimate"
          },
          {
            "name": "Leaping Tiger Stance",
            "description": "Pounces in the target direction. If runs into terrain, latches onto it briefly and can pounce again. If the pounce hits an enemy, he deals damage, recovers Energy, and reduces this skill's cooldown.",
            "type": "ultimate"
          },
          {
            "name": "Human Form",
            "description": "Switches to human form, gains Movement Speed and enhances the next Basic Attack. Deals damage to the target and enemies in a cone-shaped area behind them.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "Your team wants to siege objectives where ranged poke whittles down defenders",
          "Your team can engage first, letting Pei second-wave into low-health targets",
          "The enemy draft includes Arthur, Lu Bu, and Wuyan, who appear in counter data as matchups Pei can pressure."
        ],
        "avoid_when": [
          "The team fight will happen in cramped jungle spaces where poke ranges are minimized",
          "Your team has no primary engage, leaving the cleanup pick with nothing to follow up on",
          "The enemy already drafted Gan & Mo, Meng Ya, and Milady, who counter data identifies as direct answers to Pei."
        ],
        "power_spikes": [
          "Early game: Pei is listed as an early-game threat in public guide data — convert the early window into objectives before scaling picks come online.",
          "Mana sustain online: poke patterns become repeatable once cooldown reduction and mana regen items come online",
          "Late game: cooldowns become short enough that Guarding Stance influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Spending mana on poke that does not threaten kills, leaving you empty for the actual fight.",
          "Engaging first instead of second — cleanup picks lose their value as primary engagers.",
          "Ignoring Gan & Mo and Meng Ya on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Pathing predictably and getting tracked by the enemy jungler — vary first clear and rotate based on ward placement rather than muscle memory."
        ],
