        "pick_when": [
          "Your team needs a setup hero whose Frigid Prison creates kill windows for the carry",
          "Your team has the structure to use her ability to farm safely and rotate to side lanes when the wave allows, since Wang Zhaojun delivers consistent damage output and timely roams.",
          "The enemy team relies on grouped fights or channeled abilities, exactly what Frigid Prison interrupts best."
        ],
        "avoid_when": [
          "The enemy team is loaded with cleanse, dashes, and immunity that bypass crowd control",
          "Your team needs a jungle pick more than Wang Zhaojun's specialty, leaving the role unfilled if you commit here.",
          "The enemy team is built around answers to Crowd Control, removing the windows Wang Zhaojun's kit needs to perform."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Wang Zhaojun's mid-game tools come online.",
          "Ultimate online: Winter is Here extends control duration, making team fights snowball off a single hit",
          "Late game: cooldowns become short enough that Frigid Prison influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Throwing Frigid Prison on the front-line tank instead of saving it for backline carries.",
          "Engaging without checking enemy summoner-spell cooldowns, which often decide whether Wang Zhaojun's commit reaches the target alive.",
          "Greeding farm in mid lane while side lanes get camped — rotation timing matters more than CS lead in most matchups."
        ],
