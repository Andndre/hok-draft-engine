      "field": "abilities",
      "content": [
        {
          "skill_id": 18600,
          "type": "Passive",
          "name": "gold glitter",
          "desc": "Passive: When an enemy non-hero unit within 800 range of Taiyi Zhenren dies, Taiyi Zhenren and nearby teammates will receive an additional 20% gold coins.",
          "cd": "0",
          "cost": "0",
          "tags": [
            "Gold Bonus",
            "Buff"
          ],
          "icon": "https://game.gtimg.cn/images/yxzj/img201606/heroimg/186/18600.png"
        },
        {
          "skill_id": 18601,
          "type": "Skill 1",
          "name": "accident",
          "desc": "Taiyi Zhenren starts refining the potion, increasing his movement speed by 20% and gaining a 300/350/400/450/500/550 shield, which lasts up to 5 seconds. When the refining is completed or ends early, it will cause 165/225/285/345/4 to surrounding enemies. 05/465 (+55% Magical Attack)-495/675/855/1035/1215/1395 (+165% Magical Attack) spell damage and stun it for 0.5 seconds-0.75 seconds (the maximum stun is 1.25 seconds as the skill level grows). When the potion is refined, the hero unit hit by the explosion can automatically refresh and release this skill again. The longer the refining time, the higher the damage and the longer the stun time.",
          "cd": "5",
          "cost": "65",
          "tags": [
            "Damage",
            "Stun",
            "Speed Up"
          ],
          "icon": "https://game.gtimg.cn/images/yxzj/img201606/heroimg/186/18610.png"
        },
        {
          "skill_id": 18602,
          "type": "Skill 2",
          "name": "third hand",
          "desc": "Taiyi Zhenren's furnace extends a tentacle in the specified direction and will pull itself towards the first target hit; if it is an enemy target, it will also cause 450/500/550/600/650/700 (+80% spell bonus) magic damage and stun it for 0.5 seconds; the tentacle can grab trap-like objects.",
          "cd": "10/9.2/8.4/7.6/6.8/6.0",
          "cost": "65",
          "tags": [
            "Movement",
            "Stun",
            "Dash"
          ],
          "icon": "https://game.gtimg.cn/images/yxzj/img201606/heroimg/186/18620.png"
        },
        {
          "skill_id": 18603,
          "type": "Skill 3",
          "name": "Great transformation into a living person",
          "desc": "Taiyi Zhenren summons a substitute puppet. The substitute puppet will protect Taiyi Zhenren and the nearby teammate with the lowest health for 3 seconds. If he dies under the protection of the puppet, he will be resurrected on the spot after 2 seconds, and will gain 1600/2350/3100 (+200% spell bonus) life points. This skill can be released when controlled, and 30% of the cooldown will be returned when any friend is not resurrected. The range display will be increased when used.",
          "cd": "70/65/60",
          "cost": "150",
          "tags": [
            "Revive",
            "Recovery",
            "Heal"
          ],
          "icon": "https://game.gtimg.cn/images/yxzj/img201606/heroimg/186/18630.png"
        },
        {
          "skill_id": 18604,
