      "content": {
        "skills": [
          {
            "name": "Firefly Protection",
            "description": "Basic Attacks and skills summon fireflies that deal extra damage to enemies and grant vision of them. Periodically heals teammates, or can charge up his Basic Attack to heal himself instead.",
            "type": "passive"
          },
          {
            "name": "Mulberry Power",
            "description": "Launches and damages enemies in front while summoning fireflies to heal teammates or damage enemies.",
            "type": "skill1"
          },
          {
            "name": "Ride the Wind",
            "description": "Flies to a brush while summoning fireflies that heal teammates or damage enemies.",
            "type": "skill2"
          },
          {
            "name": "Firefly Fields",
            "description": "Summons a brush and can fly into it by using this skill again. The brush summons fireflies over time that heal teammates or damage enemies.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "Your team needs a setup hero whose Ride the Wind creates kill windows for the carry",
          "Your team has the structure to use his ability to protect the marksman, set vision, and engage on cooldown windows, since Sakeer delivers utility, vision, and timely peel for the carries.",
          "The enemy draft includes Ying and Luna, who appear in counter data as matchups Sakeer can pressure."
        ],
        "avoid_when": [
          "The enemy team is loaded with cleanse, dashes, and immunity that bypass crowd control",
          "Your team needs a damage pick more than Sakeer's specialty, leaving the role unfilled if you commit here.",
          "The enemy already drafted Haya, who counter data identifies as direct answers to Sakeer."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Sakeer's mid-game tools come online.",
          "Ultimate online: Firefly Fields extends control duration, making team fights snowball off a single hit",
          "Late game: cooldowns become short enough that Ride the Wind influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Throwing Ride the Wind on the front-line tank instead of saving it for backline carries.",
          "Ignoring Haya on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Forgetting vision while looking for picks — losing the marksman because the support roamed without setting wards is a recurring mistake."
        ],
