        "pick_when": [
          "The enemy team has carries with limited self-peel that Yango can reach before the team can react",
          "Your team has the structure to use his ability to clear camps efficiently and convert pressure into ganks, since Yango delivers tempo from objectives and cross-map kill threats.",
          "The enemy composition leaves room for Yango to reach the targets his kit punishes."
        ],
        "avoid_when": [
          "The enemy stacks crowd control that interrupts the engage before damage goes out",
          "Your team needs a tank pick more than Yango's specialty, leaving the role unfilled if you commit here.",
          "The enemy team is built around answers to Initiate, removing the windows Yango's kit needs to perform."
        ],
        "power_spikes": [
          "Early game: jungle clear into level-4 ganks is the first window where Yango can translate routes into kills.",
          "Ultimate unlocked: Occult Arts - Shadow Crucifixion converts mobility into burst, the moment Yango starts threatening picks across the map",
          "Late game: cooldowns become short enough that Occult Arts - Zhi Chu Luan influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Engaging without follow-up — gap-close gets you to the target, but a solo dive without ally damage trades 1-for-1.",
          "Engaging without checking enemy summoner-spell cooldowns, which often decide whether Yango's commit reaches the target alive.",
          "Pathing predictably and getting tracked by the enemy jungler — vary first clear and rotate based on ward placement rather than muscle memory."
        ],
