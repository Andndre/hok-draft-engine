  "sources": [
    {
      "source": "HOKFIRE",
      "url": "https://www.hokfire.com/",
      "field": "abilities",
      "content": [
        {
          "type": "Passive",
          "name": "CONCEALED SABRE HAZY BLADE",
          "desc": "Every 5-4s, Ukyo Tachibana gains one enhanced Basic Attack that has increased range, restores Health, deals extra damage, and slows enemies. Dealing skill damage shortens the enhanced Basic Attack's cooldown."
        },
        {
          "type": "Skill 1",
          "name": "CONCEALED SABRE SWALLOW SWIPE",
          "desc": "Ukyo Tachibana creates a domain around himself, then leaps backward, dealing damage to enemies in his path. This skill can be used again after 2s, or immediately if it hits a target. If he returns to the starting point of phase 1 after using phase 2, phase 2 is enhanced."
        },
        {
          "type": "Skill 2",
          "name": "CONCEALED SABRE HEAVENLY HACK",
          "desc": "Slashes in the target direction, dealing damage to enemies within range. Enemies at the edge of the skill's range will be stunned."
        },
        {
          "type": "Ultimate",
          "name": "CONCEALED SABRE SNOWFALL SLASH",
          "desc": "Slashes 4 times in the target direction, dealing damage to enemies within range. Recovers Health each time damage is dealt."
        }
      ]
    },
    {
