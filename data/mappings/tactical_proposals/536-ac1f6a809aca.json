        "pick_when": [
          "The map shape favors gank routes, where mobility translates directly into kills",
          "Your team can engage first, letting Charlotte second-wave into low-health targets",
          "The enemy draft includes Fuzi and Hou Yi, who appear in counter data as matchups Charlotte can pressure."
        ],
        "avoid_when": [
          "The enemy stacks crowd control that interrupts the engage before damage goes out",
          "Your team has no primary engage, leaving the cleanup pick with nothing to follow up on",
          "The enemy already drafted Arli and Kaizer, who counter data identifies as direct answers to Charlotte."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Charlotte's mid-game tools come online.",
          "Ultimate unlocked: POWER GRADATION (Initial) converts mobility into burst, the moment Charlotte starts threatening picks across the map",
          "Late game: cooldowns become short enough that SPLASH FOUNT (Initial) influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Engaging without follow-up — gap-close gets you to the target, but a solo dive without ally damage trades 1-for-1.",
          "Engaging first instead of second — cleanup picks lose their value as primary engagers.",
          "Ignoring Arli and Kaizer on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Forcing solo engages instead of waiting for ally commit — Charlotte's value compounds when the team follows up on engages."
        ],
