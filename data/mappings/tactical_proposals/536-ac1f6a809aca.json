      "field": "abilities",
      "content": [
        {
          "type": "Passive",
          "name": "SPLASH GRADATION",
          "desc": "After any skill hits an enemy, her next different skill used will be enhanced to a follow-up skill. Additionally, gains 1 stack of mark, for up to 5 stacks. Consuming 3 stacks will enhance her next Basic Attack."
        },
        {
          "type": "Skill 1",
          "name": "TRI-SLASH (Initial)",
          "desc": "'''Initial Skill:''' After a short delay, releases TRI-SLASH in the target direction, dealing damage to enemies and increasing her Movement Speed."
        },
        {
          "type": "Skill 2",
          "name": "SPLASH FOUNT (Initial)",
          "desc": "'''Initial Skill:''' Dashes in the target direction, while striking several times. Recovers Health each time damage is dealt."
        },
        {
          "type": "Ultimate",
          "name": "POWER GRADATION (Initial)",
          "desc": "'''Initial Skill:''' Carves a seven-pointed star around her, dealing damage and slowing nearby enemies. Gains crowd control immunity and damage reduction while the skill is active."
        }
      ]
    },
