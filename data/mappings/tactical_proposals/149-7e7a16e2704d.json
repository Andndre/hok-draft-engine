            "type": "skill1"
          },
          {
            "name": "Staggering Charge",
            "description": "Charges up and dashes forward, damaging and stunning enemies in his path.",
            "type": "skill2"
          },
          {
            "name": "Battlefield Command",
            "description": "Provides a shield to a teammate. After a short delay, teleports to the teammate and gains Movement Speed.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "Your team needs a primary front-line who can engage on cooldown windows",
          "Your team has the structure to use his ability to protect the marksman, set vision, and engage on cooldown windows, since Liu Bang delivers utility, vision, and timely peel for the carries.",
          "The enemy draft includes Marco Polo, Meng Ya, and Shouyue, who appear in counter data as matchups Liu Bang can pressure."
        ],
        "avoid_when": [
          "The enemy stacks anti-tank items like armor penetration and percent-HP damage, melting front-liners quickly",
          "Your team needs a damage pick more than Liu Bang's specialty, leaving the role unfilled if you commit here.",
          "A stronger pick in the same role is open and the matchup does not specifically reward Liu Bang's tank utility."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Liu Bang's mid-game tools come online.",
          "Core durability online: defensive items like Frosthold Targe let Liu Bang stay in fights longer instead of getting blown up",
          "Late game: Glacial Buckler, Protector's Cuirass, and Blazing Cape on the bar means Liu Bang can soak commits in 5v5 team fights for his carries."
        ],
        "common_mistakes": [
          "Building damage items hoping to deal kills, when the team needs the durability that makes you a tank in the first place.",
          "Engaging without checking enemy summoner-spell cooldowns, which often decide whether Liu Bang's commit reaches the target alive.",
          "Rotating without checking allied and enemy positions, leaving a lane or carry exposed before Battlefield Command can create value."
        ],
