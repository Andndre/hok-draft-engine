        "pick_when": [
          "Your team needs a setup hero whose Cannon Blast creates kill windows for the carry",
          "Your team has a hyper-carry who needs his backline protection to reach scaling",
          "The enemy draft includes Cirrus, Lam, and Li Bai, who appear in counter data as matchups Mozi can pressure."
        ],
        "avoid_when": [
          "The enemy team is loaded with cleanse, dashes, and immunity that bypass crowd control",
          "Your team needs proactive engage rather than a reactive shield-and-peel kit",
          "The enemy already drafted Dolia, Guiguzi, and Nezha, who counter data identifies as direct answers to Mozi."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Mozi's mid-game tools come online.",
          "Ultimate online: Think Inside the Box extends control duration, making team fights snowball off a single hit",
          "Late game: full build online, Mozi reaches the spike public guides describe — extended fights favor him once items are completed."
        ],
        "common_mistakes": [
          "Throwing Cannon Blast on the front-line tank instead of saving it for backline carries.",
          "Pre-shielding before the engage actually starts, wasting the absorb window before damage lands.",
          "Ignoring Dolia and Guiguzi on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Greeding farm in mid lane while side lanes get camped — rotation timing matters more than CS lead in most matchups."
