      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Malicious Practice",
            "description": "Skill and Basic Attack hits place up to 5 marks on enemies, each stack dealing damage over time. His Skill 2 and Ultimate place up to 5 marks on himself and his teammates, each stack continually restoring Health over time.",
            "type": "passive"
          },
          {
            "name": "Deadly Panacea",
            "description": "Throws a vial of deadly poison at the target location, dealing damage over time and slowing enemies within range. Can store up to 3 vials of poison.",
            "type": "skill1"
          },
          {
            "name": "Fatal Diagnosis",
            "description": "Throws a concoction in the target direction, dealing damage and marking enemies in its path. Heals himself and teammates in its path, while also applying marks.",
            "type": "skill2"
          },
          {
            "name": "Master of Life",
            "description": "Damages enemies within range and heals teammates. Every mark detonated will increase damage and healing. He recovers extra Health.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "The team draft favors extended team fights where healing scales",
          "Your team has the structure to use his ability to farm safely and rotate to side lanes when the wave allows, since Dr Bian delivers consistent damage output and timely roams.",
          "The enemy draft includes Mai Shiranui and Diaochan, who appear in counter data as matchups Dr Bian can pressure."
        ],
        "avoid_when": [
          "The enemy already builds anti-heal items, neutralizing your sustain plan",
          "Your team needs a jungle pick more than Dr Bian's specialty, leaving the role unfilled if you commit here.",
          "The enemy already drafted Yang Jian, who counter data identifies as direct answers to Dr Bian."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Dr Bian's mid-game tools come online.",
          "Lifesteal item online: trade patterns flip from neutral to favorable once sustain stacks with damage",
          "Late game: full build online, Dr Bian reaches the spike public guides describe — extended fights favor him once items are completed."
        ],
        "common_mistakes": [
          "Forcing all-ins against opponents already wearing anti-heal — your healing barely activates.",
          "Ignoring Yang Jian on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Greeding farm in mid lane while side lanes get camped — rotation timing matters more than CS lead in most matchups."
        ],
