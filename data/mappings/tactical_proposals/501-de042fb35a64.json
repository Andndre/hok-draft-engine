      "field": "abilities",
      "content": [
        {
          "type": "Passive",
          "name": "Good Omens",
          "desc": "Every 5s, Ming's next Basic Attack deals more magical damage and heals himself and the linked teammate. The healing is reduced if the enemy is nota hero."
        },
        {
          "type": "Skill 1",
          "name": "Time - Carefree",
          "desc": "Forms a link with the target. When linked to an ally, increases the Physical and Magical Attack Movement Speed, and Attack Speed of both parties. When linked to an enemy unit, reduces their Physical and Magical Attack while dealing damage over time."
        },
        {
          "type": "Skill 2",
          "name": "Mastery - Glide",
          "desc": "Switches the effect of the link. When linked to an ally, increases the Physical and Magical Defense of both parties. When linked to an enemy unit, reduces their Physical and Magical Defense. The effect can beswitched repeatedly."
        },
        {
          "type": "Ultimate",
          "name": "Peace - Longevity",
          "desc": "While linked, can spend own Health to restore an equal amount of Health toallies or deal an equal amount of damage to enemies. Recovers Health continuously while out of combat."
        }
      ]
    },
