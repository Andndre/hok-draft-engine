      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Good Omens",
            "description": "Every 5s, Ming's next Basic Attack deals magical damage and heals himself and the linked teammate. The healing is reduced if the enemy is not a hero.",
            "type": "passive"
          },
          {
            "name": "Time - Carefree",
            "description": "Throws his instrument and links it to a teammate, increasing their main attack stat and Attack Speed. Enemies who touch the link take damage over time. Passive: Increases Ming's Physical Attack, Magical Attack, and Movement Speed.",
            "type": "skill1"
          },
          {
            "name": "Mastery - Glide",
            "description": "Throws his instrument and links it to an enemy, reducing their Physical and Magical Defense. Enemies who touch the link take damage over time. Passive: Gains Physical and Magical Defense.",
            "type": "skill2"
          },
          {
            "name": "Peace - Longevity",
            "description": "Ming channels for a short time before sacrificing Health to deal true damage to the linked enemy or heal the linked teammate. If linked to both, he does not lose Health.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "The enemy team has burst threats that need to be absorbed by reliable shields",
          "Your team has the structure to use his ability to protect the marksman, set vision, and engage on cooldown windows, since Ming delivers utility, vision, and timely peel for the carries.",
          "The enemy draft includes Cirrus, Menki, and Wuyan, who appear in counter data as matchups Ming can pressure."
        ],
        "avoid_when": [
          "The enemy plays sustained damage rather than burst, which shields cannot absorb in single windows",
          "Your team needs a damage pick more than Ming's specialty, leaving the role unfilled if you commit here.",
          "A stronger pick in the same role is open and the matchup does not specifically reward Ming's Team Buffs."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Ming's mid-game tools come online.",
          "Defensive item online: shield strength scales with magic power or HP, so Ming's value grows after the first item spike",
          "Late game: cooldowns become short enough that Mastery - Glide influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Pre-shielding before the engage actually starts, wasting the absorb window before damage lands.",
          "Engaging without checking enemy summoner-spell cooldowns, which often decide whether Ming's commit reaches the target alive.",
          "Forgetting vision while looking for picks — losing the marksman because the support roamed without setting wards is a recurring mistake."
        ],
