        "pick_when": [
          "The enemy team has multiple high-mobility threats that need to be locked down before they reach your backline",
          "Your draft can capitalize on early picks and snowball lane leads",
          "The enemy draft includes Kongming, Lady Zhen, and Liang, who appear in counter data as matchups Wuyan can pressure."
        ],
        "avoid_when": [
          "Your team lacks the follow-up damage to convert your control windows into kills",
          "Enemy peel is strong and Wuyan cannot reach the backline without dying first",
          "The enemy already drafted Lam, Ming, and Pei, who counter data identifies as direct answers to Wuyan."
        ],
        "power_spikes": [
          "Early game: Wuyan is listed as an early-game threat in public guide data — convert the early window into objectives before scaling picks come online.",
          "Ultimate online: Hurricane Hammer extends control duration, making team fights snowball off a single hit",
          "Late game: Boots of Fortitude, Longnight Guardian, and Boots of Resistance on the bar means Wuyan can soak commits in 5v5 team fights for her carries."
        ],
        "common_mistakes": [
          "Throwing Shock and Awe on the front-line tank instead of saving it for backline carries.",
          "Diving while enemy hard control is still up, which directly counters Wuyan's engage.",
          "Ignoring Lam and Ming on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Forcing solo engages instead of waiting for ally commit — Wuyan's value compounds when the team follows up on engages."
        ],
