        "skills": [
          {
            "name": "Falling Leaves",
            "description": "Basic Attack hits place marks on the target. At max marks, damage is dealt to them. Using skills grants a follow-up Basic Attack. Gains Movement Speed and Attack Speed while parasol is away.",
            "type": "passive"
          },
          {
            "name": "Lithe Step",
            "description": "Shifts in the target direction.",
