  "sources": [
    {
      "source": "HOKFIRE",
      "url": "https://www.hokfire.com/",
      "field": "abilities",
      "content": [
        {
          "type": "Passive",
          "name": "Eternal",
          "desc": "While his Dark Orb is deployed, landing Skill 2 or his Ultimate on an enemy makes the Orb pulse, dealing extra magic damage to foes around it."
        },
        {
          "type": "Skill 1",
          "name": "Here's What I Think",
          "desc": "Fires his Dark Orb forward, damaging enemies in its path and leaving it in place. Recast to send it onward, where it bursts at the second point for damage and a slow."
        },
        {
          "type": "Skill 2",
          "name": "Abyssal Pact",
          "desc": "Releases a wave of dark energy around him for area damage, holding up to two charges. If his Dark Orb is out, he blinks to it first, then unleashes the wave."
        },
        {
          "type": "Ultimate",
          "name": "Starry Night",
          "desc": "Launches a projectile that detonates after a short delay, dealing heavy magic damage and knocking enemies up. Casting it grants a Skill 1 charge, and missing every hero refunds half its cooldown."
        }
      ]
    },
