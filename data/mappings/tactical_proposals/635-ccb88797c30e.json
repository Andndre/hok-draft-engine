      "content": {
        "skills": [
          {
            "name": "Eternal",
            "description": "Skill 2 or Ultimate hits also damage units near the target.",
            "type": "passive"
          },
          {
            "name": "Here's What I Think",
            "description": "Lorion moves his orb around to damage units in its path.",
            "type": "active"
          },
          {
            "name": "Abyssal Pact",
            "description": "Retrieves the projectile.",
            "type": "active"
          },
          {
            "name": "Starry Night",
            "description": "After a short delay, the orb damages and levitates nearby enemies.",
            "type": "active"
          },
          {
            "name": "Darkness Falls",
            "description": "Flies toward the projectile.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "Pick Lorion when your team needs a Mid Mage with area damage and crowd control for clustered objective fights."
        ],
        "avoid_when": [
          "Avoid Lorion when the enemy has fast divers who can reach him while his orb and movement options are out of position."
        ],
        "power_spikes": [
          "Lorion's strongest teamfight window begins when Starry Night is available and the orb is already positioned where enemies must contest an objective."
        ],
        "common_mistakes": [
          "Do not move the orb without planning Lorion's next position; poor orb placement lowers his damage and can make his movement skills unsafe."
        ],
