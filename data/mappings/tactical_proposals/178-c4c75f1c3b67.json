  "sources": [
    {
      "source": "HOKFIRE",
      "url": "https://www.hokfire.com/",
      "field": "abilities",
      "content": [
        {
          "type": "Passive",
          "name": "Mind Games",
          "desc": "Yang Jian's Resistance increases for each nearby enemy hero."
        },
        {
          "type": "Skill 1",
          "name": "Unleash the Hound",
          "desc": "Yang Jian commands a Heaven Hound to dash in the target direction, marking and dealing damage to the first enemy hit. Upon using again, Yang Jian dashes to the marked enemy and deals damage to them."
        },
        {
          "type": "Skill 2",
          "name": "Vain Disillusionment",
          "desc": "Yang Jian deals damage to enemies in front of him and stuns them while reducing their Movement Speed. if an enemy is hit, his Basic Attack is enhanced to deal extra damage."
        },
        {
          "type": "Ultimate",
          "name": "Sight of Origin",
          "desc": "Yang Jian unleashes a beam of light in the target direction, dealing damage and recovering Health."
        }
      ]
    },
    {
      "source": "HOKFIRE",
      "url": "https://www.hokfire.com/",
      "field": "guide",
      "content": {
        "pros": [
          "Strong duelist with good sustained damage",
          "Healthy mix of damage and durability",
          "Can split-push and skirmish across the map"
        ],
        "cons": [
          "Vulnerable before key items come online",
          "Struggles into heavy ranged poke",
          "Can be peeled and kited by control"
        ],
        "gameplay_tips": "Yang Jian is a Fighter who plays the Clash Lane. Your aim is to trade in your lane, then bully your way onto the enemy backline. Pick your moment to use Sight of Origin, then follow up with Unleash the Hound and Vain Disillusionment. Manage the wave, respect ganks, and look to roam once you have a lead."
      }
    },
    {
      "source": "Kurohiko",
      "url": "https://hok.kurohiko.id/",
      "field": "tactical_tips",
      "content": "1) Hindarin skill 1 dan 3 Yang Jian pakai gerakan lincah. 2) Kalau kena skill 1-nya, jangan langsung dash. Tunggu dia pakai tahap kedua, baru dash menjauh. 3) Pas teamfight jangan pakai control kunci ke dia."
    },
    {
      "source": "HoKStats",
      "url": "https://hokstats.gg/heroes/yang-jian/",
      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Mind Games",
            "description": "Yang Jian's Basic Attack and skills can stack Resistance. After attaining max stacks, he gains crowd control immunity. If Yang Jian enters battle with a hero, he will enter the Heaven-Earth Form.",
            "type": "passive"
          },
          {
            "name": "Unleash the Hound",
            "description": "Commands Heaven Hound to pounce in the target direction, marking the first enemy hit and damaging them. Upon using the skill again, he charges to the target and deals damage.",
            "type": "skill1"
          },
          {
            "name": "Vain Disillusionment",
            "description": "Deals damage to enemies in front, stunning and slowing them. If he hits an enemy, he gains an enhanced Basic Attack that deals extra damage.",
            "type": "skill2"
          },
          {
            "name": "Sight of Origin",
            "description": "Unleashes beams of light that deal damage and restore his Health.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "The enemy team has carries with limited self-peel that Yang Jian can reach before the team can react",
          "Your team can engage first, letting Yang Jian second-wave into low-health targets",
          "The enemy draft includes Diaochan, Luna, and Dr Bian, who appear in counter data as matchups Yang Jian can pressure."
        ],
        "avoid_when": [
          "The team needs sustained team-fight damage rather than a single-target diver",
          "Your team has no primary engage, leaving the cleanup pick with nothing to follow up on",
          "A stronger pick in the same role is open and the matchup does not specifically reward Yang Jian's Gap-Close."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Yang Jian's mid-game tools come online.",
          "Ultimate unlocked: Sight of Origin converts mobility into burst, the moment Yang Jian starts threatening picks across the map",
          "Late game: cooldowns become short enough that Vain Disillusionment influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Engaging without follow-up — gap-close gets you to the target, but a solo dive without ally damage trades 1-for-1.",
          "Engaging first instead of second — cleanup picks lose their value as primary engagers.",
          "Engaging without checking enemy summoner-spell cooldowns, which often decide whether Yang Jian's commit reaches the target alive.",
          "Forcing solo engages instead of waiting for ally commit — Yang Jian's value compounds when the team follows up on engages."
        ],
