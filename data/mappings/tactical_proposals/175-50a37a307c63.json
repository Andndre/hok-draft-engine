      "field": "abilities",
      "content": [
        {
          "type": "Passive",
          "name": "Ethereal Outburst",
          "desc": "Deals area damage upon taking heavy damage in a single hit or after dying."
        },
        {
          "type": "Skill 1",
          "name": "Mortals!",
          "desc": "Inflicts damage and slow on enemies in the target area."
        },
        {
          "type": "Skill 2",
          "name": "Join Me",
          "desc": "Throws his chain hook in the target direction, damaging the enemy and pulling them to him. Upon learning this skill, gains a passive effect that increases his Health on defeats and assists."
        },
        {
          "type": "Ultimate",
          "name": "Into the Void",
          "desc": "Deals damage multiple times and slows enemies within range. For heroes marked by Skill 2, the slow effect is upgraded to a stun."
        }
      ]
    },
