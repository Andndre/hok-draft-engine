    {
      "source": "Kurohiko",
      "url": "https://hok.kurohiko.id/",
      "field": "tactical_tips",
      "content": "1) Ngumpet di belakang minion atau tank biar gak kena hook Kui. 2) Kalau kena, langsung dash buat kabur. 3) Waspadain Kui yang HP-nya rendah, bisa aja dia nerjang jadi bom bunuh diri."
    },
    {
      "source": "HoKStats",
      "url": "https://hokstats.gg/heroes/kui/",
      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Ethereal Outburst",
            "description": "Deals area damage upon taking heavy damage in a single hit or after dying.",
            "type": "passive"
          },
          {
            "name": "Mortals!",
            "description": "Damages and slows nearby enemies. Marks enemies in the inner circle while dealing extra damage and slowing enemies.",
            "type": "skill1"
          },
          {
            "name": "Join Me",
            "description": "Throws a chain hook in the target direction that pulls the target back, dealing damage and marking them. Passive: Defeats and assists permanently boost Health.",
            "type": "skill2"
          },
          {
            "name": "Into the Void",
            "description": "Deals damage multiple times and slows enemies within range. Against marked heroes, the slow effect is upgraded to a stun.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "Your team needs a setup hero whose Join Me creates kill windows for the carry",
          "Your team has the structure to use his ability to protect the marksman, set vision, and engage on cooldown windows, since Kui delivers utility, vision, and timely peel for the carries.",
          "The enemy draft includes Kaizer and Xiang Yu, who appear in counter data as matchups Kui can pressure."
        ],
        "avoid_when": [
          "The enemy team is loaded with cleanse, dashes, and immunity that bypass crowd control",
          "Your team needs a damage pick more than Kui's specialty, leaving the role unfilled if you commit here.",
          "The enemy team is built around answers to Crowd Control, removing the windows Kui's kit needs to perform."
        ],
        "power_spikes": [
          "Early game: Kui is listed as an early-game threat in public guide data — convert the early window into objectives before scaling picks come online.",
          "Ultimate online: Into the Void extends control duration, making team fights snowball off a single hit",
          "Late game: cooldowns become short enough that Join Me influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Throwing Join Me on the front-line tank instead of saving it for backline carries.",
          "Engaging without checking enemy summoner-spell cooldowns, which often decide whether Kui's commit reaches the target alive.",
          "Forgetting vision while looking for picks — losing the marksman because the support roamed without setting wards is a recurring mistake."
        ],
