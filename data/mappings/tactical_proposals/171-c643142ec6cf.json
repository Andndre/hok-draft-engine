          }
        ],
        "pick_when": [
          "Your team needs a setup hero whose Leaping Savior creates kill windows for the carry",
          "The enemy team has high physical or magic burst that demands a dedicated tank to absorb",
          "The enemy draft includes Arli, Consort Yu, and Marco Polo, who appear in counter data as matchups Zhang Fei can pressure."
        ],
        "avoid_when": [
          "The enemy team is loaded with cleanse, dashes, and immunity that bypass crowd control",
          "Your team comp lacks damage and adding another non-damage pick collapses the win condition",
          "A stronger pick in the same role is open and the matchup does not specifically reward Zhang Fei's Crowd Control."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Zhang Fei's mid-game tools come online.",
          "Ultimate online: Unbridled Outburst extends control duration, making team fights snowball off a single hit",
          "Late game: Guardian - Radiance, Ominous Premonition, and Succubus Cloak on the bar means Zhang Fei can soak commits in 5v5 team fights for his carries."
        ],
        "common_mistakes": [
          "Throwing Leaping Savior on the front-line tank instead of saving it for backline carries.",
          "Building damage items hoping to deal kills, when the team needs the durability that makes you a tank in the first place.",
          "Engaging without checking enemy summoner-spell cooldowns, which often decide whether Zhang Fei's commit reaches the target alive.",
          "Forgetting vision while looking for picks — losing the marksman because the support roamed without setting wards is a recurring mistake."
        ],
