        {
          "skill_id": 14402,
          "type": "Skill 2",
          "name": "slalom",
          "desc": "Cheng Yaojin spins his double ax to chop the enemy, causing two sections of damage to enemies within the range. Each section causes 125/150/175/200/225/250 (+60% physical bonus) points of physical damage.",
          "cd": "5",
          "cost": "0",
