          "skill_id": 14400,
          "type": "Passive",
          "name": "Give up one's life",
          "desc": "Passive: Cheng Yaojin gains an additional 3 to 7 points of physical attack power for every 1% of his Max HP lost. The increase increases with the hero's level. Cheng Yaojin's normal skills will consume 10% of his current Max HP, and his ultimate skill will consume 16% of his current health. Each time he releases a skill, he will also recover 8% of his lost health. The recovery process lasts 3 seconds.",
          "cd": "0",
          "cost": "0",
          "tags": [
            "Enhance",
            "Attack Up"
          ],
          "icon": "https://game.gtimg.cn/images/yxzj/img201606/heroimg/144/14400.png"
        },
        {
          "skill_id": 14401,
          "type": "Skill 1",
          "name": "Explosive double ax",
          "desc": "Cheng Yaojin leaps towards the designated target position and swings his double ax to slash, causing 120/155/190/225/260/295 (+50% physical bonus) points of physical damage to enemies within the range and causing a 50% deceleration effect, lasting 2 seconds; Passive: Cheng Yaojin's normal attack hits the enemy hero, which will reduce the cooldown of the explosive double ax by 1 second.",
          "cd": "15/14.4/13.8/13.2/12.6/12",
          "cost": "0",
          "tags": [
            "Movement",
            "Slow",
            "Jump"
          ],
          "icon": "https://game.gtimg.cn/images/yxzj/img201606/heroimg/144/14410.png"
