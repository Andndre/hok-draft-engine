    {
      "source": "HOKFIRE",
      "url": "https://www.hokfire.com/",
      "field": "abilities",
      "content": [
        {
          "skill_id": 58300,
          "type": "Passive",
          "name": "Flow of the World",
          "desc": "Can use Flow at the Base to enhance stats.\nSpends Flow to perform an enhanced Basic Attack that deals <color=#db70d0>damage</color>.",
          "cd": 1000,
          "cost": 0,
          "tags": [],
          "icon": "https://camp.honorofkings.com/Global/Common/UGUI/SystemRes/902_HeroSkillIcon/58100.png"
        },
        {
          "skill_id": 58310,
          "type": "Skill 1",
          "name": "Convergence",
          "desc": "Channels the Flow, dealing <color=#fa863a>damage</color> to nearby enemies and <color=#50c1eb>knocking them back</color>. Also <color=#6fc075>recovers Health</color>, gains 5 stacks of Flow, and reduces the cooldown of other skills.\n<color=#4f6f95>Nearby teammates and minions provide extra recovery and Flow.</color>",
          "cd": 12500,
          "cost": 30,
          "tags": [],
          "icon": "https://camp.honorofkings.com/Global/Common/UGUI/SystemRes/902_HeroSkillIcon/58110.png"
        },
        {
          "skill_id": 58320,
          "type": "Skill 2",
          "name": "Claw Flurry",
          "desc": "Dashes in the target direction to deal <color=#fa863a>damage</color>, then repeatedly phases through enemies\nto deal <color=#fa863a>damage</color> and <color=#6fc075>recover Health</color>.\n<color=#4f6f95>Can spend 4 stacks of Flow to use an extra Claw Flurry.</color>",
          "cd": 7500,
          "cost": 30,
          "tags": [],
          "icon": "https://camp.honorofkings.com/Global/Common/UGUI/SystemRes/902_HeroSkillIcon/58320.png"
        },
        {
          "skill_id": 58330,
          "type": "Skill 3",
          "name": "Mortal Talons",
          "desc": "Dashes to the target location and gains <color=#ffce49>crowd control immunity</color>, dealing <color=#fa863a>damage</color> to enemies in their path. At the destination, deals extra <color=#fa863a>damage</color> and <color=#50c1eb>knocks back</color> enemies.\n<color=#4f6f95>Can spend 5 stacks of Flow to use an extra Mortal Talons.</color>",
          "cd": 25000,
          "cost": 75,
          "tags": [],
          "icon": "https://camp.honorofkings.com/Global/Common/UGUI/SystemRes/902_HeroSkillIcon/58330.png"
        }
      ]
    },
