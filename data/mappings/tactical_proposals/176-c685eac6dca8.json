        "pick_when": [
          "The enemy lacks reliable healing reduction, leaving sustain unchecked",
          "Your team has the structure to use her ability to farm safely and rotate to side lanes when the wave allows, since Yuhuan delivers consistent damage output and timely roams.",
          "The enemy draft includes Mai Shiranui, Nakoruru, and Wukong, who appear in counter data as matchups Yuhuan can pressure."
        ],
        "avoid_when": [
          "The game state demands burst rather than slow attrition",
          "Your team needs a jungle pick more than Yuhuan's specialty, leaving the role unfilled if you commit here.",
          "The enemy already drafted Luna and Ying, who counter data identifies as direct answers to Yuhuan."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Yuhuan's mid-game tools come online.",
          "Lifesteal item online: trade patterns flip from neutral to favorable once sustain stacks with damage",
          "Late game: full build online, Yuhuan reaches the spike public guides describe — extended fights favor her once items are completed."
        ],
        "common_mistakes": [
          "Forcing all-ins against opponents already wearing anti-heal — your healing barely activates.",
          "Ignoring Luna and Ying on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Greeding farm in mid lane while side lanes get camped — rotation timing matters more than CS lead in most matchups."
        ],
