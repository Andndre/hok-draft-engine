  "sources": [
    {
      "source": "HOKFIRE",
      "url": "https://www.hokfire.com/",
      "field": "abilities",
      "content": [
        {
          "type": "Passive",
          "name": "Flame Incantation",
          "desc": "Every time she damages an enemy with a skill, she increases her Movement Speed, and the enemy will take more damage from her subsequent skills."
        },
        {
          "type": "Skill 1",
          "name": "Scorching Barrage",
          "desc": "Unleashes fireballs at the target area that deals multi-phase damage toenemy heroes."
        },
        {
          "type": "Skill 2",
          "name": "Chaos Cinder",
          "desc": "Hurls a fireball at the target location that turns into a firestorm when it hitsan enemy or reaches its max range, slowing and dealing damage to nearbyenemies.Any enemy that is hit directly by the fireball is stunned."
        },
        {
          "type": "Ultimate",
          "name": "Blazing Brilliance",
          "desc": "Channels a blazing beam in the target direction, dealing damage over timeGains a shield and immunity while the shield is active."
        }
      ]
    },
    {
      "source": "HOKFIRE",
      "url": "https://www.hokfire.com/",
      "field": "guide",
      "content": {
        "pros": [
          "High burst damage combo",
          "Reliable crowd control",
          "Strong wave clear"
        ],
        "cons": [
          "Very immobile",
          "Skill-shot dependent",
          "Vulnerable to dives"
        ],
        "gameplay_tips": "## Early Game\nAngela has one of the fastest level 1 wave clears in the game. Be sure to hit Skill 1 on the entire minion wave twice; then you can look to roam with Skill 2 to take jungle camps and catch enemies off guard.\n\n## Teamfight\nIn teamfights, be patient with your combo. Look for high-value targets that you can hit with your skills, but be sure to stand behind your frontline so you don't get caught. Always try to fight around vision and use bushes to surprise enemies with your combo.\n\n## Tips & Tricks\nOne-shot combo Skill 2 > Skill 1 > Ultimate\nHide in bushes and use Angela combo before enemies see you\nAlways manually aim Angela's skills for a better hit rate\nWhen you are about to get hit by crowd control, use your Ultimate for immunity."
      }
    },
    {
      "source": "Kurohiko",
      "url": "https://hok.kurohiko.id/",
      "field": "tactical_tips",
      "content": "Deketin Angela pakai jalur zig-zag (S) dan jangan kabur lurus. Semua skill-nya butuh prediksi arah, jadi gerak muter-muter sering bisa ngindarin. Hero melee terus pindah posisi pas nempel."
    },
    {
      "source": "HoKStats",
      "url": "https://hokstats.gg/heroes/angela/",
      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Flame Incantation",
            "description": "Hitting enemies with skills increases Movement Speed and damage.",
            "type": "passive"
          },
          {
            "name": "Scorching Barrage",
            "description": "Unleashes multiple fireballs, dealing multi-phase damage.",
            "type": "skill1"
          },
          {
            "name": "Chaos Cinder",
            "description": "Fires a large fireball in the target direction, dealing damage and inflicting stun and slow.",
            "type": "skill2"
          },
          {
            "name": "Blazing Brilliance",
            "description": "Channels a blazing beam in the target direction, dealing damage over time. Also gains a shield and crowd control immunity.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "Your team lacks reliable burst on isolated picks and needs single-target finishing damage",
          "The enemy team has burst threats that need to be absorbed by reliable shields",
          "The enemy draft includes Luban No.7 and Hou Yi, who appear in counter data as matchups Angela can pressure."
        ],
        "avoid_when": [
          "The enemy already invested in magic resist and shields that absorb committed burst windows",
          "The enemy plays sustained damage rather than burst, which shields cannot absorb in single windows",
          "The enemy already drafted Han Xin and Gao Changgong, who counter data identifies as direct answers to Angela."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Angela's mid-game tools come online.",
          "Ultimate unlocked: Blazing Brilliance is the threshold where Angela starts deleting low-resist targets in one rotation",
          "Late game: cooldowns become short enough that Chaos Cinder influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Opening fights when the enemy still has full crowd control, getting deleted before damage lands.",
          "Pre-shielding before the engage actually starts, wasting the absorb window before damage lands.",
          "Ignoring Han Xin and Gao Changgong on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Greeding farm in mid lane while side lanes get camped — rotation timing matters more than CS lead in most matchups."
        ],
