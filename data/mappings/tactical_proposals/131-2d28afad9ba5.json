    {
      "source": "HOKFIRE",
      "url": "https://www.hokfire.com/",
      "field": "abilities",
      "content": [
        {
          "type": "Passive",
          "name": "Way of the Sword",
          "desc": "Basic Attack hits grant stacks. At 4 stacks, increases Physical Attack and unlocks the Ultimate."
        },
        {
          "type": "Skill 1",
          "name": "Stupor Slash",
          "desc": "Dashes and leaves an after image at the start point while stunning and damaging enemies in his path.Can dash again before cooldown starts, and a third time to return to the after image."
        },
        {
          "type": "Skill 2",
          "name": "Stroke of Genius",
          "desc": "Removes crowd control effects from self and becomes untargetable. Damages enemies in range, leaving behind a sword formation. Enemies that touch the edge of the formation are damaged, slowed, andsundered."
        },
        {
          "type": "Ultimate",
          "name": "Flickering Flurry",
          "desc": "Transforms into a phantom, continuously slashing at the specified area. Li Bai is untargetable while the skill is active, and all debuffs are removed Deals AoE damage, but damage is diminished upon hitting multiple enemy heroes."
        }
      ]
    },
