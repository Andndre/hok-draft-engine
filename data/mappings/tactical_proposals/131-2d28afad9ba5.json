      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Way of the Sword",
            "description": "Basic Attack hits grant stacks. At 4 stacks, increases Physical Attack and unlocks the Ultimate.",
            "type": "passive"
          },
          {
            "name": "Stupor Slash",
            "description": "Dashes and leaves an afterimage at the start point while stunning and damaging enemies in his path. Can dash again before cooldown starts, and a third time to return to the afterimage.",
            "type": "skill1"
          },
          {
            "name": "Stroke of Genius",
            "description": "Removes all debuffs from self and becomes untargetable. Damages enemies in range, leaving behind a sword formation. Enemies that touch the edge of the formation are damaged, slowed, and sundered.",
            "type": "skill2"
          },
          {
            "name": "Flickering Flurry",
            "description": "Transforms into a phantom, continuously slashing at the specified area. Removes all debuffs and becomes untargetable while the skill is active. Deals area damage, but damage is diminished upon hitting multiple enemy heroes.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "The enemy team has carries with limited self-peel that Li Bai can reach before the team can react",
          "Your team can engage first, letting Li Bai second-wave into low-health targets",
          "The enemy draft includes Dun, Lian Po, and Liu Shan, who appear in counter data as matchups Li Bai can pressure."
        ],
        "avoid_when": [
          "Enemy peel is strong and Li Bai cannot reach the backline without dying first",
          "Your team has no primary engage, leaving the cleanup pick with nothing to follow up on",
          "The enemy already drafted Garo, Mozi, and Shi, who counter data identifies as direct answers to Li Bai."
        ],
        "power_spikes": [
          "Early game: jungle clear into level-4 ganks is the first window where Li Bai can translate routes into kills.",
          "Ultimate unlocked: Flickering Flurry converts mobility into burst, the moment Li Bai starts threatening picks across the map",
          "Late game: full build online, Li Bai reaches the spike public guides describe — extended fights favor him once items are completed."
        ],
        "common_mistakes": [
          "Engaging without follow-up — gap-close gets you to the target, but a solo dive without ally damage trades 1-for-1.",
          "Engaging first instead of second — cleanup picks lose their value as primary engagers.",
          "Ignoring Garo and Mozi on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Pathing predictably and getting tracked by the enemy jungler — vary first clear and rotate based on ward placement rather than muscle memory."
        ],
