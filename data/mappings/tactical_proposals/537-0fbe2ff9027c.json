          },
          {
            "name": "Millennium Echo",
            "description": "Gains crowd control immunity and a Movement Speed boost. Upon landing, enhances Basic Attack. Basic Attacks grant Energy.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "Pick Devara when the team needs a durable Clash Lane Fighter who can engage, shield himself, and stay active in extended fights."
        ],
        "avoid_when": [
          "Avoid Devara when the enemy can repeatedly disengage before he builds Energy or when your draft already has enough short-range frontline heroes."
        ],
        "power_spikes": [
          "Devara becomes strongest after reaching high Energy and activating Millennium Echo, which grants crowd control immunity, Movement Speed, and an enhanced Basic Attack."
        ],
        "common_mistakes": [
          "Do not enter a fight with no Energy and use every skill immediately; prepare charge first so the enhanced skill cycle is available during the engagement."
        ],
