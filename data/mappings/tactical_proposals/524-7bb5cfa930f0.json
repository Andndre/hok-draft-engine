      "url": "https://www.hokfire.com/",
      "field": "abilities",
      "content": [
        {
          "type": "Passive",
          "name": "Fiery Temper",
          "desc": "Cooldown is reduced when Attack Speed is increased. Gains Anger when Basic Attack and Skill 1 hit targets. At max Anger, becomes Excited, enhancing all skills. While Excited, surplus Anger restores Health."
        },
        {
          "type": "Skill 1",
          "name": "Awesome Barrage",
          "desc": "Uses the Apocalyptor to strafe continuously and deal damage. '''Excited:''' Bullets have a piercing effect, dealing half damage to subsequent enemies."
        },
        {
          "type": "Skill 2",
          "name": "Heavy Shot",
          "desc": "Shoots a heavy round in the target direction, inflicting damage and slow. Upon hitting an obstacle or reaching its max range, it will split into splinters that deal damage. '''Excited:''' Increases the number of splinters."
        },
        {
          "type": "Ultimate",
          "name": "Missile Mayhem",
          "desc": "Scans the vicinity and fires missiles at enemies within range who are attacked by teammates, dealing damage. '''Excited:''' Reduces interval between missiles."
        }
      ]
    },
