        "pick_when": [
          "Your team needs a damage threat that can finish a fight when Heartbreaker comes back up",
          "Your team has the structure to use her ability to farm safely and rotate to side lanes when the wave allows, since Daji delivers consistent damage output and timely roams.",
          "The enemy draft includes Luna and Diaochan, who appear in counter data as matchups Daji can pressure."
        ],
        "avoid_when": [
          "You need sustained damage rather than one-shot windows tied to Heartbreaker's cooldown",
          "Your team needs a jungle pick more than Daji's specialty, leaving the role unfilled if you commit here.",
          "The enemy already drafted Gao Changgong and Mulan, who counter data identifies as direct answers to Daji."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Daji's mid-game tools come online.",
          "Ultimate unlocked: Heartbreaker is the threshold where Daji starts deleting low-resist targets in one rotation",
          "Late game: full build online, Daji reaches the spike public guides describe — extended fights favor her once items are completed."
        ],
        "common_mistakes": [
          "Opening fights when the enemy still has full crowd control, getting deleted before damage lands.",
          "Ignoring Gao Changgong and Mulan on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Greeding farm in mid lane while side lanes get camped — rotation timing matters more than CS lead in most matchups."
