          }
        ],
        "pick_when": [
          "The enemy lacks reliable healing reduction, leaving sustain unchecked",
          "The enemy team relies on hard engage that you can read and recover from",
          "The enemy draft includes Dian Wei, Liu Bei, and Musashi, who appear in counter data as matchups Dyadia can pressure."
        ],
        "avoid_when": [
          "The game state demands burst rather than slow attrition",
          "The enemy chains crowd control faster than recovery cooldowns refresh",
          "The enemy team is built around answers to Team Buffs, removing the windows Dyadia's kit needs to perform."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Dyadia's mid-game tools come online.",
          "Lifesteal item online: trade patterns flip from neutral to favorable once sustain stacks with damage",
          "Late game: cooldowns become short enough that Bitter Farewell influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Forcing all-ins against opponents already wearing anti-heal — your healing barely activates.",
          "Using the recovery skill on the first crowd control, then dying to the follow-up chain.",
          "Engaging without checking enemy summoner-spell cooldowns, which often decide whether Dyadia's commit reaches the target alive.",
          "Forgetting vision while looking for picks — losing the marksman because the support roamed without setting wards is a recurring mistake."
        ],
