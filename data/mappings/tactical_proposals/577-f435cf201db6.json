  "sources": [
    {
      "source": "HOKFIRE",
      "url": "https://www.hokfire.com/",
      "field": "abilities",
      "content": [
        {
          "type": "Passive",
          "name": "Melodic Swing",
          "desc": "Enhances her next Basic Attack periodically to swing toward the enemy, dealing damage and knocking them back, then jumping back. When any hero receives Blessing of Fate or Bitter Reconciliation, she earns Gold and reduces the preparation time of her enhanced Basic Attack."
        },
        {
          "type": "Skill 1",
          "name": "Heartlink",
          "desc": "Blesses a teammate and restores Health. When two blessed teammates come close, they recover Health and gain Movement Speed. If she blesses an already blessed teammate, she will dash to them, and both recover Health and gain Movement Speed. Can use this skill again within 5s."
        },
        {
          "type": "Skill 2",
          "name": "Bitter Farewell",
          "desc": "Marks an enemy, exposes them and deals continuous damage. When two marked enemies come close, they stop taking damage. If she uses the skill on a marked enemy, she will dash to them, immobilizing them and dealing continuous damage. Can use this skill again within 5s."
        },
        {
          "type": "Ultimate",
          "name": "Destined Encounter",
          "desc": "Commands a swarm of wisps to fly forward, blessing and granting Health recovery to teammates, while marking and damaging enemies."
        }
      ]
    },
