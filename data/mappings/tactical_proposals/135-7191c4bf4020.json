      "field": "abilities",
      "content": [
        {
          "type": "Passive",
          "name": "Resolute Will",
          "desc": "Gains damage immunity when Health falls below 30%. Basic Attacks deal extra damage to different units every 5s."
        },
        {
          "type": "Skill 1",
          "name": "Righteous Fervor",
          "desc": "Dashes forward and knocks back enemies. At the end of the dash, launches the enemy and deals damage."
        },
        {
          "type": "Skill 2",
          "name": "No Retreat",
          "desc": "Slows nearby enemies in range and reduces their damage output while dealing damage.Passive: Gains extra Health for every extra point of Physical Defense."
        },
        {
          "type": "Ultimate",
          "name": "Hegemon's Slash",
          "desc": "Deals damage to enemies in the target direction. Inflicts extra damage andstun on enemies close by.The lower his Health, the higher the damage.He gains invulnerability whilethe skill is being released, preventing his Health from falling below 1."
        }
      ]
    },
