    {
      "source": "Kurohiko",
      "url": "https://hok.kurohiko.id/",
      "field": "tactical_tips",
      "content": "1) Xiang Yu itu tank tebel, jangan buang damage ke dia pas teamfight. 2) Skill 1-nya bisa dihindarin. 3) Assassin masuk abis dia pakai control."
    },
    {
      "source": "HoKStats",
      "url": "https://hokstats.gg/heroes/xiang-yu/",
      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Resolute Will",
            "description": "When his Health drops to a certain level, he gains damage reduction. Skill uses grant enhanced Basic Attacks.",
            "type": "passive"
          },
          {
            "name": "Righteous Fervor",
            "description": "Dashes forward and knocks back the enemy. At the end of the dash, launches the enemy, deals damage, and gains an enhanced Basic Attack.",
            "type": "skill1"
          },
          {
            "name": "No Retreat",
            "description": "Slows nearby enemies and reduces their damage output while dealing damage. Gains an enhanced Basic Attack and increased Movement Speed.",
            "type": "skill2"
          },
          {
            "name": "Hegemon's Slash",
            "description": "Gains crowd control immunity and Undying while using. Deals damage to enemies in the target direction, and deals extra damage to and stuns nearby enemies. The lower his Health, the higher the damage.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "The enemy team has multiple high-mobility threats that need to be locked down before they reach your backline",
          "Your team needs a primary front-line who can engage on cooldown windows",
          "The enemy team relies on grouped fights or channeled abilities, exactly what No Retreat interrupts best."
        ],
        "avoid_when": [
          "Your team lacks the follow-up damage to convert your control windows into kills",
          "The enemy stacks anti-tank items like armor penetration and percent-HP damage, melting front-liners quickly",
          "The enemy already drafted Han Xin, Kui, and Lam, who counter data identifies as direct answers to Xiang Yu."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Xiang Yu's mid-game tools come online.",
          "Ultimate online: Hegemon's Slash extends control duration, making team fights snowball off a single hit",
          "Late game: full build online, Xiang Yu reaches the spike public guides describe — extended fights favor him once items are completed."
        ],
        "common_mistakes": [
          "Throwing No Retreat on the front-line tank instead of saving it for backline carries.",
          "Building damage items hoping to deal kills, when the team needs the durability that makes you a tank in the first place.",
          "Ignoring Han Xin and Kui on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Forgetting vision while looking for picks — losing the marksman because the support roamed without setting wards is a recurring mistake."
        ],
