            "type": "skill1"
          },
          {
            "name": "Golden Winged Blessing",
            "description": "Gains Movement Speed and a shield while dealing damage to nearby enemies.",
            "type": "skill2"
          },
          {
            "name": "Wings of Judgment",
            "description": "Sends arrows surging forward, dealing damage. Using the skill again shoots all remaining arrows, damaging nearby enemies, inflicting them with Dread, and removing all Physical Attack bonuses granted by their equipment.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "Your team needs a mid-lane poke mage who can clear minions quickly and pressure from range.",
          "The enemy composition groups for objectives, letting Garuda's area damage and ultimate punish stacked targets.",
          "Your draft can protect Garuda from assassins while he plays behind the frontline and chips enemies down."
        ],
        "avoid_when": [
          "The enemy has backline dive such as Prince of Lanling or Han Xin, which public counter data lists as effective pressure.",
          "Your team cannot protect a stationary mage during ultimate windows or objective fights.",
          "The enemy can shove mid early and deny farm, a counter approach specifically recommended against Garuda."
        ],
        "power_spikes": [
          "Wave control: Keen Feathers and Arrows of Gold let Garuda clear and poke before committing to fights.",
          "Core magic items online: Frozen Breath, Mask of Agony, and Void Staff give him stronger poke and magic penetration.",
          "Late-game grouped fights: public guide data describes Garuda as strong late when his ultimate hits crowds."
        ],
        "common_mistakes": [
          "Standing too far forward after using Skill 2, leaving no escape when divers appear.",
          "Casting Wings of Judgment into a single low-value target instead of waiting for grouped enemies.",
          "Letting opponents shove mid and delay farm, which public counter guidance identifies as a way to weaken Garuda.",
          "Ignoring magic-resistance itemization on opponents when deciding whether poke will finish a fight."
        ],
