      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Piercing Brush",
            "description": "Enhances every 3rd Basic Attack, causing it to deal pierce damage. Deals damage when ink from different skills come in contact. Gains an enhanced Basic Attack and recovers Health if she is also nearby when they do.",
            "type": "passive"
          },
          {
            "name": "Ink Burst",
            "description": "Flings a powerful drop of ink, which deals damage to enemies in its path and explodes to deal extra damage at the end of its range.",
            "type": "skill1"
          },
          {
            "name": "Seething Script",
            "description": "Summons a brush to write at the target location, dealing damage and slowing enemies in its path.",
            "type": "skill2"
          },
          {
            "name": "Finishing Stroke",
            "description": "Dashes wildly with her brush, dealing damage to enemies in her path. Can dash again if she passes through an enemy or ink left by another skill. After dashing 3–5 times, becomes untargetable and continuously attacks nearby enemies.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "Your team needs a damage threat that can finish a fight when Finishing Stroke comes back up",
          "Your draft can capitalize on early picks and snowball lane leads",
          "The enemy draft includes Diaochan, Mulan, and Sima Yi, who appear in counter data as matchups Shangguan can pressure."
        ],
        "avoid_when": [
          "The enemy already invested in magic resist and shields that absorb committed burst windows",
          "Enemy peel is strong and Shangguan cannot reach the backline without dying first",
          "The enemy already drafted Augran, Biron, and Musashi, who counter data identifies as direct answers to Shangguan."
        ],
        "power_spikes": [
          "Early game: Shangguan is listed as an early-game threat in public guide data — convert the early window into objectives before scaling picks come online.",
          "Ultimate unlocked: Finishing Stroke is the threshold where Shangguan starts deleting low-resist targets in one rotation",
          "Late game: cooldowns become short enough that Seething Script influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Opening fights when the enemy still has full crowd control, getting deleted before damage lands.",
          "Diving while enemy hard control is still up, which directly counters Shangguan's engage.",
          "Ignoring Augran and Biron on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Greeding farm in mid lane while side lanes get camped — rotation timing matters more than CS lead in most matchups."
        ],
