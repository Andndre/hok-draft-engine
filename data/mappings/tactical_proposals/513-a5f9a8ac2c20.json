      "field": "abilities",
      "content": [
        {
          "type": "Passive",
          "name": "Piercing Brush",
          "desc": "Enhances every 3rd Basic Attack, causing it to deal pierce damage. Deals damage when brush strokes of different skills come in contact. Touching Brush Power grants enhanced Basic Attack and Health restoration."
        },
        {
          "type": "Skill 1",
          "name": "Ink Burst",
          "desc": "Swipes the brush in the target direction, dealing damage to enemies in the path. Extra damage is dealt at max distance."
        },
        {
          "type": "Skill 2",
          "name": "Seething Script",
          "desc": "Summons a brush to write at the target location, dealing damage andslowing enemies in the path."
        },
        {
          "type": "Ultimate",
          "name": "Finishing Stroke",
          "desc": "Dashes forward, damaging enemies in the path. Can dash again upon coming into contact with an enemy or brushstroke. Dash 3-5 times to become untargetable and damage nearby enemies multiple times."
        }
      ]
    },
