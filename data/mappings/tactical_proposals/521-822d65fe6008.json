        "pick_when": [
          "The enemy team plays dive comp, giving you space to poke before they engage",
          "Your team has the structure to use her ability to farm safely and rotate to side lanes when the wave allows, since Haya delivers consistent damage output and timely roams.",
          "The enemy draft includes Sakeer, Zilong, and Milady, who appear in counter data as matchups Haya can pressure."
        ],
        "avoid_when": [
          "The enemy has hard engage that closes distance through poke patterns",
          "Your team needs a jungle pick more than Haya's specialty, leaving the role unfilled if you commit here.",
          "The enemy team is built around answers to Ranged Harass, removing the windows Haya's kit needs to perform."
        ],
        "power_spikes": [
          "Early game: Haya is listed as an early-game threat in public guide data — convert the early window into objectives before scaling picks come online.",
          "Mana sustain online: poke patterns become repeatable once cooldown reduction and mana regen items come online",
          "Late game: cooldowns become short enough that Wayward Rays influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Spending mana on poke that does not threaten kills, leaving you empty for the actual fight.",
          "Engaging without checking enemy summoner-spell cooldowns, which often decide whether Haya's commit reaches the target alive.",
          "Greeding farm in mid lane while side lanes get camped — rotation timing matters more than CS lead in most matchups."
        ],
