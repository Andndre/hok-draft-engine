          "skill_id": 15100,
          "type": "Passive",
          "name": "Sovereign of the Southeast (Zuo Duan Dong Nan)",
          "desc": "Basic attacks and skills apply Marks on enemy heroes, stacking up to 5 times. Each stack reduces the target's damage dealt to Sun Quan by 3% (up to 15%). At 5 stacks, Sun Quan unlocks his Ultimate and enters the 'Formation Breaker' state, significantly enhancing attack power and converting Attack Speed into casting speed.",
          "cd": "0",
          "cost": "0",
          "tags": [
            "Mark",
            "Damage Reduction",
            "State Transform",
            "Attack Speed"
          ],
          "icon": "https://game.gtimg.cn/images/yxzj/img201606/heroimg/151/15100.png"
        },
        {
          "skill_id": 15101,
          "type": "Skill 1",
          "name": "Piercing Clouds (Lie Shi Chuan Yun)",
          "desc": "Ranged Form: Throws military war banners that trigger an arrow rain barrage, dealing physical damage and slow over a designated area. Melee Form: Sweeps the ancient Guding blade in rapid wide slashes.",
          "cd": "6",
          "cost": "40",
          "tags": [
            "AoE",
            "Slow",
            "Ranged/Melee Form",
            "Damage"
          ],
          "icon": "https://game.gtimg.cn/images/yxzj/img201606/heroimg/151/15110.png"
        },
        {
          "skill_id": 15102,
          "type": "Skill 2",
          "name": "Swift Maneuver (You Ren You Yu)",
          "desc": "Ranged Form: Channels while moving with boosted movement speed, firing continuous mobile shots at up to two locked targets. Melee Form: Unleashes rapid flurry slashes with self-healing sustain.",
          "cd": "8",
          "cost": "50",
          "tags": [
            "Mobile Attack",
            "Movement Speed",
            "Dual Target",
            "Heal"
          ],
          "icon": "https://game.gtimg.cn/images/yxzj/img201606/heroimg/151/15120.png"
        },
        {
          "skill_id": 15103,
          "type": "Ultimate",
          "name": "Banner Formation Charge (Hui Jing Po Zhen)",
          "desc": "Unlocked only at 5 passive mark stacks. Sun Quan dashes forward with his war banner, dealing multi-hit physical damage and triggering high-frequency on-hit effects. On the final blow, leaps backward to a safe distance and refreshes Formation Breaker state.",
          "cd": "30",
          "cost": "80",
          "tags": [
            "Ultimate",
            "Dash",
            "Multi-hit",
            "On-hit",
            "Disengage"
          ],
