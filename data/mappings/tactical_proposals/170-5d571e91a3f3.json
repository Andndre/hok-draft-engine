        "pick_when": [
          "Your team needs a slippery damage threat that survives by movement rather than durability",
          "The enemy team relies on long-cooldown engage skills that leave them vulnerable post-fight",
          "The enemy draft includes Lady Zhen, Nuwa, and Xiao Qiao, who appear in counter data as matchups Liu Bei can pressure."
        ],
        "avoid_when": [
          "The enemy stacks point-and-click hard control that bypasses dodging",
          "The enemy team disengages well, so cleanup windows never open",
          "The enemy already drafted Dyadia, who counter data identifies as direct answers to Liu Bei."
        ],
        "power_spikes": [
          "Early game: Liu Bei is listed as an early-game threat in public guide data — convert the early window into objectives before scaling picks come online.",
          "Cooldown reduction online: dash skills come back fast enough to chain through fights",
          "Late game: cooldowns become short enough that Leading the Charge influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Burning all dashes to engage, leaving none to escape if the engage fails.",
          "Engaging first instead of second — cleanup picks lose their value as primary engagers.",
          "Ignoring Dyadia on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Pathing predictably and getting tracked by the enemy jungler — vary first clear and rotate based on ward placement rather than muscle memory."
        ],
