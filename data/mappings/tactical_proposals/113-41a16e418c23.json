          "desc": "Periodically removes crowd control effects and increases Movement Speed and damage reduction."
        },
        {
          "type": "Skill 1",
          "name": "Kaleidoscope",
          "desc": "Triggers Nature's Will, releasing dream butterflies in a fan-shaped area, inflicting damage and slowing enemies in range."
        },
        {
          "type": "Skill 2",
          "name": "Sleep Starts",
          "desc": "Deals damage to enemies in range and increases ally Movement Speed Grants a stack each time dealing damage, up to 5 stacks. Each stack increases skill damage. Passive: Periodically casts Sleep Starts."
        },
        {
          "type": "Ultimate",
          "name": "Butterfly Effect",
          "desc": "Removes crowd controls from allies within range and increases shield."
        }
      ]
    },
