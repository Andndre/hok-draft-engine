        "pick_when": [
          "Your team needs a setup hero whose Robo Smash creates kill windows for the carry",
          "The enemy team has high physical or magic burst that demands a dedicated tank to absorb",
          "The enemy draft includes Arthur, Augran, and Biron, who appear in counter data as matchups Liu Shan can pressure."
        ],
        "avoid_when": [
          "The enemy team is loaded with cleanse, dashes, and immunity that bypass crowd control",
          "Your team comp lacks damage and adding another non-damage pick collapses the win condition",
          "The enemy already drafted Li Bai, who counter data identifies as direct answers to Liu Shan."
        ],
        "power_spikes": [
          "Early game: Liu Shan is listed as an early-game threat in public guide data — convert the early window into objectives before scaling picks come online.",
          "Ultimate online: Take It for a Spin extends control duration, making team fights snowball off a single hit",
          "Late game: Crimson Shadow - Howl, Protector's Cuirass, and Glacial Buckler on the bar means Liu Shan can soak commits in 5v5 team fights for his carries."
        ],
        "common_mistakes": [
          "Throwing Robo Smash on the front-line tank instead of saving it for backline carries.",
          "Building damage items hoping to deal kills, when the team needs the durability that makes you a tank in the first place.",
          "Ignoring Li Bai on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Forgetting vision while looking for picks — losing the marksman because the support roamed without setting wards is a recurring mistake."
        ],
