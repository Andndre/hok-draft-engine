          "desc": "Liu Shan's skills deal equal damage to structures and can disrupt them while also recovering Health."
        },
        {
          "type": "Skill 1",
          "name": "Overcharge!",
          "desc": "Gains a shield and increased Movement Speed while enhancing the next Basic Attack, dealing damage, and launching the target."
        },
        {
          "type": "Skill 2",
          "name": "Robo Smash",
          "desc": "Inflicts damage and stun on enemies in the target area."
        },
        {
          "type": "Ultimate",
          "name": "Take It for a Spin",
          "desc": "Launches a spinning attack that continuously deals damage to nearby enemies. While spinning, Basic Attacks slow and deal damage to targets."
        }
      ]
    },
