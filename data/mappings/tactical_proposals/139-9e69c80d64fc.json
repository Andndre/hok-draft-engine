        "pick_when": [
          "Your draft can capitalize on early picks and snowball lane leads",
          "Your team has the structure to use his ability to soak pressure in lane and threaten side objectives, since Fuzi delivers a durable front-line presence with steady wave control.",
          "The enemy draft includes Milady, Luna, and Mai Shiranui, who appear in counter data as matchups Fuzi can pressure."
        ],
        "avoid_when": [
          "Enemy peel is strong and Fuzi cannot reach the backline without dying first",
          "Your team needs a mid pick more than Fuzi's specialty, leaving the role unfilled if you commit here.",
          "A stronger pick in the same role is open and the matchup does not specifically reward Fuzi's Gap-Close."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Fuzi's mid-game tools come online.",
          "Ultimate unlocked: Sage's Might converts mobility into burst, the moment Fuzi starts threatening picks across the map",
          "Late game: full build online, Fuzi reaches the spike public guides describe — extended fights favor him once items are completed."
        ],
        "common_mistakes": [
          "Engaging without follow-up — gap-close gets you to the target, but a solo dive without ally damage trades 1-for-1.",
          "Engaging without checking enemy summoner-spell cooldowns, which often decide whether Fuzi's commit reaches the target alive.",
          "Forcing solo engages instead of waiting for ally commit — Fuzi's value compounds when the team follows up on engages."
        ],
