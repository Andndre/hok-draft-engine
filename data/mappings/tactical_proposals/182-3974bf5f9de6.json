      "content": {
        "skills": [
          {
            "name": "Forever Entwined",
            "description": "Basic Attacks deal extra damage. Flying sword skills have a shared usage cap. When flying swords hit, place Sword Energy on targets, and flying swords deal extra damage to targets marked with Sword Energy.",
            "type": "passive"
          },
          {
            "name": "Guard Her Grave",
            "description": "Unleashes Splitting Sword and moves backwards, knocking back enemies and dealing damage while reducing their Magical Defense.",
            "type": "skill1"
          },
          {
            "name": "Coupled Blades - Short",
            "description": "Throws flying swords that deal damage to enemies in their path.",
            "type": "skill2"
          },
          {
            "name": "Coupled Blades - Long",
            "description": "Throws flying swords that deal damage to enemies in their path.",
            "type": "skill3"
          },
          {
            "name": "Freshly Forged",
            "description": "Immediately gains 2 uses of flying sword skill and summons more swords to enhance the next flying sword skill. Passive: Increases field of vision and grants one additional use of Coupled Blades. Each time a flying sword hits an enemy, the cooldown of Freshly Forged is reduced.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "Your team lacks reliable burst on isolated picks and needs single-target finishing damage",
          "Your team has the structure to use their ability to farm safely and rotate to side lanes when the wave allows, since Gan & Mo delivers consistent damage output and timely roams.",
          "The enemy draft includes Cirrus, Jing, and Pei, who appear in counter data as matchups Gan & Mo can pressure."
        ],
        "avoid_when": [
          "You need sustained damage rather than one-shot windows tied to Coupled Blades - Long's cooldown",
          "Your team needs a jungle pick more than Gan & Mo's specialty, leaving the role unfilled if you commit here.",
          "The enemy already drafted Butterfly and Sun Ce, who counter data identifies as direct answers to Gan & Mo."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Gan & Mo's mid-game tools come online.",
          "Two-item spike: once core damage is online, Gan & Mo's Coupled Blades - Short starts one-shotting backline picks",
          "Late game: full build online, Gan & Mo reaches the spike public guides describe — extended fights favor them once items are completed."
        ],
        "common_mistakes": [
          "Committing Coupled Blades - Long when the target still has a shield, dash, or cleanse available, wasting the cooldown.",
          "Ignoring Butterfly and Sun Ce on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Greeding farm in mid lane while side lanes get camped — rotation timing matters more than CS lead in most matchups."
        ],
