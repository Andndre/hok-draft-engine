        "pick_when": [
          "Your team wants to siege objectives where ranged poke whittles down defenders",
          "Your team needs a setup hero whose Taking Liberties creates kill windows for the carry",
          "The enemy draft includes Augran, Cirrus, and Lam, who appear in counter data as matchups Yixing can pressure."
        ],
        "avoid_when": [
          "The team fight will happen in cramped jungle spaces where poke ranges are minimized",
          "The enemy team is loaded with cleanse, dashes, and immunity that bypass crowd control",
          "The enemy already drafted Allain, Dharma, and Dian Wei, who counter data identifies as direct answers to Yixing."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Yixing's mid-game tools come online.",
          "Mana sustain online: poke patterns become repeatable once cooldown reduction and mana regen items come online",
          "Late game: cooldowns become short enough that Taking Liberties influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Spending mana on poke that does not threaten kills, leaving you empty for the actual fight.",
          "Throwing Taking Liberties on the front-line tank instead of saving it for backline carries.",
          "Ignoring Allain and Dharma on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Greeding farm in mid lane while side lanes get camped — rotation timing matters more than CS lead in most matchups."
