        {
          "skill_id": 13600,
          "type": "Passive",
          "name": "destiny's daughter",
          "desc": "Passive: The out-of-combat triggering time of the passive effect is 3 seconds (the default out-of-combat duration is still 6 seconds). After Wu Zetian leaves the battle, her movement speed will increase by 50 points, and 2% of her Max Mana will be restored every second.",
          "cd": "0",
          "cost": "0",
          "tags": [
            "Recovery",
            "Speed Up"
          ],
          "icon": "https://game.gtimg.cn/images/yxzj/img201606/heroimg/136/13600.png"
        },
        {
          "skill_id": 13601,
          "type": "Skill 1",
          "name": "Empress glow",
          "desc": "Wu Zetian releases an energy ball in the designated direction, which explodes after hitting the enemy, causing 360/420/480/540/600/660 (+47% spell bonus) magic damage to enemies within the range; the passively enhanced Empress' glow will cause double damage and knock the target away for 0.75 seconds; Passive: After Wu Zetian releases any two skills, the Empress' glow will immediately cool down and be strengthened, lasting for 3 seconds.",
          "cd": "3",
          "cost": "60",
          "tags": [
            "Damage",
            "Crowd Control"
          ],
          "icon": "https://game.gtimg.cn/images/yxzj/img201606/heroimg/136/13610.png"
        },
        {
          "skill_id": 13602,
          "type": "Skill 2",
          "name": "The majesty of the empress",
          "desc": "Wu Zetian's majesty is inviolable, knocking back nearby enemies and causing them 250/280/310/340/370/400 (+30% spell bonus) magic damage; if the skill hits an enemy, it will increase its movement speed by 30/34/38/42/44/50% for 1 second, and the enemy hit will have its movement speed reduced by 30/34/38/42/46/50% for 2 seconds.",
          "cd": "8/7.6/7.2/6.8/6.4/6",
          "cost": "90",
          "tags": [
            "Knock Back",
            "Speed Up",
            "Slow"
          ],
          "icon": "https://game.gtimg.cn/images/yxzj/img201606/heroimg/136/13620.png"
        },
        {
          "skill_id": 13603,
          "type": "Skill 3",
          "name": "life and death",
          "desc": "Wu Zetian imposed sanctions with the authority of the empress, summoning a magic circle at the feet of all enemy heroes and detonating it, causing 750/925/1100 (+75% spell bonus) magic damage to enemies within the range and stunning them for 1 second. At the same time, they gained vision of the enemy for 3 seconds.",
          "cd": "80/70/60",
          "cost": "150",
          "tags": [
            "Crowd Control",
            "Vision",
            "Stun"
          ],
          "icon": "https://game.gtimg.cn/images/yxzj/img201606/heroimg/136/13630.png"
        },
