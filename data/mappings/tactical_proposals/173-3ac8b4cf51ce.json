      "field": "abilities",
      "content": [
        {
          "type": "Passive",
          "name": "Going Undercover",
          "desc": "Periodically reveals a random enemy hero within range.Attacks on monsters deal extra true damage."
        },
        {
          "type": "Skill 1",
          "name": "Target Sighted",
          "desc": "Marks the target enemy while gaining attack speed and range. Attacks on marked targets stack more marks, increasing mark damage. When marks expire or reach max stacks, they explode, dealing area damage."
        },
        {
          "type": "Skill 2",
          "name": "Wheel Away",
          "desc": "Dashes in the target direction, slowing and dealing damage to enemies in his path. He is untargetable while dashing. Scorches the ground along the way, slowing and dealing damage to enemies in range."
        },
        {
          "type": "Ultimate",
          "name": "Bladestorm",
          "desc": "Throws his blade to the target location,dealing damage over time and slowing enemies wihin range."
        }
      ]
    },
