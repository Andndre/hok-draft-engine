      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Going Undercover",
            "description": "Periodically reveals enemy heroes within range. Deals extra physical damage against monsters and minions.",
            "type": "passive"
          },
          {
            "name": "Target Sighted",
            "description": "Marks the target enemy while increasing his own Attack Speed and Attack Range. Attacking the marked target adds stacks, increasing the marks' damage. Upon reaching max stacks or when the marks expire, the marks explode, dealing area damage.",
            "type": "skill1"
          },
          {
            "name": "Wheel Away",
            "description": "Dashes in the target direction, slowing and dealing damage to enemies in his path. He is untargetable while dashing. Scorches the ground in his path, slowing and dealing damage to enemies within range.",
            "type": "skill2"
          },
          {
            "name": "Bladestorm",
            "description": "Throws his blade to the target location, dealing damage over time and slowing enemies within range.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "The map shape favors gank routes, where mobility translates directly into kills",
          "Your team can engage first, letting Fang second-wave into low-health targets",
          "The enemy draft includes Mai Shiranui, Nakoruru, and Zilong, who appear in counter data as matchups Fang can pressure."
        ],
        "avoid_when": [
          "Enemy peel is strong and Fang cannot reach the backline without dying first",
          "Your team has no primary engage, leaving the cleanup pick with nothing to follow up on",
          "The enemy already drafted Dun, who counter data identifies as direct answers to Fang."
        ],
        "power_spikes": [
          "Early game: Fang is listed as an early-game threat in public guide data — convert the early window into objectives before scaling picks come online.",
          "Ultimate unlocked: Bladestorm converts mobility into burst, the moment Fang starts threatening picks across the map",
          "Late game: with full damage online, sustained DPS outpaces enemy healing in extended fights."
        ],
        "common_mistakes": [
          "Engaging without follow-up — gap-close gets you to the target, but a solo dive without ally damage trades 1-for-1.",
          "Engaging first instead of second — cleanup picks lose their value as primary engagers.",
          "Ignoring Dun on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Auto-attacking through enemy dive instead of repositioning — losing the marksman in early fights collapses the late-game win condition."
        ],
