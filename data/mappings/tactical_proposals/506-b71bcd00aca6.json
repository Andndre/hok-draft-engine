      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Through the Clouds",
            "description": "Ignores terrain after reaching level 4 and gains Movement Speed when using Basic Attacks. Enemies hit by his Basic Attacks or skills take damage when they move.",
            "type": "passive"
          },
          {
            "name": "Cloud Descending",
            "description": "Charges up, gaining Movement Speed. Then dashes forward, damaging and stunning enemies. Can jump back if he hits a hero.",
            "type": "skill1"
          },
          {
            "name": "Razor Wind",
            "description": "Throws wind blades that slow and deal damage to enemies 2 times. Then gains Attack Speed and ranged Basic Attacks.",
            "type": "skill2"
          },
          {
            "name": "Soaring Whirlwind",
            "description": "Carries an enemy hero into the air, then strikes the ground, dealing area damage and launching the enemy he carried.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "Your draft can capitalize on early picks and snowball lane leads",
          "Your team can engage first, letting Cirrus second-wave into low-health targets",
          "The enemy draft includes Hou Yi and Xiao Qiao, who appear in counter data as matchups Cirrus can pressure."
        ],
        "avoid_when": [
          "Enemy peel is strong and Cirrus cannot reach the backline without dying first",
          "Your team has no primary engage, leaving the cleanup pick with nothing to follow up on",
          "The enemy already drafted Di Renjie and Mulan, who counter data identifies as direct answers to Cirrus."
        ],
        "power_spikes": [
          "Early game: jungle clear into level-4 ganks is the first window where Cirrus can translate routes into kills.",
          "Ultimate unlocked: Soaring Whirlwind converts mobility into burst, the moment Cirrus starts threatening picks across the map",
          "Late game: cooldowns become short enough that Razor Wind influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Engaging without follow-up — gap-close gets you to the target, but a solo dive without ally damage trades 1-for-1.",
          "Engaging first instead of second — cleanup picks lose their value as primary engagers.",
          "Ignoring Di Renjie and Mulan on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Pathing predictably and getting tracked by the enemy jungler — vary first clear and rotate based on ward placement rather than muscle memory."
        ],
