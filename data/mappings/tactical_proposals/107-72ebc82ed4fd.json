    {
      "source": "HoKStats",
      "url": "https://hokstats.gg/heroes/zilong/",
      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Dragon's Roar",
            "description": "As his Health declines, he gains more damage reduction and his basic skills are enhanced.",
            "type": "passive"
          },
          {
            "name": "Thunderbreaker",
            "description": "Charges forward, dealing damage and enhancing his next Basic Attack. Stocks an extra use of Thunderbreaker each time there is a change in his Passive slots.",
            "type": "skill1"
          },
          {
            "name": "Stormpiercer",
            "description": "Jabs repeatedly in the target direction, dealing damage. Recovers Health on hit.",
            "type": "skill2"
          },
          {
            "name": "Skysplitter",
            "description": "Leaps to the target area to deal damage, launching enemies in the center. 50% of the cooldown is returned if no heroes are hit.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "Your team needs a simple jungle ganker who can start fights with Skysplitter and follow with Stormpiercer and Thunderbreaker.",
          "Your lanes can help Zilong convert early ganks into tempo, which matches public guide advice that he is effective early when switching into lane pressure.",
          "The enemy draft gives Zilong isolated targets instead of forcing him through tanks, crowd control, and physical-defense items every fight."
        ],
        "avoid_when": [
          "The enemy team has reliable crowd control ready to stop his attacks, which public counter guides identify as one of the main ways to shut Zilong down.",
          "Your jungle can be invaded early or your lanes cannot contest counter-ganks, because denying Zilong levels limits his snowball pressure.",
          "The opposing team is already building healing reduction and physical defense, reducing the value of Zilong's sustain and burst."
        ],
        "power_spikes": [
          "Early game: public guide data describes Zilong as strong early when he moves from jungle clear into lane ganks.",
          "Ultimate unlocked: Skysplitter enables his listed combo path, Ultimate into Skill 2 into Skill 1, for committing onto a chosen target.",
          "Late game: guide sources note he can still be threatening because his passive helps when low on health, but only if he avoids being controlled before dealing damage."
        ],
        "common_mistakes": [
          "Ganking without lane support and getting counter-ganked before Zilong can snowball.",
          "Diving while enemy crowd control is still available, which directly plays into his listed counters.",
          "Ignoring anti-heal and physical-defense items on the enemy team when deciding whether to commit.",
          "Using the Ultimate + Skill 2 + Skill 1 combo without a clear target or follow-up damage."
        ],
