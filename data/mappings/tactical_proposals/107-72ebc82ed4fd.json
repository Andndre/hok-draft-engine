          "name": "Dragon's Roar",
          "desc": "The lower his Health, the greater his damage reduction and skills."
        },
        {
          "type": "Skill 1",
          "name": "Thunderbreaker",
          "desc": "Zilong charges forward, dealing damage and enhancing his next Basic Attack. This skill's cooldown is reset whenever his Health reaches a certain level."
        },
        {
          "type": "Skill 2",
          "name": "Stormpiercer",
          "desc": "Jabs repeatedly in the target direction, dealing damage. Recovers Health on hit."
        },
        {
          "type": "Ultimate",
          "name": "Skysplitter",
          "desc": "Leaps to the target area, damaging and launching enemies in the center."
        }
      ]
    },
