      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Raging Tide",
            "description": "The next Basic Attack periodically deals extra damage and restores Health. Gains 1 stack every time a skill deals damage, or every time he takes physical or true damage, for up to 10 stacks. Each stack increases Physical Defense.",
            "type": "passive"
          },
          {
            "name": "Wave Render",
            "description": "Dashes in the target direction, dealing damage to enemies in his path and at the end of his dash. After a short delay, launches enemies and deals further damage.",
            "type": "skill1"
          },
          {
            "name": "Typhoon",
            "description": "Strides forward and sweeps enemies in front, dealing damage and slowing them. Can sweep an extra 2 times before the skill goes into cooldown.",
            "type": "skill2"
          },
          {
            "name": "Set Sail!",
            "description": "Pilots a boat forward and becomes immune to crowd control. The boat can also carry 1 teammate. When it hits obstacles or certain enemies, it explodes and launches enemies, dealing damage. If he bails out early, the boat will coast for a distance.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "Your team needs a setup hero whose Typhoon creates kill windows for the carry",
          "The enemy team has high physical or magic burst that demands a dedicated tank to absorb",
          "The enemy draft includes Liang, Gan & Mo, and Mi Yue, who appear in counter data as matchups Sun Ce can pressure."
        ],
        "avoid_when": [
          "The enemy team is loaded with cleanse, dashes, and immunity that bypass crowd control",
          "Your team comp lacks damage and adding another non-damage pick collapses the win condition",
          "The enemy team is built around answers to Crowd Control, removing the windows Sun Ce's kit needs to perform."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Sun Ce's mid-game tools come online.",
          "Ultimate online: Set Sail! extends control duration, making team fights snowball off a single hit",
          "Late game: Frigid Charge, Succubus Cloak, and Spikemail on the bar means Sun Ce can soak commits in 5v5 team fights for his carries."
        ],
        "common_mistakes": [
          "Throwing Typhoon on the front-line tank instead of saving it for backline carries.",
          "Building damage items hoping to deal kills, when the team needs the durability that makes you a tank in the first place.",
          "Engaging without checking enemy summoner-spell cooldowns, which often decide whether Sun Ce's commit reaches the target alive.",
          "Forcing solo engages instead of waiting for ally commit — Sun Ce's value compounds when the team follows up on engages."
        ],
