      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Chastising Shot",
            "description": "Each Basic Attack hit increases Attack Speed. When the effect is fully stacked, he shoots several shots with each Basic Attack.",
            "type": "passive"
          },
          {
            "name": "Arrow Volley",
            "description": "Increases Basic Attack damage and shoots extra arrows to hit multiple enemies.",
            "type": "skill1"
          },
          {
            "name": "Afterglow",
            "description": "Inflicts area damage and slow.",
            "type": "skill2"
          },
          {
            "name": "Burning Sun Arrow",
            "description": "Shoots a long-range explosive arrow that stuns the target on hit, dealing area damage and inflicting slow.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "Your team needs a setup hero whose Afterglow creates kill windows for the carry",
          "The enemy team has front-line targets that Hou Yi can chip down with sustained ranged damage",
          "The enemy draft includes Cirrus, Mulan, and Xuance, who appear in counter data as matchups Hou Yi can pressure."
        ],
        "avoid_when": [
          "The enemy team is loaded with cleanse, dashes, and immunity that bypass crowd control",
          "The game is decided early before the marksman can hit core item spikes",
          "The enemy already drafted Agudo, who counter data identifies as direct answers to Hou Yi."
        ],
        "power_spikes": [
          "Early game: farm safely behind the support, surviving lane phase to reach the marksman scaling window.",
          "Ultimate online: Burning Sun Arrow extends control duration, making team fights snowball off a single hit",
          "Late game: full build online, Hou Yi reaches the spike public guides describe — extended fights favor him once items are completed."
        ],
        "common_mistakes": [
          "Throwing Afterglow on the front-line tank instead of saving it for backline carries.",
          "Auto-attacking instead of repositioning when the enemy assassin is missing — losing the marksman loses the fight.",
          "Ignoring Agudo on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Auto-attacking through enemy dive instead of repositioning — losing the marksman in early fights collapses the late-game win condition."
        ],
