      "field": "abilities",
      "content": [
        {
          "type": "Passive",
          "name": "Mountain Encounter",
          "desc": "Replaces Recovery with Release. Upon releasing monsters, they grant her Gold, EXP, and their respective blessing. Her Basic Attacks drop Seed Mines around enemy targets."
        },
        {
          "type": "Skill 1",
          "name": "Wild Growth",
          "desc": "Grants Movement Speed and Health recovery to allied units in the target area. Additionally, she gains Attack Speed and summons multiple monsters at the center."
        },
        {
          "type": "Skill 2",
          "name": "Tumble, Furball!",
          "desc": "Rolls forward, dealing damage to nearby enemies. Gains immunity against 1 hard crowd control, and damages and launches enemies hit."
        },
        {
          "type": "Ultimate",
          "name": "Seed Mines",
          "desc": "Agudo rolls forward and enhances her next Basic Attack to drops 3 Seed Mines and deal Physical Damage."
        }
      ]
    },
