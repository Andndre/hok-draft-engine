  "sources": [
    {
      "source": "HOKFIRE",
      "url": "https://www.hokfire.com/",
      "field": "abilities",
      "content": [
        {
          "type": "Passive",
          "name": "Niten Ichiryuu",
          "desc": "Using skills generates Vigor, which is consumed by Basic Attacks to gain enhancement effects. Hitting an enemy reduces the cooldown of Skills 1 and Skills 2. Vigor can stack up to two times. 1 Vigor: Enhances Basic Attack damage. 2 Vigor: Dashes and slows enemies."
        },
        {
          "type": "Skill 1",
          "name": "Illuminating Slash",
          "desc": "Unleashes sword energy in the target direction, dealing damage to enemies in its path and knocking down projectiles. Becomes immune to crowd control when using the skill."
        },
        {
          "type": "Skill 2",
          "name": "Extreme Speed",
          "desc": "Dashes in the target direction, dealing damage and gaining a shield upon hitting an enemy."
        },
        {
          "type": "Ultimate",
          "name": "Duel to the Death",
          "desc": "Dashes to the target, launching them and dealing damage to enemies within range, while delaying the target's recovery effects."
        }
      ]
    },
    {
