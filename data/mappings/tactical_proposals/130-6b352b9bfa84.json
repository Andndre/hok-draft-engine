    {
      "source": "Kurohiko",
      "url": "https://hok.kurohiko.id/",
      "field": "tactical_tips",
      "content": "1) Hindarin skill 1 Musashi. 2) Hero tipis berdiri di belakang, sekali kena ult Musashi susah kabur."
    },
    {
      "source": "HoKStats",
