      "content": {
        "skills": [
          {
            "name": "Niten Ichiryuu",
            "description": "Using skills generates Vigor, which is consumed by Basic Attacks to gain enhancement effects. Hitting an enemy reduces the cooldown of Skills 1 and 2. 1 Vigor: Enhances Basic Attack damage. 2 Vigor: Dashes and slows enemies.",
            "type": "passive"
          },
          {
            "name": "Illuminating Slash",
            "description": "Unleashes sword energy in the target direction, dealing damage to enemies in its path and knocking down projectiles. Gains crowd control immunity when using the skill.",
            "type": "skill1"
          },
          {
            "name": "Extreme Speed",
            "description": "Dashes in the target direction, dealing damage and gaining a shield upon hitting an enemy.",
            "type": "skill2"
          },
          {
            "name": "Duel to the Death",
            "description": "Dashes to the target, launching and damaging enemies within range. Also delays the target's recovery effects.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "The map shape favors gank routes, where mobility translates directly into kills",
          "Your team can engage first, letting Musashi second-wave into low-health targets",
          "The enemy draft includes Diaochan, Luna, and Shangguan, who appear in counter data as matchups Musashi can pressure."
        ],
        "avoid_when": [
          "The team needs sustained team-fight damage rather than a single-target diver",
          "Your team has no primary engage, leaving the cleanup pick with nothing to follow up on",
          "The enemy already drafted Dyadia and Sun Bin, who counter data identifies as direct answers to Musashi."
        ],
        "power_spikes": [
          "Early game: jungle clear into level-4 ganks is the first window where Musashi can translate routes into kills.",
          "Ultimate unlocked: Duel to the Death converts mobility into burst, the moment Musashi starts threatening picks across the map",
          "Late game: cooldowns become short enough that Extreme Speed influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Engaging without follow-up — gap-close gets you to the target, but a solo dive without ally damage trades 1-for-1.",
          "Engaging first instead of second — cleanup picks lose their value as primary engagers.",
          "Ignoring Dyadia and Sun Bin on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Pathing predictably and getting tracked by the enemy jungler — vary first clear and rotate based on ward placement rather than muscle memory."
        ],
