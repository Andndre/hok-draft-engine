      "field": "abilities",
      "content": [
        {
          "type": "Passive",
          "name": "Spear Will - Sweeping Fire",
          "desc": "Skills grant marks (up to 3 stacks), and different stacks upgrade thefollowing Basic Attacks into different skills."
        },
        {
          "type": "Skill 1",
          "name": "Moonslash",
          "desc": "Deals damage to enemies within range and launches them."
        },
        {
          "type": "Skill 2",
          "name": "Cloudchaser",
          "desc": "Dashes to the target location then sweeps the enemy, slowing them and dealing damage. Skill can be charged to enhance damage and gain extra effects"
        },
        {
          "type": "Ultimate",
          "name": "Starburn",
          "desc": "Dashes in the target direction, damaging and launching enemies. Then returns to the start point to damage and pull enemies a short distance. Gains lmmunity and damage reduction while using. Use again to deal continuous damage to the target area."
        }
      ]
    },
