  "sources": [
    {
      "source": "HOKFIRE",
      "url": "https://www.hokfire.com/",
      "field": "abilities",
      "content": [
        {
          "type": "Passive",
          "name": "Whirling Featherblades",
          "desc": "Mark Damage When attacking at a distance, Basic Attacks throw a blade that returns to her. She can hit the blade as it returns to bounce it back at the enemy, dealing increased damage with each rebound. When attacking nearby targets, she enters melee mode and attacks faster. Basic Attacks mark targets. Marked enemies take extra damage from Skill 2."
        },
        {
          "type": "Skill 1",
          "name": "Feverish Dance",
          "desc": "Enhance Damage Slow Sweeps the surrounding area, damaging and slowing nearby enemies. Then enters Frenzied state, gaining a major boost to Movement Speed and Attack Speed."
        },
        {
          "type": "Skill 2",
          "name": "Feathered Tempest",
          "desc": "Damage Recovery Movement Dashes forward, damaging and knocking back enemies. Also triggers Featherblade marks and spreads them to nearby enemies. Then, throws rebounding blades at enemies in front, dealing damage and recovering Health. Each hit consumes 1 mark to deal extra damage."
        },
        {
          "type": "Ultimate",
          "name": "Final Frenzy",
          "desc": "Indomitable Enhance Damage Damages nearby enemies and gains Movement Speed. Also enters the Indomitable state for 4s, gaining temporary Health. If she is defeated while this skill is not on cooldown, she resurrects after a short delay, damaging nearby enemies. The skill will then enter cooldown. '''Passive:''' Upgrading this skill increases Skill 2 and melee Basic Attack damage. The Indomitable state ends immediately if she loses all of her temporary Health."
        }
      ]
    },
    {
      "source": "HOKFIRE",
      "url": "https://www.hokfire.com/",
      "field": "guide",
      "content": {
        "pros": [
          "Strong duelist with good sustained damage",
          "Healthy mix of damage and durability",
          "Can split-push and skirmish across the map"
        ],
        "cons": [
          "Vulnerable before key items come online",
          "Struggles into heavy ranged poke",
          "Can be peeled and kited by control"
        ],
        "gameplay_tips": "Umbrosa is a Fighter who plays the Clash Lane. Your aim is to trade in your lane, then bully your way onto the enemy backline. Pick your moment to use Final Frenzy, then follow up with Feverish Dance and Feathered Tempest. Manage the wave, respect ganks, and look to roam once you have a lead."
      }
    },
    {
