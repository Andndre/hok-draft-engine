        "pick_when": [
          "The team draft favors extended team fights where healing scales",
          "Your team has the structure to use their ability to soak pressure in lane and threaten side objectives, since Umbrosa delivers a durable front-line presence with steady wave control.",
          "The enemy composition leaves room for Umbrosa to reach the targets their kit punishes."
        ],
        "avoid_when": [
          "The enemy already builds anti-heal items, neutralizing your sustain plan",
          "Your team needs a mid pick more than Umbrosa's specialty, leaving the role unfilled if you commit here.",
          "The enemy team is built around answers to Sustained Damage, removing the windows Umbrosa's kit needs to perform."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Umbrosa's mid-game tools come online.",
          "Lifesteal item online: trade patterns flip from neutral to favorable once sustain stacks with damage",
          "Late game: cooldowns become short enough that Feathered Tempest influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Forcing all-ins against opponents already wearing anti-heal — your healing barely activates.",
          "Engaging without checking enemy summoner-spell cooldowns, which often decide whether Umbrosa's commit reaches the target alive.",
          "Forcing solo engages instead of waiting for ally commit — Umbrosa's value compounds when the team follows up on engages."
        ],
