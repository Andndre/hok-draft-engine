      "field": "abilities",
      "content": [
        {
          "type": "Passive",
          "name": "Scorching Ember",
          "desc": "Gains Movement Speed and a shield that negates true damage when attacking the enemy."
        },
        {
          "type": "Skill 1",
          "name": "Fire-tipped Spear - Sweep",
          "desc": "Attacks nearby enemies, dealing damage. This attack also weakens the recovery capability of heroes and deals true damage over time."
        },
        {
          "type": "Skill 2",
          "name": "Red Armillary Sash - Bind",
          "desc": "Flips behind the target to deal damage. skill3 Universe Ring - Skyfall Flies to a target, dealing damage and knocking them back. When he reaches the target area, he gains damage reduction and Resistance."
        },
        {
          "type": "Ultimate",
          "name": "Universe Ring",
          "desc": "Unleashes the universe ring, dealing damage to enemy heroes across the entire map and gaining vision. Enhances the range of Universe Ring - Skyfall to cover the entire map for 5s."
        }
      ]
    },
    {
      "source": "HOKFIRE",
      "url": "https://www.hokfire.com/",
      "field": "guide",
      "content": {
        "pros": [
          "Strong duelist with good sustained damage",
          "Healthy mix of damage and durability",
          "Can split-push and skirmish across the map"
        ],
        "cons": [
          "Vulnerable before key items come online",
          "Struggles into heavy ranged poke",
          "Can be peeled and kited by control"
        ],
        "gameplay_tips": "Nezha is a Fighter who plays the Clash Lane. Your aim is to trade in your lane, then bully your way onto the enemy backline. Pick your moment to use Universe Ring, then follow up with Fire-tipped Spear - Sweep and Red Armillary Sash - Bind. Manage the wave, respect ganks, and look to roam once you have a lead."
      }
    },
    {
      "source": "Kurohiko",
      "url": "https://hok.kurohiko.id/",
      "field": "tactical_tips",
      "content": "1) Hero tipis jaga jarak. 2) Jangan pakai control utama ke Nezha."
    },
