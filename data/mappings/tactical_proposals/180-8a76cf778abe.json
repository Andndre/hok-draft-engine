        "pick_when": [
          "The map shape favors gank routes, where mobility translates directly into kills",
          "Your team has the structure to use his ability to soak pressure in lane and threaten side objectives, since Nezha delivers a durable front-line presence with steady wave control.",
          "The enemy draft includes Mai Shiranui, Mozi, and Nuwa, who appear in counter data as matchups Nezha can pressure."
        ],
        "avoid_when": [
          "The team needs sustained team-fight damage rather than a single-target diver",
          "Your team needs a mid pick more than Nezha's specialty, leaving the role unfilled if you commit here.",
          "The enemy team is built around answers to Gap-Close, removing the windows Nezha's kit needs to perform."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Nezha's mid-game tools come online.",
          "Ultimate unlocked: Universe Ring converts mobility into burst, the moment Nezha starts threatening picks across the map",
          "Late game: full build online, Nezha reaches the spike public guides describe — extended fights favor him once items are completed."
        ],
        "common_mistakes": [
          "Engaging without follow-up — gap-close gets you to the target, but a solo dive without ally damage trades 1-for-1.",
          "Engaging without checking enemy summoner-spell cooldowns, which often decide whether Nezha's commit reaches the target alive.",
          "Forcing solo engages instead of waiting for ally commit — Nezha's value compounds when the team follows up on engages."
        ],
