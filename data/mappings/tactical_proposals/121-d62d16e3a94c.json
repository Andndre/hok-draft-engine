  "sources": [
    {
      "source": "HOKFIRE",
      "url": "https://www.hokfire.com/",
      "field": "abilities",
      "content": [
        {
          "type": "Passive",
          "name": "Eternal Youth",
          "desc": "Summons a shadow servant that damages enemies and restores Health to her whenever using a skill. She also gains Shadow Power that boosts her Movement Speed and healing effects."
        },
        {
          "type": "Skill 1",
          "name": "Dark Transfer",
          "desc": "Unleashes shadow energy, dealing damage to enemies that come into contact with it. Upon using the skill again, will shift to the shadow's location, dealing damage again. A shadow servant will be summoned if she hits an enemy after shifting."
        },
        {
          "type": "Skill 2",
          "name": "Ravenous Tether",
          "desc": "Releases a tether that links to the first enemy hit. Damages and slows over time. Steals Physical and Magical Attack while recovering Health."
        },
        {
          "type": "Ultimate",
          "name": "Umbral Moon",
          "desc": "Removes debuffs, gains Movement Speed, and becomes untargetable. Deals damage to nearby enemies upon entering and exiting the untargetable state."
        }
      ]
    },
