      "field": "tactical_tips",
      "content": "Pakai slow dan soft CC lain buat ngebatesin Yaria. Pas dia gak bisa berubah jadi rusa, dia gampang dibunuh."
    },
    {
      "source": "HoKStats",
      "url": "https://hokstats.gg/heroes/yaria/",
      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Deer Spirit",
            "description": "When inflicted with crowd control effects (excluding suppression), gains immunity to all effects.",
            "type": "passive"
          },
          {
            "name": "Wandering Beam",
            "description": "Releases a soul in the target direction, which tracks nearby enemies after reaching its max range. The soul launches and deals damage to enemies hit. In deer spirit form, using this skill will restore her to Human Form.",
            "type": "skill1"
          },
          {
            "name": "Accelerating Blitz",
            "description": "Deals continuous damage to nearby enemies. Attached: Increased range.",
            "type": "skill2"
          },
          {
            "name": "Verdant Protector",
            "description": "Attaches herself to a teammate, providing a true damage shield and enhancing her own skill effects. Attached: When the shield is exhausted, the attachment ends and the skill goes on cooldown. Actively detaching reduces the cooldown.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "Your team has a hyper-carry who needs her backline protection to reach scaling",
          "Your team has the structure to use her ability to protect the marksman, set vision, and engage on cooldown windows, since Yaria delivers utility, vision, and timely peel for the carries.",
          "The enemy draft includes Dian Wei, Dun, and Mayene, who appear in counter data as matchups Yaria can pressure."
        ],
        "avoid_when": [
          "Your team needs proactive engage rather than a reactive shield-and-peel kit",
          "Your team needs a damage pick more than Yaria's specialty, leaving the role unfilled if you commit here.",
          "The enemy team is built around answers to Team Buffs, removing the windows Yaria's kit needs to perform."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Yaria's mid-game tools come online.",
          "Defensive item online: shield strength scales with magic power or HP, so Yaria's value grows after the first item spike",
          "Late game: cooldowns become short enough that Accelerating Blitz influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Pre-shielding before the engage actually starts, wasting the absorb window before damage lands.",
          "Engaging without checking enemy summoner-spell cooldowns, which often decide whether Yaria's commit reaches the target alive.",
          "Forgetting vision while looking for picks — losing the marksman because the support roamed without setting wards is a recurring mistake."
        ],
