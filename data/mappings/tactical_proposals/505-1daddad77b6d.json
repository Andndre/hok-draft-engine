      "field": "abilities",
      "content": [
        {
          "type": "Passive",
          "name": "Deer Spirit",
          "desc": "When inflicted with crowd control effects (excluding suppression), gains immunity to all effects."
        },
        {
          "type": "Skill 1",
          "name": "Wandering Beam",
          "desc": "Releases a spirit in the target direction, which tracks nearby enemies after reaching its max range.The spirit launches and deals damage to enemies hit. In deer spirit form, using this skill will restore her to Human Form."
        },
        {
          "type": "Skill 2",
          "name": "Accelerating Blitz",
          "desc": "Deals continuous damage to nearby enemies. Attached: Increases casting range."
        },
        {
          "type": "Ultimate",
          "name": "Verdant Protector",
          "desc": "Attaches herself to a teammate, providing a true damage shield and enhancing your skill effects. Attached: When the shield is exhausted, the attachment will end and enter cooldown. Actively detaching reduces the cooldown of this skill."
        }
      ]
    },
