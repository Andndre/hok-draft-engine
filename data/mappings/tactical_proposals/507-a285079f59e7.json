        "pick_when": [
          "The map shape favors gank routes, where mobility translates directly into kills",
          "The enemy team has multiple high-mobility threats that need to be locked down before they reach your backline",
          "The enemy draft includes Da Qiao and Liang, who appear in counter data as matchups Li Xin can pressure."
        ],
        "avoid_when": [
          "Enemy peel is strong and Li Xin cannot reach the backline without dying first",
          "Your team lacks the follow-up damage to convert your control windows into kills",
          "The enemy already drafted Cai Yan, Da Qiao, and Guiguzi, who counter data identifies as direct answers to Li Xin."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Li Xin's mid-game tools come online.",
          "Mid game: with cooldown reduction online, gap-close skills come back fast enough to chain into multiple fights",
          "Late game: cooldowns become short enough that Chaos Wave influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Diving while enemy hard control is still up, which directly counters Li Xin's engage.",
          "Throwing Chaos Wave on the front-line tank instead of saving it for backline carries.",
          "Ignoring Cai Yan and Da Qiao on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Forcing solo engages instead of waiting for ally commit — Li Xin's value compounds when the team follows up on engages."
