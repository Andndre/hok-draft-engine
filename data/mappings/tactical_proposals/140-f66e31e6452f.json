    {
      "source": "HOKFIRE",
      "url": "https://www.hokfire.com/",
      "field": "abilities",
      "content": [
        {
          "type": "Passive",
          "name": "Rider of Triumph",
          "desc": "'''Normal Stance:''' Moving constantly accumulates a Movement Speed bonus, and reaching a certain distance activates the Charge Stance. '''Charge Stance:''' Enhances the next skill and Basic Attack."
        },
        {
          "type": "Skill 1",
          "name": "Heroic Charge",
          "desc": "'''Normal Stance:''' Deals damage to enemies within range. '''Charge Stance:''' Charges forward, knocking back enemies in his path while dealing damage."
        },
        {
          "type": "Skill 2",
          "name": "Soaring Green Dragon",
          "desc": "'''Normal Stance:''' Removes crowd control effects and gains Movement Speed. '''Charge Stance:''' Removes crowd control effects and leaps forward, knocking back enemies within the landing area and dealing damage."
        },
        {
          "type": "Ultimate",
          "name": "Razor Cavalry",
          "desc": "'''Normal Stance:''' Enhances himself, reducing the movement distance required to enter Charge stance. '''Charge Stance:''' Summons heavy cavalry that dash forward, dealing damage and knocking back enemies in their path."
        }
      ]
    },
