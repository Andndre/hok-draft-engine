          }
        ],
        "pick_when": [
          "The enemy team has carries with limited self-peel that Guan Yu can reach before the team can react",
          "Your team has the structure to use his ability to soak pressure in lane and threaten side objectives, since Guan Yu delivers a durable front-line presence with steady wave control.",
          "The enemy draft includes Daji, Mi Yue, and Yixing, who appear in counter data as matchups Guan Yu can pressure."
        ],
        "avoid_when": [
          "The enemy stacks crowd control that interrupts the engage before damage goes out",
          "Your team needs a mid pick more than Guan Yu's specialty, leaving the role unfilled if you commit here.",
          "A stronger pick in the same role is open and the matchup does not specifically reward Guan Yu's Gap-Close."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Guan Yu's mid-game tools come online.",
          "Ultimate unlocked: Razor Cavalry converts mobility into burst, the moment Guan Yu starts threatening picks across the map",
          "Late game: cooldowns become short enough that Soaring Green Dragon influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Engaging without follow-up — gap-close gets you to the target, but a solo dive without ally damage trades 1-for-1.",
          "Engaging without checking enemy summoner-spell cooldowns, which often decide whether Guan Yu's commit reaches the target alive.",
          "Forcing solo engages instead of waiting for ally commit — Guan Yu's value compounds when the team follows up on engages."
        ],
