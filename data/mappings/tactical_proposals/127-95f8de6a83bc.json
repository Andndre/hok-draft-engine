    {
      "source": "Kurohiko",
      "url": "https://hok.kurohiko.id/",
      "field": "tactical_tips",
      "content": "1) Control Lady Zhen bisa dihindarin pakai gerakan lincah. 2) Pas teamfight jangan kedeketan sama temen biar AoE-nya gak kena banyak orang."
    },
    {
      "source": "HoKStats",
      "url": "https://hokstats.gg/heroes/lady-zhen/",
      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Frozen Touch",
            "description": "Dealing damage to an enemy with skills 3 times within a short period of time will deal extra damage and freeze them.",
            "type": "passive"
          },
          {
            "name": "Ocean of Tears",
            "description": "Conjures icicles that block heroes, damaging and launching enemies within range. If Lady Zhen is near the icicles when conjured, she becomes frozen and invincible. The icicles shatter when the skill ends or is canceled, dealing damage (damage is doubled at the center).",
            "type": "skill1"
          },
          {
            "name": "Flowing Sigh",
            "description": "Unleashes a water orb that deals damage.",
            "type": "skill2"
          },
          {
            "name": "Destructive Deluge",
            "description": "Unleashes a water spirit that forms a pool. The pool deals damage to enemies within range and slows them.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "The enemy team has multiple high-mobility threats that need to be locked down before they reach your backline",
          "Your team has the structure to use her ability to farm safely and rotate to side lanes when the wave allows, since Lady Zhen delivers consistent damage output and timely roams.",
          "The enemy draft includes Cirrus, Nakoruru, and Sima Yi, who appear in counter data as matchups Lady Zhen can pressure."
        ],
        "avoid_when": [
          "Your team lacks the follow-up damage to convert your control windows into kills",
          "Your team needs a jungle pick more than Lady Zhen's specialty, leaving the role unfilled if you commit here.",
          "The enemy already drafted Charlotte, Liu Bei, and Luna, who counter data identifies as direct answers to Lady Zhen."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Lady Zhen's mid-game tools come online.",
          "Ultimate online: Destructive Deluge extends control duration, making team fights snowball off a single hit",
          "Late game: cooldowns become short enough that Flowing Sigh influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Throwing Flowing Sigh on the front-line tank instead of saving it for backline carries.",
          "Ignoring Charlotte and Liu Bei on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Greeding farm in mid lane while side lanes get camped — rotation timing matters more than CS lead in most matchups."
        ],
