  "sources": [
    {
      "source": "HOKFIRE",
      "url": "https://www.hokfire.com/",
      "field": "abilities",
      "content": [
        {
          "type": "Passive",
          "name": "Frozen Touch",
          "desc": "Places marks on enemies when hitting them with skills, for up to 3 stacks. Upon reaching max stacks, she freezes and damages the enemy."
        },
        {
          "type": "Skill 1",
          "name": "Ocean of Tears",
          "desc": "Damages and launches enemies within the target area"
        },
        {
          "type": "Skill 2",
          "name": "Flowing Sigh",
          "desc": "Fires a water orb at the target, which deals damage and bounces between nearby enemies."
        },
        {
          "type": "Ultimate",
          "name": "Destructive Deluge",
          "desc": "Fires a stream of water in the target direction. For a period of time after hitting an enemy hero or reaching its maximum range, the stream of water reforms into a pool, dealing damage and slowing enemies within it."
        }
      ]
    },
