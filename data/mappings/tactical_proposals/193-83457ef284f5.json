        "pick_when": [
          "The enemy team has high physical or magic burst that demands a dedicated tank to absorb",
          "Your team has the structure to use his ability to soak pressure in lane and threaten side objectives, since Kaizer delivers a durable front-line presence with steady wave control.",
          "The enemy draft includes Da Qiao, Diaochan, and Daji, who appear in counter data as matchups Kaizer can pressure."
        ],
        "avoid_when": [
          "Your team comp lacks damage and adding another non-damage pick collapses the win condition",
          "Your team needs a mid pick more than Kaizer's specialty, leaving the role unfilled if you commit here.",
          "The enemy already drafted Donghuang, Kui, and Sun Bin, who counter data identifies as direct answers to Kaizer."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Kaizer's mid-game tools come online.",
          "Core durability online: defensive items like Meteor let Kaizer stay in fights longer instead of getting blown up",
          "Late game: full build online, Kaizer reaches the spike public guides describe — extended fights favor him once items are completed."
        ],
        "common_mistakes": [
          "Building damage items hoping to deal kills, when the team needs the durability that makes you a tank in the first place.",
          "Ignoring Donghuang and Kui on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Forcing solo engages instead of waiting for ally commit — Kaizer's value compounds when the team follows up on engages."
        ],
