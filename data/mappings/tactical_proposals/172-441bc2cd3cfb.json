        "pick_when": [
          "The enemy team relies on long-cooldown engage skills that leave them vulnerable post-fight",
          "Your team has the structure to use her ability to soak pressure in lane and threaten side objectives, since Chicha delivers a durable front-line presence with steady wave control.",
          "The enemy composition leaves room for Chicha to reach the targets her kit punishes."
        ],
        "avoid_when": [
          "The enemy team disengages well, so cleanup windows never open",
          "Your team needs a mid pick more than Chicha's specialty, leaving the role unfilled if you commit here.",
          "The enemy team is built around answers to Maximum Attack Speed, removing the windows Chicha's kit needs to perform."
        ],
        "power_spikes": [
          "Early game: focus on safe lane phase and tracking jungle pressure before Chicha's mid-game tools come online.",
          "Ultimate online: Return of the Armsmaster provides the cleanup finisher once the enemy commits cooldowns",
          "Late game: cooldowns become short enough that World-Splitting Spear influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Engaging first instead of second — cleanup picks lose their value as primary engagers.",
          "Engaging without checking enemy summoner-spell cooldowns, which often decide whether Chicha's commit reaches the target alive.",
          "Forcing solo engages instead of waiting for ally commit — Chicha's value compounds when the team follows up on engages."
        ],
