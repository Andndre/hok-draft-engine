  "sources": [
    {
      "source": "HOKFIRE",
      "url": "https://www.hokfire.com/",
      "field": "abilities",
      "content": [
        {
          "type": "Passive",
          "name": "Child of the Sea",
          "desc": "Loss of life is temporarily stored in a gray shield form, during which 40%/15% of the equivalent gray shield of damage dealt to heroes/non-heroes is converted into blood, scaling up based on extra life. Basic attacks come with additional physical damage."
        },
        {
          "type": "Skill 1",
          "name": "Wavewalking",
          "desc": "Endeavor to jump up and deal physical damage to smashed enemies when you land. Afterwards, bounce up again, dealing the same damage as well as a 0.5 second knockback effect when you land. Immunity to control during the jump. When attacking multiple enemies at once, damage decays by 20% for each additional enemy, down to 60%. Increases damage to minions by an additional 30%."
        },
        {
          "type": "Skill 2",
          "name": "Sea Anchor",
          "desc": "Throw the anchor straight out to hit enemies in front of you, dealing physical damage and 60% slow for 1.5 seconds. If the anchor is embedded in a wall, Ata will use the force to dash himself and the enemy to that spot. When it hits the wall, it deals Physical damage and stuns for 0.5 seconds. [Passive]: after using [Anchor], the next basic attack within 3 seconds will pull the enemy back with the anchor."
        },
        {
          "type": "Ultimate",
          "name": "Ghost Ship",
          "desc": "Ata builds temporary terrain along the outer border of a fan-shaped targetarea, dealing damage to enemies within it.Gains crowd control immunity while using the skill.He can use the skill again to make the temporary terrain disappear early."
        }
      ]
    },
    {
      "source": "HOKFIRE",
      "url": "https://www.hokfire.com/",
      "field": "guide",
      "content": {
        "pros": [
          "Absorbs a lot of damage for the team",
          "Brings reliable crowd control to open fights",
          "Very hard to bring down once built"
        ],
        "cons": [
          "Deals limited personal damage",
          "Needs the team to follow up on engages",
          "Can be kited by mobile enemies"
        ],
        "gameplay_tips": "Ata is a Tank who plays the Clash Lane. Your aim is to soak damage, start fights and peel for your carries. Pick your moment to use Ghost Ship, then follow up with Wavewalking and Sea Anchor. Manage the wave, respect ganks, and look to roam once you have a lead."
      }
    },
    {
      "source": "Kurohiko",
      "url": "https://hok.kurohiko.id/",
      "field": "tactical_tips",
      "content": "Adaptasi Global dari Zhu Bajie di KPL. Memiliki pasif regenerasi grey-health tebal dan tembok kurungan penahan musuh."
    },
    {
      "source": "HoKStats",
      "url": "https://hokstats.gg/heroes/ata/",
      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Child of the Sea",
            "description": "His lost Health is preserved in a temporary Health buffer. Dealing damage converts buffered Health into actual Health. After a while, the buffered Health will begin to gradually diminish. His Basic Attacks deal extra damage.",
            "type": "passive"
          },
          {
            "name": "Wavewalking",
            "description": "Leaps into the air and slams down twice, dealing damage with each slam. The second slam launches enemies. Gains crowd control immunity while using the skill.",
            "type": "skill1"
          },
          {
            "name": "Sea Anchor",
            "description": "Hurls an anchor in the target direction, dealing damage and slowing enemies. If the anchor hits terrain, he will be dragged to the contact point, dealing damage and knocking back enemies. His next Basic Attack will be enhanced with a pulling effect.",
            "type": "skill2"
          },
          {
            "name": "Ghost Ship",
            "description": "Builds temporary terrain along the outer edge of a cone-shaped area, dealing damage to enemies within it. Gains crowd control immunity while using the skill. He can use the skill again to make the temporary terrain disappear early.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "Your team needs a Clash Lane tank who can control space, build walls, and isolate enemies during objective fights.",
          "Your allies can follow up when Ata uses Skill 1 into Ghost Ship and Skill 2 to split the enemy formation.",
          "The fight is likely to happen around walls, jungle entrances, or objective pits where Anchor and Ghost Ship are easier to use."
        ],
        "avoid_when": [
          "The enemy has mobile heroes who can dodge Ghost Ship or kite Ata, which public counter guides identify as a strong answer.",
          "The enemy composition can poke safely from range and buy armor-penetration items before Ata reaches them.",
          "Your team needs immediate long-range engage or burst damage rather than a tank who wins by controlling space over time."
        ],
        "power_spikes": [
          "Early lane: build references emphasize defensive starts such as Scale Blade or Resilient Agate before moving into tank items.",
          "Ultimate unlocked: Ghost Ship gives Ata the formation-splitting tool that public guides highlight for late-game fights.",
          "Core durability online: Blazing Cape, Eye of the Phoenix, and Overlord's Platemail are listed as core items that let him stay in fights longer."
        ],
        "common_mistakes": [
          "Fighting in open space when Ata gets more value from walls, corridors, and small areas.",
          "Using Ghost Ship without allied follow-up, turning a formation split into only a short delay.",
          "Ignoring ranged poke and armor penetration, both listed as counter approaches against Ata.",
          "Building too much damage when public item guidance points toward durability and tank utility."
        ],
