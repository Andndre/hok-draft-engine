      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Soul Sacrifice",
            "description": "Every time a dark orb passes through an enemy, it deals damage and restores Health to him.",
            "type": "passive"
          },
          {
            "name": "Eclipse",
            "description": "Deals damage to enemies within range and summons a dark orb. There can be 3 dark orbs at a time. Hitting enemies with this skill reduces its cooldown, and with 3 dark orbs, it restores Health.",
            "type": "skill1"
          },
          {
            "name": "Dark Impact",
            "description": "Unleashes up to 3 dark orbs at the target location, increasing his Movement Speed and dealing damage to enemies in range. The 1st and 2nd dark orbs slow enemies. The 3rd dark orb stuns enemies.",
            "type": "skill2"
          },
          {
            "name": "Forsaken Contract",
            "description": "Suppresses an enemy hero and summons 3 dark orbs. If he or the target takes damage during suppression, the other will take the same amount of damage.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "The team draft favors extended team fights where healing scales",
          "The enemy team relies on hard engage that you can read and recover from",
          "The enemy draft includes Allain, Cirrus, and Kaizer, who appear in counter data as matchups Donghuang can pressure."
        ],
        "avoid_when": [
          "The enemy already builds anti-heal items, neutralizing your sustain plan",
          "The enemy chains crowd control faster than recovery cooldowns refresh",
          "The enemy team is built around answers to Recovery, removing the windows Donghuang's kit needs to perform."
        ],
        "power_spikes": [
          "Early game: Donghuang is listed as an early-game threat in public guide data — convert the early window into objectives before scaling picks come online.",
          "Lifesteal item online: trade patterns flip from neutral to favorable once sustain stacks with damage",
          "Late game: Overlord's Platemail, Breakthrough Robe, and Savant's Wrath on the bar means Donghuang can soak commits in 5v5 team fights for his carries."
        ],
        "common_mistakes": [
          "Forcing all-ins against opponents already wearing anti-heal — your healing barely activates.",
          "Using the recovery skill on the first crowd control, then dying to the follow-up chain.",
          "Engaging without checking enemy summoner-spell cooldowns, which often decide whether Donghuang's commit reaches the target alive.",
          "Forgetting vision while looking for picks — losing the marksman because the support roamed without setting wards is a recurring mistake."
        ],
