      "field": "abilities",
      "content": [
        {
          "skill_id": 55000,
          "type": "Passive",
          "name": "Empty Hand (Kongkong Ru Ye)",
          "desc": "Moving continuously accumulates energy. When fully charged, releasing movement triggers a short blink forward and enhances the next basic attack into 'Phantom Hand' (诡手), dealing physical damage and slowing the target. Hitting an enemy hero steals a random item from them for 7 seconds, granting its attributes to Kongkong'er or sharing it with nearby allies while the target loses those stats. Hitting a target with no stealable items returns the stolen gear and deals burst physical damage. Hitting non-hero units grants 1 bonus gold.",
          "cd": "0",
          "cost": "0",
          "tags": [
            "Mobility",
            "Blink",
            "Slow",
            "Buff",
            "Debuff"
          ],
          "icon": "https://game.gtimg.cn/images/yxzj/img201606/heroimg/550/55000.png"
        },
        {
          "skill_id": 55001,
          "type": "Skill 1",
          "name": "Deceiving Heaven (Man Tian)",
          "desc": "Casts an illusion clone forward that lasts 5 seconds, dealing physical damage along its path and at the destination while granting health recovery / shield to Kongkong'er and the clone. Recasting swaps positions with the clone instantly and deals damage to surrounding enemies. The clone mimics Kongkong'er's actions and absorbs damage (taking double damage).",
          "cd": "8",
          "cost": "50",
          "tags": [
            "Clone",
            "Teleport",
            "Shield",
            "Damage"
          ],
          "icon": "https://game.gtimg.cn/images/yxzj/img201606/heroimg/550/55000.png"
        },
        {
          "skill_id": 55002,
          "type": "Skill 2",
          "name": "Crossing the Sea (Guo Hai)",
          "desc": "Leaves an illusion clone at the current location for 5 seconds while Kongkong'er dashes forward, dealing physical damage to enemies along the path and gaining health recovery / shield. Recasting swaps positions with the clone. Allows continuous mind games by alternating swaps between Skill 1 and Skill 2 clones.",
          "cd": "8",
          "cost": "50",
          "tags": [
            "Dash",
            "Clone",
            "Mobility",
            "Shield"
          ],
          "icon": "https://game.gtimg.cn/images/yxzj/img201606/heroimg/550/55020.png"
        },
        {
          "skill_id": 55003,
          "type": "Ultimate",
          "name": "Three Caves of Immortals (San Dong Cang Xian)",
          "desc": "Spins ancient puppets rapidly, dealing high physical damage, knockback, and continuous pull/traction toward the center. Automatically triggers Skill 1 and Skill 2 to form a triangle of clones that spin together, drastically accelerating passive energy gain and allowing position swaps with any active clone. Enemies trapped in overlapping clone areas take devastating multi-layered damage and crowd control.",
          "cd": "40",
          "cost": "100",
          "tags": [
            "Crowd Control",
            "Knockback",
            "Pull",
            "Area Damage"
          ],
          "icon": "https://game.gtimg.cn/images/yxzj/img201606/heroimg/550/55030.png"
        }
      ]
    },
