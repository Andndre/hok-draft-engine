      "field": "guide",
      "content": {
        "skills": [
          {
            "name": "Killing Spear",
            "description": "Every 4th Basic Attack launches the target. Hits from skills and enhanced Basic Attacks grant increased Attack Speed.",
            "type": "passive"
          },
          {
            "name": "Ruthless Assault",
            "description": "Leaps to the target location to deal damage and launch the enemy. The second charge will not launch the enemy.",
            "type": "skill1"
          },
          {
            "name": "Fight or Die!",
            "description": "Dashes backward and enhances the next Basic Attack to deal extra damage. If the Fight or Die! sweep is his 4th Basic Attack, it will include the 4th Basic Attack's extra effects.",
            "type": "skill2"
          },
          {
            "name": "The Unrivaled Spear",
            "description": "Swings spear 4 times, gaining damage reduction and crowd control immunity. Deals damage each time and launches enemies the 4th time.",
            "type": "ultimate"
          }
        ],
        "pick_when": [
          "The map shape favors gank routes, where mobility translates directly into kills",
          "Your team has the structure to use his ability to clear camps efficiently and convert pressure into ganks, since Han Xin delivers tempo from objectives and cross-map kill threats.",
          "The enemy draft includes Lu Bu, Dun, and Xiang Yu, who appear in counter data as matchups Han Xin can pressure."
        ],
        "avoid_when": [
          "Enemy peel is strong and Han Xin cannot reach the backline without dying first",
          "Your team needs a tank pick more than Han Xin's specialty, leaving the role unfilled if you commit here.",
          "The enemy already drafted Agudo, Alessio, and Erin, who counter data identifies as direct answers to Han Xin."
        ],
        "power_spikes": [
          "Early game: jungle clear into level-4 ganks is the first window where Han Xin can translate routes into kills.",
          "Mid game: with cooldown reduction online, gap-close skills come back fast enough to chain into multiple fights",
          "Late game: cooldowns become short enough that Fight or Die! influences every team fight rather than being a one-shot tool."
        ],
        "common_mistakes": [
          "Diving while enemy hard control is still up, which directly counters Han Xin's engage.",
          "Ignoring Agudo and Alessio on the enemy team when picking fights — counter data flags them as direct answers, so engage timing must respect their cooldowns.",
          "Pathing predictably and getting tracked by the enemy jungler — vary first clear and rotate based on ward placement rather than muscle memory."
        ],
